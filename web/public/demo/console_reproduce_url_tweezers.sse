data: {"type": "candidate", "index": 1, "stage": "repair", "round": 1, "design": {"name": "polarization_splitting_optical_tweezers", "description": "Mach-Zehnder polarization-splitting optical tweezers (Figure 5, arXiv:2004.05246). A trapping laser is split by a half-wave plate and PBS1 into two orthogonally polarized arms steered by galvo mirrors GM1 and GM2, recombined at PBS2, relayed through a 4f telescope (L1, L2), and reflected by dichroic DM into the microscope objective O to trap at the sample stage. Above the condenser C, a filter dichroic DM_ILL diverts the transmitted 532 nm trapping light into a beam dump while allowing the 625 nm brightfield illumination source LS to pass through condenser C, the sample, objective O, dichroic DM, mirror M, and tube lens TL onto the camera CAM.", "modules": [], "baseplate": {"width_mm": 380.0, "height_mm": 490.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "LASER", "label": "Input trapping laser (532 nm, 1064 nm in paper modeled at 532 nm for vis optics or 532 nm tweezers Ready, kept at 532 nm) -> Input trapping laser (532 nm) ", "group": null, "part_number": "Coherent Verdi G", "position": [32.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 532.0, "power_mw": 100.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "LS", "label": "Illumination light source", "group": null, "part_number": "Thorlabs M625L4", "position": [322.0, 455.0], "direction_deg": -90.0, "wavelength_nm": 625.0, "power_mw": 10.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP", "type": "half_wave_plate", "label": "lambda/2", "group": null, "part_number": "WPH05M-532", "beam": "LASER", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 22.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "