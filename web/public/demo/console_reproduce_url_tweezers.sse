data: {"type": "iteration", "agent_id": "synth-1", "seq": 2, "label": "synthesized design 1", "design": {"name": "polarization_splitting_optical_tweezers", "description": "Mach-Zehnder polarization-splitting optical tweezers (Figure 5, arXiv:2004.05246). A trapping laser is split by a half-wave plate and PBS1 into two orthogonally polarized arms steered by galvo mirrors GM1 and GM2, recombined at PBS2, relayed through a 4f telescope (L1, L2), and reflected by dichroic DM into the microscope objective O to trap at the sample stage. A brightfield illumination source LS passes through condenser C, the sample, objective O, dichroic DM, mirror M, and tube lens TL onto the camera CAM.", "modules": [], "baseplate": {"width_mm": 380.0, "height_mm": 450.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "LASER", "label": "Input trapping laser (532 nm)", "group": null, "part_number": "Coherent Verdi G", "position": [32.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 532.0, "power_mw": 100.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "LS", "label": "Illumination light source", "group": null, "part_number": "Thorlabs M625L4", "position": [322.0, 420.0], "direction_deg": -90.0, "wavelength_nm": 625.0, "power_mw": 10.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP", "type": "half_wave_plate", "label": "lambda/2", "group": null, "part_number": "WPH05M-532", "beam": "LASER", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 22.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS1", "group": null, "part_number": "PBS251", "beam": "LASER", "distance_mm": 57.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "GM1", "type": "mirror", "label": "GM1 (galvo 1)", "group": null, "part_number": "GVS001", "beam": "LASER.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "GM2", "type": "mirror", "label": "GM2 (galvo 2)", "group": null, "part_number": "GVS001", "beam": "LASER.r", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS2", "type": "pbs", "label": "PBS2", "group": null, "part_number": "PBS251", "beam": "LASER.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L1", "type": "lens", "label": "L1 (relay lens 1)", "group": null, "part_number": "LA1131-A", "beam": "LASER.t.t", "distance_mm": 66.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L2", "type": "lens", "label": "L2 (relay lens 2)", "group": null, "part_number": "LA1131-A", "beam": "LASER.t.t", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "DM", "type": "dichroic", "label": "DM (dichroic mirror)", "group": null, "part_number": "DMLP567", "beam": "LASER.t.t", "distance_mm": 56.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": 580.0, "reflect": "below", "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "O", "type": "lens", "label": "O (objective)", "group": null, "part_number": "Nikon CFI Plan Apo 100X", "beam": "LASER.t.t.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 45.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "SAMPLE", "type": "vapor_cell", "label": "3D sample stage (sample chamber)", "group": null, "part_number": "Sample Chamber", "beam": "LASER.t.t.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 12.7, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.9, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "C", "type": "lens", "label": "C (condenser)", "group": null, "part_number": "ACL25416U", "beam": "LASER.t.t.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 45.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_TRAP", "type": "beam_dump", "label": "Trapping beam dump (above condenser)", "group": null, "part_number": "LB1", "beam": "LASER.t.t.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 12.7, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M", "type": "mirror", "label": "M (imaging fold mirror)", "group": null, "part_number": "BB1-E02", "beam": "LS.t", "distance_mm": 64.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "TL", "type": "lens", "label": "Tube lens", "group": null, "part_number": "AC254-200-A", "beam": "LS.t", "distance_mm": 58.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 200.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "CAM", "type": "photodiode", "label": "Camera", "group": null, "part_number": "Thorlabs CS165MU", "beam": "LS.t", "distance_mm": 76.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "CAM", "kind": "min_power_mw", "value": 4.0}], "notes": "Mach-Zehnder polarization-splitting dual-beam optical tweezers. HWP at 22.5 deg rotates the H-polarized 532 nm trapping beam to 45 deg (D) so PBS1 transmits 50% (H) to GM1 and reflects 50% (V) to GM2. GM1 (at [32,200]) reflects H along +x into PBS2 (at [100,200]), which transmits H along +x. GM2 (at [100,132]) reflects V along +y into PBS2 from below; since PBS2 has angle_deg=0, the V-polarized beam entering at 90 deg reflects off the cube diagonal into +x (branch LASER.r.r), recombining coaxially with LASER.t.t. L1 and L2 form a 1:1 4f relay (f=50 mm, separated by 100 mm). Dichroic DM (cutoff 580 nm, reflect below) reflects both 532 nm trapping beams up through objective O (f=45 mm), the sample stage (at [322,300]), and condenser C (f=45 mm) into beam dump BD_TRAP. Illumination source LS (625 nm, at [322,420]) propagates down (-90 deg) through condenser C, sample stage, and objective O (acting as a 1:1 relay), transmits through DM (>580 nm), reflects off mirror M (at [322,136]) toward -x, and passes through tube lens TL onto the camera detector CAM.", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "LASER", "source_id": "LASER", "start": [32.0, 30.0], "end": [32.0, 75.0], "direction_deg": 90.0, "length_mm": 45.0, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 100.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8000567065464069, "start_element": "LASER", "end_element": "HWP", "end_reason": "element"}, {"id": "s1", "branch": "LASER", "source_id": "LASER", "start": [32.0, 75.0], "end": [32.0, 132.0], "direction_deg": 90.0, "length_mm": 56.99999999999999, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 100.0, "jones": [[0.7071067811865475, 0.0], [0.7071067811865476, -6.123233995736767e-17]], "polarization_label": "D", "waist_z_mm": -45.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8000567065464069, "w_end_mm": 0.8002913029238657, "start_element": "HWP", "end_element": "PBS1", "end_reason": "element"}, {"id": "s2", "branch": "LASER.t", "source_id": "LASER", "start": [32.0, 132.0], "end": [32.00000000000001, 200.0], "direction_deg": 90.0, "length_mm": 67.99999999999999, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 49.999999999999986, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -102.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8002913029238657, "w_end_mm": 0.8008089131475793, "start_element": "PBS1", "end_element": "GM1", "end_reason": "element"}, {"id": "s3", "branch": "LASER.t", "source_id": "LASER", "start": [32.00000000000001, 200.0], "end": [100.00000000000003, 199.99999999999997], "direction_deg": -1.2722218725854067e-14, "length_mm": 68.00000000000003, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 49.999999999999986, "jones": [[1.0, -1.2246467991473532e-16], [-0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -170.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8008089131475793, "w_end_mm": 0.8015847017864987, "start_element": "GM1", "end_element": "PBS2", "end_reason": "element"}, {"id": "s4", "branch": "LASER.t.t", "source_id": "LASER", "start": [100.00000000000003, 199.99999999999997], "end": [166.0, 199.99999999999994], "direction_deg": -1.2722218725854067e-14, "length_mm": 65.99999999999997, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 49.999999999999986, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -238.00000000000003, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8015847017864987, "w_end_mm": 0.8025838657563924, "start_element": "PBS2", "end_element": "L1", "end_reason": "element"}, {"id": "s5", "branch": "LASER.t.t", "source_id": "LASER", "start": [166.0, 199.99999999999994], "end": [266.0, 199.99999999999991], "direction_deg": -1.2722218725854067e-14, "length_mm": 100.0, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 49.9999999999999