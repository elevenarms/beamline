r_out_mw": null, "error": null}, {"id": "C", "type": "lens", "placed": true, "position": [322.0, 354.9999999999999], "angle_deg": 90.0, "hits": [{"segment_id": "s9", "power_in_mw": 44.999999999999986, "w_mm": 0.8012934496806802, "clip_loss": 0.0, "offset_mm": 0.0}, {"segment_id": "s19", "power_in_mw": 45.000000000000014, "w_mm": 0.8012934496806802, "clip_loss": 0.0, "offset_mm": 0.0}, {"segment_id": "s23", "power_in_mw": 10.0, "w_mm": 0.8003864163187081, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "DM_ILL", "type": "dichroic", "placed": true, "position": [322.0, 409.9999999999999], "angle_deg": 90.0, "hits": [{"segment_id": "s10", "power_in_mw": 44.999999999999986, "w_mm": 0.8020389098016389, "clip_loss": 0.0, "offset_mm": 0.0}, {"segment_id": "s20", "power_in_mw": 45.000000000000014, "w_mm": 0.8020389098016389, "clip_loss": 0.0, "offset_mm": 0.0}, {"segment_id": "s22", "power_in_mw": 10.0, "w_mm": 0.8000782643742234, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "BD_TRAP", "type": "beam_dump", "placed": true, "position": [272.0, 409.9999999999999], "angle_deg": 180.0, "hits": [{"segment_id": "s11", "power_in_mw": 44.999999999999986, "w_mm": 0.802862511435595, "clip_loss": 0.0, "offset_mm": 0.0}, {"segment_id": "s21", "power_in_mw": 45.000000000000014, "w_mm": 0.802862511435595, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": 90.0, "error": null}, {"id": "M", "type": "mirror", "placed": true, "position": [322.0, 131.99999999999991], "angle_deg": 135.0, "hits": [{"segment_id": "s27", "power_in_mw": 9.0, "w_mm": 0.8005845368855634, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "TL", "type": "lens", "placed": true, "position": [264.0, 131.99999999999991], "angle_deg": 180.0, "hits": [{"segment_id": "s28", "power_in_mw": 9.0, "w_mm": 0.8012652437127474, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "CAM", "type": "photodiode", "placed": true, "position": [188.0, 131.99999999999994], "angle_deg": 180.0, "hits": [{"segment_id": "s29", "power_in_mw": 9.0, "w_mm": 0.4982036190279228, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": 9.0, "error": null}], "branches": ["LASER", "LASER.t", "LASER.t.t", "LASER.t.t.r", "LASER.t.t.r.r", "LASER.r", "LASER.r.r", "LASER.r.r.r", "LASER.r.r.r.r", "LS", "LS.t", "LS.t.t"], "nonconverged": []}, "report": {"passed": true, "score": 95.4090909090909, "checks": [{"id": "target", "severity": "info", "message": "met: CAM: 9.000 mW (need \u2265 4.000)", "element_id": "CAM", "segment_id": null, "value": 9.0, "limit": 4.0}], "metrics": {"input_mw": 110.0, "delivered_mw": 9.0, "dumped_mw": 90.0, "stray_mw": 0.0, "n_elements": 16.0, "n_segments": 30.0, "target.CAM.min_power_mw": 9.0, "delivered_fraction": 0.08181818181818182}}, "parent_seq": 2, "diff": [{"op": "param", "element_id": "O", "field": "focal_length_mm", "from": 45.0, "to": 50.0, "note": "focal_length_mm: 45 \u2192 50 \u2014 Increased focal length to 50 mm so O-SAMPLE distance can be 50 mm (avoiding collision with the 75 mm vapor_cell footprint of SAMPLE)."}, {"op": "move", "element_id": "SAMPLE", "field": "distance_mm", "from": 45.0, "to": 50.0, "note": "distance_mm: 45 \u2192 50 \u2014 Increased distance_mm from O to 50 mm to clear O's mount footprint."}, {"op": "move", "element_id": "C", "field": "distance_mm", "from": 45.0, "to": 50.0, "note": "distance_mm: 45 \u2192 50 \u2014 Increased distance_mm from SAMPLE to 50 mm and focal length to 50 mm to clear SAMPLE's mount footprint."}, {"op": "param", "element_id": "C", "field": "focal_length_mm", "from": 45.0, "to": 50.0, "note": "focal_length_mm: 45 \u2192 50 \u2014 Increased distance_mm from SAMPLE to 50 mm and focal length to 50 mm to clear SAMPLE's mount footprint."}, {"op": "add", "element_id": "DM_ILL", "field": null, "from": null, "to": null, "note": "added dichroic on LASER.t.t.r at 55 mm \u2014 Replaced coaxial BD_TRAP with a shortpass/longpass dichroic above C so the upward 532 nm trapping beams are reflected to BD_TRAP while the downward 625 nm illumination from LS transmits through C, SAMPLE, O, and DM onto branch LS.t.t."}, {"op": "retarget", "element_id": "BD_TRAP", "field": "beam", "from": "LASER.t.t.r", "to": "LASER.t.t.r.r", "note": "beam: LASER.t.t.r \u2192 LASER.t.t.r.r \u2014 Moved off the illumination axis onto branch LASER.t.t.r.r to catch the 532 nm trapping beams reflected by DM_ILL without blocking LS."}, {"op": "move", "element_id": "BD_TRAP", "field": "distance_mm", "from": 45.0, "to": 50.0, "note": "distance_mm: 45 \u2192 50 \u2014 Moved off the illumination axis onto branch LASER.t.t.r.r to catch the 532 nm trapping beams reflected by DM_ILL without blocking LS."}, {"op": "retarget", "element_id": "M", "field": "beam", "from": "LS.t", "to": "LS.t.t", "note": "beam: LS.t \u2192 LS.t.t \u2014 Updated branch to LS.t.t (after transmitting through DM_ILL and DM) and distance_mm to 68 mm so it sits at (322, 132)."}, {"op": "move", "element_id": "M", "field": "distance_mm", "from": 64.0, "to": 68.0, "note": "distance_mm: 64 \u2192 68 \u2014 Updated branch to LS.t.t (after transmitting through DM_ILL and DM) and distance_mm to 68 mm so it sits at (322, 132)."}, {"op": "retarget", "element_id": "TL", "field": "beam", "from": "LS.t", "to": "LS.t.t", "note": "beam: LS.t \u2192 LS.t.t \u2014 Updated branch to LS.t.t."}, {"op": "retarget", "element_id": "CAM", "field": "beam", "from": "LS.t", "to": "LS.t.t", "note": "beam: LS.t \u2192 LS.t.t \u2014 Updated branch to LS.t.t."}], "rationale": "Replaced the solid beam dump BD_TRAP between LS and C with a dichroic filter DM_ILL that reflects the 532 nm trapping beam into a side beam dump while transmitting the 625 nm illumination from LS down through C, SAMPLE, O, DM, M, and TL to CAM, and increased the O-SAMPLE-C spacing to 50 mm on an enlarged 490 mm tall baseplate to eliminate footprint collisions."}

