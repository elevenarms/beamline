data: {"type": "iteration", "agent_id": "repair-1", "seq": 3, "label": "repair 1", "design": {"name": "polarization_splitting_optical_tweezers", "description": "Mach-Zehnder polarization-splitting optical tweezers (Figure 5, arXiv:2004.05246). A trapping laser is split by a half-wave plate and PBS1 into two orthogonally polarized arms steered by galvo mirrors GM1 and GM2, recombined at PBS2, relayed through a 4f telescope (L1, L2), and reflected by dichroic DM into the microscope objective O to trap at the sample stage. Above the condenser C, a filter dichroic DM_ILL diverts the transmitted 532 nm trapping light into a beam dump while allowing the 625 nm brightfield illumination source LS to pass through condenser C, the sample, objective O, dichroic DM, mirror M, and tube lens TL onto the camera CAM.", "modules": [], "baseplate": {"width_mm": 380.0, "height_mm": 490.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "LASER", "label": "Input trapping laser (532 nm, 1064 nm in paper modeled at 532 nm for vis optics or 532 nm tweezers Ready, kept at 532 nm) -> Input trapping laser (532 nm) ", "group": null, "part_number": "Coherent Verdi G", "position": [32.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 532.0, "power_mw": 100.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "LS", "label": "Illumination light source", "group": null, "part_number": "Thorlabs M625L4", "position": [322.0, 455.0], "direction_deg": -90.0, "wavelength_nm": 625.0, "power_mw": 10.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP", "type": "half_wave_plate", "label": "lambda/2", "group": null, "part_number": "WPH05M-532", "beam": "LASER", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 22.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS1", "group": null, "part_number": "PBS251", "beam": "LASER", "distance_mm": 57.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "GM1", "type": "mirror", "label": "GM1 (galvo 132->200) ", "group": null, "part_number": "GVS001", "beam": "LASER.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "GM2", "type": "mirror", "label": "GM2 (galvo 2) ", "group": null, "part_number": "GVS001", "beam": "LASER.r", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS2", "type": "pbs", "label": "PBS2", "group": null, "part_number": "PBS251", "beam": "LASER.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L1", "type": "lens", "label": "L1 (relay lens 1) ", "group": null, "part_number": "LA1131-A", "beam": "LASER.t.t", "distance_mm": 66.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L2", "type": "lens", "label": "L2 (relay lens 2) ", "group": null, "part_number": "LA1131-A", "beam": "LASER.t.t", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "DM", "type": "dichroic", "label": "DM (dichroic mirror) ", "group": null, "part_number": "DMLP567", "beam": "LASER.t.t", "distance_mm": 56.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": 580.0, "reflect": "below", "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "O", "type": "lens", "label": "O (objective) ", "group": null, "part_number": "Nikon CFI Plan Apo 100X", "beam": "LASER.t.t.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "SAMPLE", "type": "vapor_cell", "label": "3D sample stage", "group": null, "part_number": "Sample Chamber", "beam": "LASER.t.t.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 12.7, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.9, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "C", "type": "lens", "label": "C (condenser) ", "group": null, "part_number": "ACL25416U", "beam": "LASER.t.t.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "DM_ILL", "type": "dichroic", "label": "Laser rejection dichroic", "group": null, "part_number": "DMLP567", "beam": "LASER.t.t.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": 580.0, "reflect": "below", "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_TRAP", "type": "beam_dump", "label": "Trapping beam dump", "group": null, "part_number": "LB1", "beam": "LASER.t.t.r.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 12.7, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M", "type": "mirror", "label": "M (imaging fold mirror) ", "group": null, "part_number": "BB1-E02", "beam": "LS.t.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "TL", "type": "lens", "label": "Tube lens", "group": null, "part_number": "AC254-200-A", "beam": "LS.t.t", "distance_mm": 58.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 200.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "CAM", "type": "photodiode", "label": "Camera", "group": null, "part_number": "Thorlabs CS165MU", "beam": "LS.t.t", "distance_mm": 76.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "CAM", "kind": "min_power_mw", "value": 4.0}], "notes": "Mach-Zehnder polarization-splitting dual-beam optical tweezers. O-SAMPLE and SAMPLE-C spacings are set to 50 mm (with f=50 mm on O and C) so the 75 mm sample chamber does not collide with O or C. Above C, dichroic DM_ILL reflects the 532 nm trapping beams to BD_TRAP while transmitting the 625 nm illumination from LS downward through C, SAMPLE, O, DM, M, and TL to CAM.", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "LASER", "source_id": "LASER", "start": [32.0, 30.0], "end": [32.0, 75.0], "direction_deg": 90.0, "length_mm": 45.0, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 100.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8000567065464069, "start_element": "LASER", "end_element": "HWP", "end_reason": "element"}, {"id": "s1", "branch": "LASER", "source_id": "LASER", "start": [32.0, 75.0], "end": [32.0, 132.0], "direction_deg": 90.0, "length_mm": 56.99999999999999, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 100.0, "jones": [[0.7071067811865475, 0.0], [0.7071067811865476, -6.123233995736767e-17]], "polarization_label": "D", "waist_z_mm": -45.0, "rayleigh_mm": 3779.359