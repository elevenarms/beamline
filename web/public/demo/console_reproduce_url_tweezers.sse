l, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "O", "type": "lens", "label": "O (objective) ", "group": null, "part_number": "Nikon CFI Plan Apo 100X", "beam": "LASER.t.t.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "SAMPLE", "type": "vapor_cell", "label": "3D sample stage", "group": null, "part_number": "Sample Chamber", "beam": "LASER.t.t.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 12.7, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.9, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "C", "type": "lens", "label": "C (condenser) ", "group": null, "part_number": "ACL25416U", "beam": "LASER.t.t.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "DM_ILL", "type": "dichroic", "label": "Laser rejection dichroic", "group": null, "part_number": "DMLP567", "beam": "LASER.t.t.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": 580.0, "reflect": "below", "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_TRAP", "type": "beam_dump", "label": "Trapping beam dump", "group": null, "part_number": "LB1", "beam": "LASER.t.t.r.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 12.7, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M", "type": "mirror", "label": "M (imaging fold mirror) ", "group": null, "part_number": "BB1-E02", "beam": "LS.t.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "TL", "type": "lens", "label": "Tube lens", "group": null, "part_number": "AC254-200-A", "beam": "LS.t.t", "distance_mm": 58.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 200.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "CAM", "type": "photodiode", "label": "Camera", "group": null, "part_number": "Thorlabs CS165MU", "beam": "LS.t.t", "distance_mm": 76.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "CAM", "kind": "min_power_mw", "value": 4.0}], "notes": "Mach-Zehnder polarization-splitting dual-beam optical tweezers. O-SAMPLE and SAMPLE-C spacings are set to 50 mm (with f=50 mm on O and C) so the 75 mm sample chamber does not collide with O or C. Above C, dichroic DM_ILL reflects the 532 nm trapping beams to BD_TRAP while transmitting the 625 nm illumination from LS downward through C, SAMPLE, O, DM, M, and TL to CAM.", "logic": null}, "report": {"passed": true, "score": 95.4090909090909, "checks": [{"id": "target", "severity": "info", "message": "met: CAM: 9.000 mW (need \u2265 4.000)", "element_id": "CAM", "segment_id": null, "value": 9.0, "limit": 4.0}], "metrics": {"input_mw": 110.0, "delivered_mw": 9.0, "dumped_mw": 90.0, "stray_mw": 0.0, "n_elements": 16.0, "n_segments": 30.0, "target.CAM.min_power_mw": 9.0, "delivered_fraction": 0.08181818181818182}}, "trace": {"segments": [{"id": "s0", "branch": "LASER", "source_id": "LASER", "start": [32.0, 30.0], "end": [32.0, 75.0], "direction_deg": 90.0, "length_mm": 45.0, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 100.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8000567065464069, "start_element": "LASER", "end_element": "HWP", "end_reason": "element"}, {"i