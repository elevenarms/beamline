.+1.+1.r.t", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC1", "type": "fiber_coupler", "label": "Output FiberPort (+160 MHz", "group": "aom_dp", "part_number": "PAF2-A4B", "beam": "L1.t.+1.+1.r.t", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 4.6, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.3, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_auto1", "type": "beam_dump", "label": "auto dump (3.98 mW)", "group": "source_split", "part_number": null, "beam": "L1.t.0.+1.r.t", "distance_mm": 303.7, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "FC1", "kind": "min_power_mw", "value": 12.0}, {"element_id": "FC1", "kind": "min_coupling", "value": 0.75}, {"element_id": "FC1", "kind": "polarization", "value": "V"}, {"element_id": "PD_MON", "kind": "min_power_mw", "value": 0.5}, {"element_id": "PD_SAS", "kind": "min_power_mw", "value": 0.1}], "notes": "Generous spacing on a 600x350 mm baseplate. HWP1 at 9.2 deg reflects ~10% of the isolated 35 mW beam up into the Rb SAS module and transmits ~90% into the f=100 mm cat-eye AOM double-pass (+160 MHz total shift). Double-passed QWP rotates H to V so PBS1 reflects the return beam downward (-y). M_OUT1 and M_OUT2 walk the beam into fiber coupler FC1 after a 5% sampler S_MON sends ~0.95 mW to PD_MON.", "logic": null}, "report": {"passed": true, "score": 92.7324562922998, "checks": [{"id": "beam_through_mount", "severity": "warning", "message": "beam L1.t.0.+1.r.t passes through M_OUT2's mount without interacting", "element_id": "M_OUT2", "segment_id": "s19", "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "BD_AOM0 receives no light", "element_id": "BD_AOM0", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "info", "message": "met: FC1: 17.714 mW (need \u2265 12.000)", "element_id": "FC1", "segment_id": null, "value": 17.714473439654142, "limit": 12.0}, {"id": "target", "severity": "info", "message": "met: FC1: coupling 93.3% (need \u2265 75.0%)", "element_id": "FC1", "segment_id": null, "value": 0.9328820108078951, "limit": 0.75}, {"id": "target", "severity": "info", "message": "met: FC1: polarization V (need V, overlap 100.0%)", "element_id": "FC1", "segment_id": null, "value": 1.0, "limit": null}, {"id": "target", "severity": "info", "message": "met: PD_MON: 1.209 mW (need \u2265 0.500)", "element_id": "PD_MON", "segment_id": null, "value": 1.2087193474532494, "limit": 0.5}, {"id": "target", "severity": "info", "message": "met: PD_SAS: 0.204 mW (need \u2265 0.100)", "element_id": "PD_SAS", "segment_id": null, "value": 0.20400125899123414, "limit": 0.1}], "metrics": {"input_mw": 35.0, "delivered_mw": 19.127194046098627, "dumped_mw": 9.998695576907696, "stray_mw": 0.0, "n_elements": 24.0, "n_segments": 47.0, "target.FC1.min_power_mw": 17.714473439654142, "target.FC1.min_coupling": 0.9328820108078951, "target.FC1.polarization": 1.0, "target.PD_MON.