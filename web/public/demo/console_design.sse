data: {"type": "iteration", "agent_id": "designer-2", "seq": 7, "label": "candidate 2", "design": {"name": "rb780_sas_aom_dp_ushape", "description": "780 nm Rb D2 laser layout in a U-shaped fold (input and fiber output on the left side). The laser passes an optical isolator and a lambda/2 + PBS that picks off ~10% of the power upward into a Doppler-free Rb saturated-absorption spectroscopy loop (sampler split into counter-propagating V pump and H probe through a 75 mm Rb cell to PD_SAS). The main H-polarized beam continues right into an 80 MHz cat-eye AOM double-pass (+160 MHz total shift); the double-passed QWP rotates H to V so PBS1 reflects the return beam downward, where two steering mirrors fold it back to the left side through a 5% power-monitoring sampler (to PD_MON) and into output fiber coupler FC1.", "modules": [{"id": "source_iso", "title": "780 nm Source & Isolation", "region": [20.0, 115.0, 190.0, 80.0], "description": "ECDL source, optical isolator, and spectroscopy pickoff waveplate/PBS."}, {"id": "sas", "title": "Rb Saturated Absorption Spectroscopy", "region": [155.0, 195.0, 360.0, 165.0], "description": "Counter-propagating pump/probe Doppler-free Rb vapor cell spectroscopy for laser frequency locking."}, {"id": "aom_dp", "title": "80 MHz Cat-Eye AOM Double-Pass (+160 MHz in -x return)','", "region": [270.0, 110.0, 295.0, 90.0], "description": "Cat-eye double-pass AOM shifting the main beam by +160 MHz and flipping H to V."}, {"id": "output_fold", "title": "U-Fold Output & 5% Power Monitor", "region": [30.0, 15.0, 320.0, 95.0], "description": "Two fold mirrors return the shifted beam to the left edge through a 5% pickoff sampler into the output fiber."}], "baseplate": {"width_mm": 580.0, "height_mm": 375.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "780 nm ECDL (Rb D2, collimated w=0.43 mm, waist at AOM/FC1)','", "group": "source_iso", "part_number": "Toptica DL pro 780", "position": [50.0, 155.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 35.0, "waist_mm": 0.43, "waist_offset_mm": 350.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO1", "type": "isolator", "label": "Optical isolator (780 nm)','", "group": "source_iso", "part_number": "IO-3D-780-VLP", "beam": "L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.92, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP1", "type": "half_wave_plate", "label": "SAS pickoff lambda/2 (10% to V)','", "group": "source_iso", "part_number": "WPH05M-780", "beam": "L1", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 9.2, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS_SAS", "type": "pbs", "label": "SAS pickoff PBS", "group": "source_iso", "part_number": "PBS052", "beam": "L1", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S_SAS", "type": "sampler", "label": "Pump/probe splitter (10% probe)','", "group":