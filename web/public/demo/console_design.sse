o": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.3, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "FC1", "kind": "min_power_mw", "value": 8.0}, {"element_id": "FC1", "kind": "min_coupling", "value": 0.8}, {"element_id": "FC1", "kind": "polarization", "value": "V"}], "notes": "Cat-eye AOM double-pass at 780.24 nm: LENS1 (f=75 mm) is placed 75 mm after AOM1 and 75 mm before retro mirror M1 so the +1 order is retro-reflected independent of RF drive frequency. QWP1 at 45 deg rotates polarization from H to V over the double pass, causing PBS1 to reflect the return beam (+y) onto fold mirror M2 and into output coupler FC1."}, "trace": {"segments": [{"id": "s0", "branch": "L1", "source_id": "L1", "start": [75.0, 55.0], "end": [100.0, 55.0], "direction_deg": 0.0, "length_mm": 25.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 25.0, "jones": [[0.9848077530122081, 0.0], [0.17364817766693036, 0.0]], "polarization_label": "linear 10\u00b0", "waist_z_mm": 0.0, "rayleigh_mm": 744.4894925263416, "w0_mm": 0.43, "w_start_mm": 0.43, "w_end_mm": 0.43024237005080795, "start_element": "L1", "end_element": "HWP1", "end_reason": "element"}, {"id": "s1", "branch": "L1", "source_id": "L1", "start": [100.0, 55.0], "end": [125.0, 55.0], "direction_deg": 0.0, "length_mm": 25.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 25.0, "jones": [[1.0, 0.0], [-9.891313218354829e-36, 1.0632884247878856e-17]], "polarization_label": "H", "waist_z_mm": -25.0, "rayleigh_mm": 744.4894925263416, "w0_mm": 0.43, "w_start_mm": 0.43024237005080795, "w_end_mm": 0.43096866237320025, "start_element": "HWP1", "end_element": "PBS1", "end_reason": "element"}, {"id": "s2", "branch": "L1.t", "source_id": "L1", "start": [125.0, 55.0], "end": [175.0, 55.0], "direction_deg": 0.0, "length_m