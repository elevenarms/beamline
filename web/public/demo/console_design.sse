": "mirror", "label": "Cat-eye retro mirror", "group": null, "part_number": "BB05-E03", "beam": "L1.t.t.+1", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": 180.8513, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_OUT1", "type": "mirror", "label": "Output walk mirror 1", "group": null, "part_number": "BB05-E03", "beam": "L1.t.t.+1.+1.r", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_GHOST", "type": "beam_dump", "label": "Return 0th-order ghost block", "group": null, "part_number": "LB1", "beam": "L1.t.t.+1.0.r", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 1.5, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S_MON", "type": "sampler", "label": "5% power monitor pickoff", "group": null, "part_number": "BSF05-B", "beam": "L1.t.t.+1.+1.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_MON", "type": "photodiode", "label": "Power monitor PD (5%)", "group": null, "part_number": "PDA36A2", "beam": "L1.t.t.+1.+1.r.r", "distance_mm": 25.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_OUT2", "type": "mirror", "label": "Output walk mirror 2", "group": null, "part_number": "BB05-E03", "beam": "L1.t.t.+1.+1.r.t", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC1", "type": "fiber_coupler", "label": "Output fiber coupler (+160 MHz shifted)_", "group": null, "part_number": "PAF2-A4B", "beam": "L1.t.t.+1.+1.r.t", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 4.6, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.3, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S_SAS", "type": "sampler", "label": "SAS probe/pump splitter (10% probe)_", "group": null, "part_number": "BSF05-B", "beam": "L1.r", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP_PR", "type": "half_wave_plate", "label": "Probe lambda/2 (V to H)_", "group": null, "part_number": "WPH05M-780", "beam": "L1.r.r", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS_SAS1", "type": "pbs", "label": "SAS pump rejection PBS", "group": null, "part_number": "PBS052", "beam": "L1.r.r", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_SAS_PR", "type": "beam_dump", "label": "Residual V probe dump", "group": null, "part_number": "LB1", "beam": "L1.r.r.r", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "CELL1", "type": "vapor_cell", "label": "Rb-87 vapor cell (75 mm)_", "group": null, "part_number": "GC25075-RB", "beam": "L1.r.r.t", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.6, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS_SAS2", "type": "pbs", "label": "SAS pump injection PBS", "group": null, "part_number": "PBS052", "beam": "L1.r.r.t", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_SAS", "type": "photodiode", "label": "SAS lock photodiode", "group": null, "part_number": "PDA36A2", "beam": "L1.r.r.t.t", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_PUMP1", "type": "mirror", "label": "SAS pump fold mirror 1", "group": null, "part_number": "BB05-E03", "beam": "L1.r.t", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_PUMP2", "type": "mirror", "label": "SAS pump fold mirror 2", "group": null, "part_number": "BB05-E03", "beam": "L1.r.t", "distance_mm": 240.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_PUMP", "type": "beam_dump", "label": "SAS spent pump dump", "group": null, "part_number": "LB1", "beam": null, "distance_mm": null, "at": [240.0, 130.0], "angle_deg": -90.0, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_auto1", "type": "beam_dump", "label": "auto dump (3.69 mW)", "group": null, "part_number": null, "beam": "L1.t.t.0.+1.r.t", "distance_mm": 20.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm":