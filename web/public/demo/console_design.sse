data: {"type": "iteration", "agent_id": "designer-3", "seq": 5, "label": "candidate 3", "design": {"name": "rb780_sas_aom_doublepass_generous", "description": "780 nm Rb D2 laser table with generous spacing across a 600 x 350 mm baseplate. An ECDL followed by a Faraday isolator feeds a HWP + PBS that splits ~10% of the light into a Doppler-free Rb saturated-absorption spectroscopy (SAS) locking module (upper half) and ~90% into a cat-eye 80 MHz AOM double-pass (lower right) giving a +160 MHz shift. The double-passed return beam is extracted at the main PBS, sampled by a 5% pickoff onto a power-monitoring photodiode, and coupled via two steering mirrors into a PM780-HP fiber.", "modules": [{"id": "source_split", "title": "ECDL, Isolator & Main Split", "region": [15.0, 80.0, 220.0, 100.0], "description": "780 nm ECDL, optical isolator and HWP+PBS dividing light between SAS and the AOM double-pass."}, {"id": "sas_lock", "title": "Rb Saturated Absorption Spectroscopy", "region": [180.0, 185.0, 400.0, 150.0], "description": "Counter-propagating pump/probe Doppler-free spectroscopy through a 75 mm Rb vapor cell."}, {"id": "aom_dp", "title": "80 MHz Cat-Eye AOM Double-Pass (+160 MHz in Fiber & 5% Monitor", "region": [180.0, 15.0, 405.0, 165.0], "description": "f=100 mm cat-eye double-pass AOM, 5% power-monitoring pickoff and two-mirror fiber launch."}], "baseplate": {"width_mm": 600.0, "height_mm": 350.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "780 nm ECDL", "group": "source_split", "part_number": "Toptica DL pro 780", "position": [40.0, 130.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 35.0, "waist_mm": 0.43, "waist_offset_mm": 250.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO1", "type": "isolator", "label": "Faraday isolator", "group": "source_split", "part_number": "IO-3D-780-VLP", "beam": "L1", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": nul