om_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "AOM1", "type": "aom", "label": "80 MHz AOM (+1 order)','", "group": "aom_dp", "part_number": "Isomet 1205C-1", "beam": "L1.t.t", "distance_mm": 70.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 2.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": 80.0, "aom_efficiency": 0.85, "aom_order": 1, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "LENS1", "type": "lens", "label": "Cat-eye lens f=75 mm", "group": "aom_dp", "part_number": "AC127-075-B", "beam": "L1.t.t.+1", "distance_mm": 75.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 75.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "QWP1", "type": "quarter_wave_plate", "label": "Cat-eye lambda/4 at 45 deg", "group": "aom_dp", "part_number": "WPQ05M-780", "beam": "L1.t.t.+1", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_AOM0", "type": "beam_dump", "label": "Forward 0th-order knife-edge block", "group": "aom_dp", "part_number": "LB1", "beam": null, "distance_mm": null, "at": [515.0, 155.3], "angle_deg": 0.8513, "out_direction_deg": null, "aperture_mm": 1.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_CAT", "type": "mirror", "label": "Cat-eye retro mirror", "group": "aom_dp", "part_number": "BB05-E03", "beam": "L1.t.t.+1", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": 180.8513, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_OUT1", "type": "mirror", "label": "U-fold steering mirror 1 (-y to -x)','", "group": "output_fold", "part_number": "BB05-E03", "beam": "L1.t.t.+1.+1.r", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_GHOST", "type": "beam_dump", "label": "Return unshifted 0th-order ghost block", "group": "output_fold", "part_number": "LB1", "beam": "L1.t.t.+1.0.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 1.4, "focal_length_mm": null, "fast_axis_deg": null, 