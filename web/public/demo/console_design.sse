 quarter_wave_plate on L1.t.t.+1 at 45 mm"}, {"op": "add", "element_id": "BD_AOM0", "field": null, "from": null, "to": null, "note": "added beam_dump at (515, 155.3)"}, {"op": "add", "element_id": "M_CAT", "field": null, "from": null, "to": null, "note": "added mirror on L1.t.t.+1 at 30 mm"}, {"op": "add", "element_id": "M_OUT1", "field": null, "from": null, "to": null, "note": "added mirror on L1.t.t.+1.+1.r at 100 mm"}, {"op": "add", "element_id": "BD_GHOST", "field": null, "from": null, "to": null, "note": "added beam_dump on L1.t.t.+1.0.r at 55 mm"}, {"op": "add", "element_id": "M_OUT2", "field": null, "from": null, "to": null, "note": "added mirror on L1.t.t.+1.+1.r at 110 mm"}, {"op": "add", "element_id": "M_OUT3", "field": null, "from": null, "to": null, "note": "added mirror on L1.t.t.+1.+1.r at 35 mm"}, {"op": "add", "element_id": "S_MON", "field": null, "from": null, "to": null, "note": "added sampler on L1.t.t.+1.+1.r at 65 mm"}, {"op": "add", "element_id": "PD_MON", "field": null, "from": null, "to": null, "note": "added photodiode on L1.t.t.+1.+1.r.r at 45 mm"}, {"op": "add", "element_id": "FC1", "field": null, "from": null, "to": null, "note": "added fiber_coupler on L1.t.t.+1.+1.r.t at 85 mm"}]}

