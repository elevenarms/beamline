ration_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_PUMP1", "type": "mirror", "label": "SAS pump fold mirror 1", "group": null, "part_number": "BB05-E03", "beam": "L1.r.t", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_PUMP2", "type": "mirror", "label": "SAS pump fold mirror 2", "group": null, "part_number": "BB05-E03", "beam": "L1.r.t", "distance_mm": 240.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_PUMP", "type": "beam_dump", "label": "SAS spent pump dump", "group": null, "part_number": "LB1", "beam": null, "distance_mm": null, "at": [240.0, 130.0], "angle_deg": -90.0, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_auto1", "type": "beam_dump", "label": "auto dump (3.69 mW)", "group": null, "part_number": null, "beam": "L1.t.t.0.+1.r.t", "distance_mm": 20.0, "at": null, "angle_deg": null, "out_direction_d