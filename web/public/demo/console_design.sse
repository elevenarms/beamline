data: {"type": "candidate", "index": 3, "stage": "design", "design": {"name": "aom_doublepass_780_monitored", "description": "780 nm fiber-in fiber-out cat-eye AOM double-pass (+160 MHz total shift) with an integrated 5% wedged sampler pickoff onto a monitor photodiode PD1 in the output arm before the fiber coupler FC1 for active RF power stabilization.", "modules": [{"id": "input_cleanup", "title": "Input Collimation & Polarization Cleanup", "region": [20.0, 10.0, 130.0, 80.0], "description": "PM780-HP fiber collimator, half-wave plate and PBS for pure H polarization into the AOM."}, {"id": "cat_eye_doublepass", "title": "80 MHz Cat-Eye AOM Double-Pass", "region": [155.0, 20.0, 210.0, 60.0], "description": "Isomet 80 MHz AOM, f=75 mm cat-eye lens, QWP at 45 deg, 0th-order razor block and focal-plane retro mirror."}, {"id": "output_coupling", "title": "Output Arm with Power Monitor Pickoff", "region": [100.0, 95.0, 280.0, 75.0], "description": "Fold mirror, return 0th-order ghost dump, 5% wedged sampler to PD1, and mode-matched output fiber coupler FC1."}], "baseplate": {"width_mm": 406.4, "height_mm": 177.8, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "Fiber input (PM780-HP via PAF2-A4B)", "group": "input_cleanup", "part_number": "PAF2-A4B", "position": [75.0, 45.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 25.0, "waist_mm": 0.43, "waist_offset_mm": 0.0, "polarization": 15.0, "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "Input lambda/2 (rotate to H)", "group": "input_cleanup", "part_number": "WPH05M-780", "beam": "L1", "distance_mm": 25.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 7.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission"