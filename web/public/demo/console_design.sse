ull, "aperture_mm": 1.5, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC1", "type": "fiber_coupler", "label": "Output fiber coupler (PM780-HP)", "group": "output_coupling", "part_number": "PAF2-A4B", "beam": "L1.t.+1.+1.r", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 4.6, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.3, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "FC1", "kind": "min_power_mw", "value": 8.0}, {"element_id": "FC1", "kind": "min_coupling", "value": 0.8}, {"element_id": "FC1", "kind": "polarization", "value": "V"}], "notes": "Cat-eye AOM double-pass: AOM1 to LENS1 = 75 mm = f, LENS1 to M1 = 75 mm = f. Forward 0th order is blocked by razor-edge dump BD2 just before M1. Return +1/+1 beam (V-polarized after double-passing QWP1 at 45 deg) reflects upward (+y) at PBS1 and is walked by two steering mirrors M2 and M3 into output fiber coupler FC1. Return un-diffracted 0th-order ghost is intercepted by razor dump BD3 between M2 and M3."}, "trace": {"segments": [{"id": "s0", "branch": "L1", "source_id": "L1", "start": [65.0, 48.0], "end": [90.0, 48.0], "direction_deg": 0.0, "length_mm": 25.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 25.0, "jones": [[0.9848077530122081, 0.0], [0.17364817766693036, 0.0]], "polarization_label": "linear 10\u00b0", "waist_z_mm": 0.0, "rayleigh_mm": 744.4894925263416, "w0_mm": 0.43, "w_start_mm": 0.43, 