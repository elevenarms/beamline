data: {"type": "iteration", "agent_id": "designer-1", "seq": 1, "label": "candidate 1", "design": {"name": "aom_doublepass_780_linear", "description": "780 nm fiber-in fiber-out AOM double-pass in a linear cat-eye configuration. Fiber-collimated light (PAF2-A4B, w=0.43 mm, 25 mW) is polarization-cleaned by a HWP and PBS, diffracted by an 80 MHz Isomet AOM (+1 order), and retro-reflected through an f=75 mm cat-eye lens and QWP (at 45 deg) so the return beam is rotated to V and diffracted a second time (+160 MHz total). The PBS reflects the V-polarized return beam into a 90-deg fold mirror and output fiber coupler FC1. All residual orders (input V reject, forward 0th order, and return 0th-order ghost) are terminated in beam dumps.", "modules": [{"id": "input_cleanup", "title": "Input Collimator & Polarization Cleanup", "region": [40.0, 10.0, 110.0, 90.0], "description": "Collimated 780 nm fiber input, half-wave plate, and polarizing beamsplitter."}, {"id": "cat_eye_doublepass", "title": "80 MHz Cat-Eye AOM Double-Pass", "region": [155.0, 20.0, 210.0, 80.0], "description": "Isomet 80 MHz AOM, f=75 mm cat-eye lens, quarter-wave plate, 0th-order razor block, and focal-plane retro mirror."}, {"id": "output_coupling", "title": "Output Folding & Fiber Coupling", "region": [100.0, 100.0, 280.0, 70.0], "description": "90-deg fold mirror, return 0th-order ghost dump, and output PM fiber coupler."}], "baseplate": {"width_mm": 406.4, "height_mm": 177.8, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "Fiber input (PM780-HP via PAF2-A4B)", "group": "input_cleanup", "part_number": "PAF2-A4B", "position": [75.0, 55.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 25.0, "waist_mm": 0.43, "waist_offset_mm": 0.0, "polarization": 10.0, "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "Input lambda/2 (rotate to H)", "group": "input_cleanup", "part_number": "WPH05M-780", "beam": "L1", "distance_mm": 25.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 5.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "Polarizing beamsplitter cube", "group": "input_cleanup", "part_number": "PBS052", "beam": "L1", "distance_mm": 25.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD1", "type": "beam_dump", "label": "Dump for rejected V input", "group": "input_cleanup", "part_number": "LB1", "beam": "L1.r", "distance_mm": 25.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "AOM1", "type": "aom", "label": "80 MHz AOM", "group": "cat_eye_doublepass", "part_number": "Isomet 1205C-2", "beam": "L1.t", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 2.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": 80.0, "aom_efficiency": 0.8, "aom_order": 1, "acoustic_