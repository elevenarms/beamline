data: {"type": "iteration", "agent_id": "designer-2", "seq": 4, "label": "candidate 2", "design": {"name": "aom_doublepass_780_folded", "description": "Rb-87 780.24 nm fiber-in fiber-out AOM double-pass in cat-eye configuration on a compact 381x152.4 mm breadboard. Fiber-coupled input light (PM780-HP via PAF2-A4B collimator) is polarization-cleaned by a HWP and PBS, diffracted by an 80 MHz Isomet AOM (+1 order), and retro-reflected through an f=75 mm cat-eye lens, QWP at 45 deg, and focal-plane mirror. The double-passed +160 MHz return beam is rotated to V polarization and reflected by the PBS into a folded output arm with two steering mirrors (M2, M3) for full beam-walk alignment into output fiber coupler FC1. Forward 0th order and return un-diffracted 0th-order ghost beams are cleanly terminated.", "modules": [{"id": "input_cleanup", "title": "Input Collimation & Cleanup", "region": [15.0, 10.0, 125.0, 75.0], "description": "Collimated 780 nm fiber input with HWP and PBS polarization cleanup."}, {"id": "cat_eye_doublepass", "title": "80 MHz Cat-Eye AOM Double-Pass", "region": [140.0, 20.0, 225.0, 65.0], "description": "Isomet 80 MHz AOM, f=75 mm cat-eye lens, QWP, 0th-order razor block, and focal-plane retro mirror."}, {"id": "output_coupling", "title": "Two-Mirror Output Fiber Walk", "region": [20.0, 85.0, 250.0, 60.0], "description": "Return ghost dump and two-mirror steering periscope into output PM fiber coupler FC1."}], "baseplate": {"width_mm": 381.0, "height_mm": 152.4, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "Fiber input (PM780-HP via PAF2-A4B collimator)", "group": "input_cleanup", "part_number": "PAF2-A4B", "position": [65.0, 48.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 25.0, "waist_mm": 0.43, "waist_offset_mm": 0.0, "polarization": 10.0, "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "Input lambda/2 (rotate to H)", "group": "input_cleanup", "part_number": "WPH05M-780", "beam": "L1", "distance_mm": 25.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 5.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "Polarizing beamsplitter cube", "group": "input_cleanup", "part_number": "PBS052", "beam": "L1", "distance_mm": 25.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD1", "type": "beam_dump", "label": "Dump for rejected V input", "group": "input_cleanup", "part_number": "LB1", "beam": "L1.r", "distance_mm": 25.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "AOM1", "type": "aom", "label": "80 MHz TeO2 AOM", "group": "cat_eye_doublepass", "part_number": "Isomet 1205C-2", "beam": "L1.t", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 2.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": 