data: {"type": "candidate", "index": 1, "stage": "design", "design": {"name": "aom_doublepass_780_folded", "description": "Rb-87 780.24 nm fiber-in fiber-out AOM double-pass in cat-eye configuration on a compact 381x152.4 mm breadboard. Fiber-coupled input light (PM780-HP via PAF2-A4B collimator) is polarization-cleaned by a HWP and PBS, diffracted by an 80 MHz Isomet AOM (+1 order), and retro-reflected through an f=75 mm cat-eye lens, QWP at 45 deg, and focal-plane mirror. The double-passed +160 MHz return beam is rotated to V polarization and reflected by the PBS into a folded output arm with two steering mirrors (M2, M3) for full beam-walk alignment into output fiber coupler FC1. Forward 0th order and return un-diffracted 0th-order ghost beams are cleanly terminated.", "modules": [{"id": "input_cleanup", "title": "Input Collimation & Cleanup", "region": [15.0, 10.0, 125.0, 75.0], "description": "Collimated 780 nm fiber input with HWP and PBS polarization cleanup."}, {"id": "cat_eye_doublepass", "title": "80 MHz Cat-Eye AOM Double-Pass", "region": [140.0, 20.0, 225.0, 65.0], "description": "Isomet 80 MHz AOM, f=75 mm cat-eye lens, QWP, 0th-order razor block, and focal-plane retro mirror."}, {"id": "output_coupling", "title": "Two-Mirror Output Fiber Walk", "region": [20.0, 85.0, 250.0, 60.0], "description": "Return ghost dump and two-mirror steering periscope into output PM fiber coupler FC1."}], "baseplate": {"width_mm": 381.0, "height_mm": 152.4, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "Fiber input (PM780-HP via PAF2-A4B collimator)", "group": "input_cleanup", "part_number": "PAF2-A4B", "position": [65.0, 48.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 25.0, "waist_mm": 0.43, "waist_offset_mm": 0.0, "polarization": 10.0, "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "Input lambda/2 (rotate to H)", "group": "input_cleanup", "part_number": "WPH05M-78