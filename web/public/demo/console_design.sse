data: {"type": "candidate", "index": 3, "stage": "design", "design": {"name": "rb780_sas_aom_doublepass_minimal", "description": "Minimal-part-count 780 nm Rb laser setup combining saturated absorption spectroscopy (SAS) for laser locking, a cat-eye +160 MHz AOM double-pass feeding an output fiber, and a 5% pickoff photodiode for power monitoring.", "modules": [], "baseplate": {"width_mm": 500.0, "height_mm": 250.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "780 nm ECDL (collimated, after isolator stage on laser head, waist 0.43 mm for AOM & PAF2-A4B mode match, H-pol rotated slightly by HWP1 -> represented directly or via HWP1+PBS1): let's use H-pol and HWP1", "group": null, "part_number": "Toptica DL pro 780", "position": [40.0, 100.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 30.0, "waist_mm": 0.43, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "Split-ratio lambda/2", "group": null, "part_number": "WPH05M-780", "beam": "L1", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 9.2, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "Main / SAS split PBS", "group": null, "part_number": "PBS052", "beam": "L1", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 