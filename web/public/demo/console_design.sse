data: {"type": "iteration", "agent_id": "designer-3", "seq": 2, "label": "candidate 3", "design": {"name": "aom_doublepass_780_f100", "description": "780.24 nm fiber-in fiber-out cat-eye AOM double-pass using a longer f=100 mm cat-eye lens for larger spatial separation (~1.5 mm) between the 0th and +1 orders. Collimated light from a PM780-HP fiber (PAF2-A4B, w=0.43 mm) is polarization-cleaned by a HWP and PBS, diffracted by an 80 MHz TeO2 AOM (+1 order), and retro-reflected through an f=100 mm lens, QWP (45 deg), and focal-plane mirror. The forward 0th order is blocked before the retro mirror, and the double-passed +1/+1 V-polarized return beam (+160 MHz shift) is reflected by the PBS into output fiber coupler FC1 while the un-diffracted return ghost is caught by a razor dump.", "modules": [{"id": "input_cleanup", "title": "Input Collimation & Cleanup", "region": [20.0, 20.0, 130.0, 140.0], "description": "Fiber collimator input, HWP, and PBS polarization cleanup"}, {"id": "cat_eye_doublepass", "title": "f=100 mm Cat-Eye AOM Double-Pass", "region": [150.0, 20.0, 290.0, 75.0], "description": "80 MHz AOM, f=100 mm cat-eye lens, QWP, 0th-order block, and retro mirror"}, {"id": "output_coupling", "title": "Output Coupling & Ghost Dump", "region": [110.0, 95.0, 330.0, 75.0], "description": "Output fold mirror, return 0th-order ghost block, and output fiber coupler FC1"}], "baseplate": {"width_mm": 457.2, "height_mm": 177.8, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "Fiber input (PM780-HP via PAF2-A4B)", "group": "input_cleanup", "part_number": "PAF2-A4B", "position": [50.0, 50.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 25.0, "waist_mm": 0.43, "waist_offset_mm": 0.0, "polarization": 15.0, "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "Input lambda/2 (rotate to H)", "group": "input_cleanup", "part_number": "WPH05M-780", "beam": "L1", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 7.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "Polarizing beamsplitter cube", "group": "input_cleanup", "part_number": "PBS052", "beam": "L1", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD1", "type": "beam_dump", "label": "Rejected V input dump", "group": "input_cleanup", "part_number": "LB1", "beam": "L1.r", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "AOM1", "type": "aom", "label": "80 MHz AOM (+1 order)", "group": "cat_eye_doublepass", "part_number": "Isomet 1205C-2", "beam": "L1.t", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 2.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": 80.0, "aom_efficiency": 0.8, "aom_order": 1, "acoustic_velocity_m_s": 