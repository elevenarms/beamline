data: {"type": "iteration", "agent_id": "designer-1", "seq": 4, "label": "autofix", "design": {"name": "rb780_sas_aom_doublepass_linear", "description": "Compact linear 780 nm Rb laser setup with saturated absorption spectroscopy (SAS) for frequency locking, an 80 MHz cat-eye AOM double-pass (+160 MHz shift) along the main +x axis, a 5% power-monitoring pickoff photodiode, and fiber coupling via a two-mirror beam walk.", "modules": [], "baseplate": {"width_mm": 558.8, "height_mm": 254.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "780 nm ECDL", "group": null, "part_number": "Toptica DL pro 780", "position": [35.0, 100.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 30.0, "waist_mm": 0.43, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO1", "type": "isolator", "label": "Optical isolator", "group": null, "part_number": "IO-3D-780-VLP", "beam": "L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.9, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP1", "type": "half_wave_plate", "label": "SAS split lambda/2", "group": null, "part_number": "WPH05M-780", "beam": "L1", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 9.2, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type