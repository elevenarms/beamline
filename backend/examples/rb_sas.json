{
  "name": "rb_sas",
  "description": "Rb D2 (780 nm) saturated-absorption spectroscopy module (after PyOpticL's scalable_rb_sas). A HWP + PBS picks off ~10% of the laser for spectroscopy and sends the rest to an output fiber. A wedged sampler splits the pickoff into a weak probe (reflection) and a strong pump (transmission). The probe is rotated to H and passes through PBS3, the 75 mm Rb vapor cell and PBS2 onto a photodiode; the V-polarized pump is injected counter-propagating by PBS2 and removed by PBS3 into a beam dump, giving Doppler-free lock signals.",
  "baseplate": {
    "width_mm": 508.0,
    "height_mm": 152.4,
    "thickness_mm": 25.4,
    "optical_height_mm": 12.7,
    "grid_mm": 25.4
  },
