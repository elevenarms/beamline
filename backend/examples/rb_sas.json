      "label": "ECDL output (collimated, after isolator)",
      "part_number": "Toptica DL pro 780",
      "position": [
        75.0,
        30.0
      ],
      "direction_deg": 0.0,
      "wavelength_nm": 780.24,
      "power_mw": 20.0,
      "waist_mm": 1.0,
      "polarization": "H"
    }
  ],
