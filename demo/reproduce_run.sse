data: {"type": "final", "design": {"name": "rb_sas_pyopticl_fig2a", "description": "Rb-87 saturated absorption spectroscopy (780 nm, 1-inch mounted optics) from PyOpticL Fig. 2a. An input beam travelling +y passes through HWP_in and PBS_in, which picks off the spectroscopy branch to the left (-x) while transmitting the main beam. Mirror M1 folds the branch down (-y) onto a 10:90 beam sampler: the 10% reflected probe is rotated from V to H by HWP_probe, walked by mirrors M2 and M3 through the Rb vapor cell and PBS_cell onto photodiode PD. The 90% transmitted pump (V-polarized) is steered around the bottom by M4 and M5 into PBS_cell, which reflects it (+x) counter-propagating through the Rb cell; on the other side it re-traverses M3, M2, HWP_probe and the sampler. Unused outputs are terminated in beam dumps.", "baseplate": {"width_mm": 500.0, "height_mm": 190.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "780 nm input beam", "part_number": "Toptica DL pro 780", "position": [455.0, 20.0], "direction_deg": 90.0, "wavelength_nm": 780.24, "power_mw": 20.0, "waist_mm": 1.0, "waist_offset_mm": 0.0, "polarization": "H"}], "elements": [{"id": "HWP_in", "type": "half_wave_plate", "label": "lambda/2 (branch pickoff)", "part_number": "WPH10M-780", "beam": "L1", "distance_mm": 70.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 13.3, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "PBS_in", "type": "pbs", "label": "PBS (branch split)", "part_number": "PBS252", "beam": "L1", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "BD_main", "type": "beam_dump", "label": "Main through-beam dump", "part_number": "LB1", "beam": "L1.t", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "M1", "type": "mirror", "label": "Branch fold mirror", "part_number": "BB1-E03", "beam": "L1.r", "distance_mm": 90.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "BS", "type": "sampler", "label": "Beam sampler (10% probe / 90% pump)", "part_number": "BSF10-B", "beam": "L1.r", "distance_mm": 25.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "HWP_probe", "type": "half_wave_plate", "label": "lambda/2 (probe V->H)", "part_number": "WPH10M-780", "beam": "L1.r.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "M2", "type": "mirror", "label": "Probe fold mirror 1", "part_number": "BB1-E03", "beam": "L1.r.r", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "M3", "type": "mirror", "label": "Probe fold mirror 2", "part_number": "BB1-E03", "beam": "L1.r.r", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "CELL", "type": "vapor_cell", "label": "Rb cell (insulating mount)", "part_number": "GC25075-RB", "beam": "L1.r.r", "distance_mm": 95.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.7}, {"id": "PBS_cell", "type": "pbs", "label": "PBS (pump injection)", "part_number": "PBS252", "beam": "L1.r.r", "distance_mm": 75.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "PD", "type": "photodiode", "label": "PD (probe detector)", "part_number": "PDA36A2", "beam": "L1.r.r.t", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "M4", "type": "mirror", "label": "Pump fold mirror 1", "part_number": "BB1-E03", "beam": "L1.r.t", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "HWP_pump", "type": "half_wave_plate", "label": "lambda/2 (pump, keep V)", "part_number": "WPH10M-780", "beam": "L1.r.t", "distance_mm": 115.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 0.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "M5", "type": "mirror", "label": "Pump fold mirror 2", "part_number": "BB1-E03", "beam": "L1.r.t", "distance_mm": 140.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "BD_pump_t", "type": "beam_dump", "label": "Counter-propagating pump dump (sampler .t)", "part_number": "LB1", "beam": null, "distance_mm": null, "at": [420.0, 115.0], "angle_deg": 0.0, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "BD_pump_leak", "type": "beam_dump", "label": "PBS_cell top port dump", "part_number": "LB1", "beam": null, "distance_mm": null, "at": [110.0, 165.0], "angle_deg": 90.0, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}], "targets": [{"element_id": "PD", "kind": "min_power_mw", "value": 0.15}, {"element_id": "PD", "kind": "polarization", "value": "H"}], "notes": "HWP_in at 13.3 deg rotates ~20% (4 mW) into V so PBS_in reflects it onto the spectroscopy branch. BS reflects 10% (0.4 mW) as probe and transmits 90% (3.6 mW) as pump. Probe is rotated V->H by HWP_probe, traverses CELL (transmission 0.7 -> 0.28 mW) and transmits through PBS_cell to PD. Pump stays V (HWP_pump at 0 deg), enters PBS_cell from -y and reflects (+x) counter-propagating through CELL, M3, M2, HWP_probe (V->H) and BS, where 90% transmits to BD_pump_t and 10% reflects up through M1 to PBS_in (transmitting as H into the right side)."}, "report": {"passed": true, "score": 80.07017087025977, "checks": [{"id": "stray_beam", "severity": "warning", "message": "weak unterminated beam on L1.r.t.r.r.t (0.253 mW)", "element_id": null, "segment_id": "s17", "value": 0.252615132935181, "limit": 0.05}, {"id": "collision", "severity": "warning", "message": "M1 and BS footprints overlap (25.0 mm apart)", "element_id": "M1", "segment_id": null, "value": null, "limit": null}, {"id": "collision", "severity": "warning", "message": "M2 and M3 footprints overlap (35.0 mm apart)", "element_id": "M2", "segment_id": null, "value": null, "limit": null}, {"id": "no_light",