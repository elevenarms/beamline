h_nm": 780.0}, {"from": "HWP_pump", "to": "M5", "label": "pump", "wavelength_nm": 780.0}, {"from": "M5", "to": "PBS_cell", "label": "pump", "wavelength_nm": 780.0}, {"from": "PBS_cell", "to": "CELL", "label": "pump", "wavelength_nm": 780.0}], "parameters": [{"name": "wavelength", "value": "780", "unit": "nm", "evidence": "Rb cell"}, {"name": "probe_fraction", "value": "10", "unit": "%", "evidence": "10%"}, {"name": "pump_fraction", "value": "90", "unit": "%", "evidence": "90%"}, {"name": "optic_diameter", "value": "1", "unit": "in", "evidence": "a) 1\" mounted optics"}], "notes": "Counter-propagating pump (90% transmitted through beam sampler) and probe (10% reflected by beam sampler) overlap inside the Rb cell (with insulating mount); PBS_cell reflects the s-polarized pump into the cell and transmits the p-polarized probe to PD."}}

