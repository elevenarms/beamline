data: {"type": "candidate", "index": 0, "stage": "design", "design": {"name": "rb_sas_pyopticl_fig2a", "description": "Rb-87 saturated absorption spectroscopy (780 nm, 1-inch mounted optics) from PyOpticL Fig. 2a. An input beam travelling +y passes through HWP_in and PBS_in, which picks off the spectroscopy branch to the left (-x) while transmitting the main beam. Mirror M1 folds the branch down (-y) onto a 10:90 beam sampler: the 10% reflected probe is rotated from V to H by HWP_probe, walked by mirrors M2 and M3 through the Rb vapor cell and PBS_cell onto photodiode PD. The 90% transmitted pump (V-polarized) is steered around the bottom by M4 and M5 into PBS_cell, which reflects it (+x) counter-propagating through the Rb cell; on the other side it re-traverses M3, M2, HWP_probe and the sampler. Unused outputs are terminated in beam dumps.", "baseplate": {"width_mm": 500.0, "height_mm": 190.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "780 nm input beam", "part_number": "Toptica DL pro 780", "position": [455.0, 20.0], "direction_deg": 90.0, "wavelength_nm": 780.24, "power_mw": 20.0, "waist_mm": 1.0, "waist_offset_mm": 0.0, "polarization": "H"}], "elements": [{"id": "HWP_in", "type": "half_wave_plate", "label": "lambda/2 (branch pickoff)", "part_number": "WPH10M-780", "beam": "L1", "distance_mm": 70.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 13.3, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "PBS_in", "type": "pbs", "label": "PBS (branch split)", "part_number": "PBS252", "beam": "L1", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": nu