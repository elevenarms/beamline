mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FPC", "type": "vapor_cell", "label": "Fabry-Perot Cavity", "group": null, "part_number": "SA200-5B", "beam": "ECDL.t.t.r", "distance_mm": 135.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.5, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD1", "type": "photodiode", "label": "Photodetector PD1", "group": null, "part_number": "PDA36A2", "beam": "ECDL.t.t.r", "distance_mm": 125.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M8", "type": "mirror", "label": "Mirror M8 (pump retro)", "group": null, "part_number": "BB1-E03", "beam": "ECDL.t.t.t", "distance_mm": 550.0, "at": null, "angle_deg": null, "out_direction_deg": 175.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_PUMP", "type": "beam_dump", "label": "Pump beam dump", "group": null, "part_number": "LB1", "beam": "ECDL.t.t.t", "distance_mm": 220.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "DPD", "kind": "min_power_mw", "value": 0.3}, {"element_id": "DPD_B", "kind": "min_power_mw", "value": 0.3}, {"element_id": "PD1", "kind": "min_power_mw", "value": 0.8}], "notes": "The thick glass beam splitter in Figure 2 produces two parallel front/back surface probe reflections (modelled as cascaded 5% samplers BS1 and BS2 at x=125 mm, y=180 mm and y=138 mm) that pass through the wide-aperture Rb vapor cell (centred at [406, 159]). The transmitted main beam folds at M2 to partial mirror PM (20% pickoff to Fabry-Perot cavity FPC and PD1) and continues to M8, which steers the counter-propagating pump beam at 175 deg back through the Rb cell (crossing probe 2 inside the cell) into beam dump BD_PUMP.", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "ECDL", "source_id": "ECDL", "start": [30.0, 255.0], "end": [124.99999999999999, 255.0], "direction_deg": 0.0, "length_mm": 94.99999999999999, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 2576.924149361053, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8005434460622405, "start_element": "ECDL", "end_element": "M1", "end_reason": "element"}, {"id": "s1", "branch": "ECDL", "source_id": "ECDL", "start": [124.99999999999999, 255.0], "end": [125.0, 180.0], "direction_deg": -89.99999999999999, "length_mm": 74.99999999999999, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[1.0, -1.2246467991473532e-16], [-0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -94.99999999999999, "rayleigh_mm": 2576.924149361053, "w0_mm": 0.8, "w_start_mm": 0.8005434460622405, "w_end_mm": 0.8017389328583886, "start_element": "M1", "end_element": "BS1", "end_reason": "element"}, {"id": "s2", "branch": "ECDL.t", "source_id": "ECDL", "start": [125.0, 180.0], "end": [125.00000000000001, 138.00000000000003], "direction_deg": -89.99999999999999, "length_mm": 41.99999999999998, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 19.0, "jones": [[1.0, 0.0], [-0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -169.99999999999997, "rayleigh_mm": 2576.924149361053, "w0_mm": 0.8, "w_start_mm": 0.8017389328583886, "w_end_mm": 0.8027026851808248, "start_element": "BS1", "end_element": "BS2", "end_reason": "element"}, {"id": "s3", "branch": "ECDL.t.t", "source_id": "ECDL", "start": [125.00000000000001, 138.00000000000003], "end": [125.00000000000003, 75.00000000000001], "direction_deg": -89.99999999999999, "length_mm": 63.000000000000014, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 18.05, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -211.99999999999994, "rayleigh_mm": 2576.924149361053, "w0_mm": 0.8, "w_start_mm": 0.8027026851808248, "w_end_mm": 0.8045424575486878, "start_element": "BS2", "end_element": "M2", "end_reason": "element"}, {"id": "s4", "branch": "ECDL.t.t", "source_id": "ECDL", "start": [125.00000000000003, 75.00000000000001], "end": [310.0000000000001, 75.00000000000001], "direction_deg": 0.0, "length_mm": 185.00000000000006, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 18.05, "jones": [[1.0, -1.2246467991473532e-16], [-0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -274.99999999999994, "rayleigh_mm": 2576.924149361053, "w0_mm": 0.8, "w_start_mm": 0.8045424575486878, "w_end_mm": 0.8126460041961189, "start_element": "M2", "end_element": "PM", "end_reason": "element"}, {"id": "s5", "branch": "ECDL.t.t.t", "source_id": "ECDL", "start": [310.0000000000001, 75.