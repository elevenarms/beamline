, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD1", "type": "beam_dump", "label": "Counter-propagating pump dump (after passing through CELL to [200,163.5])", "group": null, "part_number": "LB1", "beam": "ECDL.t.t.t", "distance_mm": 206.5, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 12.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "DPD", "kind": "min_power_mw", "value": 0.4}, {"element_id": "PD1", "kind": "min_power_mw", "value": 0.5}], "notes": "Thick glass plate Beam Splitter BS1 is modeled as two consecutive 5% wedged samplers (BS1a at y=175 for Probe 1, BS1b at y=135 for Probe 2) separated by 40 mm so all mounts have >=40 mm clearance. Both probes pass horizontally through the wide-aperture Rb vapor cell unit (CELL at [406,155], aperture 45 mm) and are steered by M4->M6->L1 (y=295) and M5->M7->L2 (y=245) into the Differential Photodetector (DPD at [815,270]). The transmitted strong beam reflects off M2 ([122,75]) to Partial Mirror PM ([310,75]), which reflects 10% down to M3 ([310,33]) -> Fabry-Perot Cavity path -> PD1 ([568,33]), and transmits 90% as the pump beam to the right-side mirror system (M8/M8b at x=855), sending the counter-propagating pump at a shallow angle (176.2 deg) back through CELL overlapping Probe 2 and terminating cleanly in beam dump BD1 at [200,163.5].", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "ECDL", "source_id": "ECDL", "start": [30.0, 260.0], "end": [72.0, 2