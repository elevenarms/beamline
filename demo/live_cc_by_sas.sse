data: {"type": "candidate", "index": 1, "stage": "repair", "round": 1, "design": {"name": "rb_dual_probe_sas_with_fpc", "description": "Dual-probe Rb saturated absorption spectroscopy with a Fabry-Perot reference cavity (reproduced from Figure 2). An ECDL at 780.24 nm is directed by M1 down through a thick beam-splitter plate (modelled as two cascaded uncoated samplers BS1 and BS2) that reflects two parallel weak probe beams (probe 1 and probe 2) along +x through the heated, magnetically shielded Rb vapor cell. After the cell, probe 1 is folded up and into lens L1 by M4 and M6, while probe 2 is folded up and into lens L2 by M5 and M7; both focus onto the two inputs of a differential photodetector (DPD1, DPD2). The strong transmitted beam from the splitter plate is folded by M2 to a partial mirror PM, which picks off a reference beam via M3 through the Fabry-Perot cavity onto photodetector PD1. The main pump beam transmitted through PM is retro-angled by M8 back through the Rb cell to overlap probe 2 (giving Doppler-free saturation on one channel while probe 1 provides Doppler-broadened background subtraction) and is terminated at beam dump BD_PUMP.", "modules": [], "baseplate": {"width_mm": 890.0, "height_mm": 325.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "ECDL", "label": "ECDL (780 nm, 20 mW, w0=0.8 mm, H-pol) -> M1 -> BS1/BS2", "group": null, "part_number": "Toptica DL pro 780", "position": [30.0, 255.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 20.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "M1", "type": "mirror", "label": "Mirror M1", "group": null, "part_number": "BB1-E03", "beam": "ECDL", "distance_mm": 95.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BS1", "type": "sampler", "label": "Beam Splitter (front face, probe 1) -> CELL -> M4", "group": null, "part_number": "BSF10-B", "beam": "ECDL", "distance_mm": 75.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BS2", "type": "sampler", "label": "Beam Splitter (back face, probe 2) -> CELL -> M5", "group": null, "part_number": "BSF10-B", "beam": "ECDL.t", "distance_mm": 42.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "CELL", "type": "vapor_cell", "label": "Rb vapor cell, mag. shielding and heater unit", "group": null, "part_number": "GC25075-RB", "beam": null, "distance_mm": null, "at": [406.0, 159.0], "angle_deg": 0.0, "out_direction_deg": null, "aperture_mm": 60.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.7, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M4", "type": "mirror", "label": "Mirror M4 (probe 1) -> M6 -> L1 -> DPD", "group": null, "part_number": "BB1-E03", "beam": "ECDL.r", "distance_mm": 192.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M6", "type": "mirror", "label": "Mirror M6 (probe 1) -> L1 -> DPD", "group": null, "part_number": "BB1-E03", "beam": "ECDL.r", "distance_mm": 115.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L1", "type": "lens", "label": "Lens L1 (probe 1, f=100 mm) -> DPD", "group": null, "part_number": "LA1509-B", "beam": "ECDL.r", "distance_mm": 120.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "DPD", "type": "photodiode", "label": "Differential Photodetector (ch 1, probe 1)...", "group": null, "part_number": "PDB210A", "beam": "ECDL.r", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M5", "type": "mirror", "label": "Mirror M5 (probe 2) -> M7 -> L2 -> DPD_B", "group": null, "part_number": "BB1-E03", "beam": "ECDL.t.r", "distance_mm": 246.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M7", "type": "mirror", "label": "Mirror M7 (probe 2) -> L2 -> DPD_B", "group": null, "part_number": "BB1-E03", "beam": "ECDL.t.r", "distance_mm": 97.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L2", "type": "lens", "label": "Lens L2 (probe 2, f=100 mm) -> DPD_B", "group": null, "part_number": "LA1509-B", "beam": "ECDL.t.r", "distance_mm": 66.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "DPD_B", "type": "photodiode", "label": "Differential Photodetector (ch 2, probe 2)...", "group": null, "part_number": "PDB210A", "beam": "ECDL.t.r", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "Mirror M2 -> PM", "group": null, "part_number": "BB1-E03", "beam": "ECDL.t.t", "distance_mm": 63.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PM", "type": "beamsplitter", "label": "Partial Mirror -> M3 -> FPC -> PD1 & -> M8", "group": null, "part_number": "BS010", "beam": "ECDL.t.t", "distance_mm": 185.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.2, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M3", "type": "mirror", "label": "Mirror M3 -> FPC -> PD1", "group": null, "part_number": "BB1-E03", "beam": "ECDL.t.t.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FPC", "type": "vapor_cell", "label": "Fabry-Perot Cavity -> PD1", "group": null, "part_number": "SA200-5B", "beam": "ECDL.t.t.r", "distance_mm": 135.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.5, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD1", "type": "photodiode", "label": "Photodetector PD1", "group": null, "part_number": "PDA36A2", "beam": "ECDL.t.t.r", "distance_mm": 125.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M8", "type": "mirror", "label": "Mirror M8 (pump retro) -> CELL -> BD_PUMP", "group": null, "part_number": "BB1-E03", "beam": "ECDL.t.t.t", "distance_mm": 550.0, "at": null, "angle_deg": null, "out_direction_deg": 170.9, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_PUMP", "type": "beam_dump", "label": "Pump beam dump", "group": null, "part_number": "LB1", "beam": "ECDL.t.t.t", "distance_mm": 200.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "DPD", "kind": "min_power_mw", "value": 0.3}, {"element_id": "DPD_B", "kind": "min_power_mw", "value": 0.3}, {"element_id": "PD1", "kind": "min_power_mw", "value": 0.8}], "notes": "The thick glass beam splitter in Figure 2 produces two parallel front/back surface probe reflections (modelled as cascaded 5% samplers BS1 and BS2 at x=125 mm, y=180 mm and y=138 mm) that pass through the wide-aperture Rb vapor cell (centred at [406, 159]). After CELL, M4 sits at x=598 mm (distance 192 mm from CELL) and M5 sits at x=652 mm (distance 246 mm from CELL). The transmitted main beam folds at M2 to partial mirror PM (20% pickoff to Fabry-Perot cavity FPC and PD1) and continues to M8, which steers the counter-propagating pump beam at 170.9 deg back through the Rb cell (crossing probe 2 inside the cell) into beam dump BD_PUMP.", "logic": null}, "report": {"passed": true, "score": 85.93875, "checks": [{"id": "collision", "severity": "warning", "message": "CELL and M5 footprints overlap (40.8 mm apart)", "element_id": "CELL", "segment_id": null, "value": null, "limit": null}, {"id": "beam_through_mount", "severity": "warning", "message": "beam ECDL.t.r passes through CELL's mount without interacting", "element_id": "CELL", "segment_id": "s11", "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "CELL receives no light", "element_id": "CELL", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "info", "message": "met: DPD: 1.000 mW (need \u2265 0.300)", "element_id": "DPD", "segment_id": null, "value": 1.0, "limit": 0.3}, {"id": "target", "severity": "info", "message": "met: DPD_B: 0.950 mW (need \u2265 0.300)", "element_id": "DPD_B", "segment_id": null, "value": 0.9500000000000001, "limit": 0.3}, {"id": "target", "severity": "info", "message": "met: PD1: 1.805 mW (need \u2265 0.800)", "element_id": "PD1", "segment_id": null, "value": 1.8050000000000002, "limit": 0.8}], "metrics": {"input_mw": 20.0, "delivered_mw": 3.7550000000000003, "dumped_mw": 14.440000000000001, "stray_mw": 0.0, "n_elements": 19.0, "n_segments": 18.0, "target.DPD.min_power_mw": 1.0, "target.DPD_B.min_power_mw": 0.9500000000000001, "target.PD1.min_power_mw": 1.8050000000000002, "delivered_fraction": 0.18775000000000003}}, "trace": {"segments": [{"id": "s0", "branch": "ECDL", "source_id": "ECDL", "start": [30.0, 255.0], "end": [124.99999999999999, 255.0], "direction_deg": 0.0, "length_mm": 94.99999999999999, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 2576.924149361053, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8005434460622405, "start_element": "ECDL", "end_element": "M1", "end_reason": "element"}, {"id": "s1", "branch": "ECDL", "source_id": "ECDL", "start": [124.99999999999999, 255.0], "end": [125.0, 180.0], "direction_deg": -89.99999999999999, "length_mm": 74.99999999999999, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[1.0, -1.2246467991473532e-16], [-0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -94.99999999999999, "rayleigh_mm": 2576.924149361053, "w0_mm": 0.8, "w_start_mm": 0.8005434460622405, "w_end_mm": 0.8017389328583886, "start_element": "M1", "end_element": "BS1", "end_reason": "elemen