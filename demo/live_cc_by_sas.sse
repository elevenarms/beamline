ull, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "DPD", "kind": "min_power_mw", "value": 0.3}, {"element_id": "DPD_B", "kind": "min_power_mw", "value": 0.3}, {"element_id": "PD1", "kind": "min_power_mw", "value": 0.8}], "notes": "The thick glass beam splitter in Figure 2 produces two parallel front/back surface probe reflections (modelled as cascaded 5% samplers BS1 and BS2 at x=125 mm, y=180 mm and y=138 mm) that pass through the wide-aperture Rb vapor cell (centred at [406, 159]). The transmitted main beam folds at M2 to partial mirror PM (20% pickoff to Fabry-Perot cavity FPC and PD1) and continues to M8, which steers the counter-propagating pump beam at 175 deg back through the Rb cell (crossing probe 2 inside the cell) into beam dump BD_PUMP.", "logic": null}, "report": {"passed": true, "score": 85.93875, "checks": [{"id": "collision", "severity": "warning", "message": "CELL and M5 footprints overlap (30.4 mm apart)", "element_id": "CELL", "segment_id": null, "value": null, "limit": null}, {"id": "beam_through_mount", "severity": "warning", "message": "beam ECDL.t.r passes through CELL's mount without interacting", "element_id": "CELL", "segment_id": "s11", "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "CELL receives no light", "element_id": "CELL", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "info", "message": "met: DPD: 1.000 mW (need \u2265 0.300)", "element_id": "DPD", "segment_id": null, "value": 1.0, "limit": 0.3}, {"id": "target", "severity": "info", "message": "met: DPD_B: 0.950 mW (need \u2265 0.300)", "element_id": "DPD_B", "segment_id": null, 