data: {"type": "candidate", "index": 0, "stage": "design", "design": {"name": "rb_dual_probe_sas_with_fpc", "description": "Dual-probe Rb saturated absorption spectroscopy with a Fabry-Perot reference cavity (reproduced from Figure 2). An ECDL at 780.24 nm is directed by M1 down through a thick beam-splitter plate (modelled as two cascaded uncoated samplers BS1 and BS2) that reflects two parallel weak probe beams (probe 1 and probe 2) along +x through the heated, magnetically shielded Rb vapor cell. After the cell, probe 1 is folded up and into lens L1 by M4 and M6, while probe 2 is folded up and into lens L2 by M5 and M7; both focus onto the two inputs of a differential photodetector (DPD1, DPD2). The strong transmitted beam from the splitter plate is folded by M2 to a partial mirror PM, which picks off a reference beam via M3 through the Fabry-Perot cavity onto photodetector PD1. The main pump beam transmitted through PM is retro-angled by M8 back through the Rb cell to overlap probe 2 (giving Doppler-free saturation on one channel while probe 1 provides Doppler-broadened background subtraction) and is terminated at beam dump BD_PUMP.", "modules": [], "baseplate": {"width_mm": 890.0, "height_mm": 325.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "ECDL", "label": "ECDL (780 nm)", "group": null, "part_number": "Toptica DL pro 780", "position": [30.0, 255.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 20.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "M1", "type": "mirror", "label": "Mirror M1", "group": null, "part_number": "BB1-E03", "beam": "ECDL", "distance_mm": 95.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, 