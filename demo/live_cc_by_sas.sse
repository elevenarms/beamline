ull, "nl_efficiency_per_w": null}, {"id": "DPD_B", "type": "photodiode", "label": "Differential Photodetector (ch 2, probe 2)...", "group": null, "part_number": "PDB210A", "beam": "ECDL.t.r", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "Mirror M2 -> PM", "group": null, "part_number": "BB1-E03", "beam": "ECDL.t.t", "distance_mm": 63.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PM", "type": "beamsplitter", "label": "Partial Mirror -> M3 -> FPC -> PD1 & -> M8", "group": null, "part_number": "BS010", "beam": "ECDL.t.t", "distance_mm": 185.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.2, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M3", "type": "mirror", "label": "Mirror M3 -> FPC -> PD1", "group": null, "part_number": "BB1-E03", "beam": "ECDL.t.t.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FPC", "type": "vapor_cell", "label": "Fabry-Perot Cavity -> PD1", "group": null, "part_number": "SA200-5B", "beam": "ECDL.t.t.r", "distance_mm": 135.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.5, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD1", "type": "photodiode", "label": "Photodetector PD1", "group": null, "part_number": "PDA36A2", "beam": "ECDL.t.t.r", "distance_mm": 125.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M8", "type": "mirror", "label": "Mirror M8 (pump retro) -> CELL -> BD_PUMP", "group": null, "part_number": "BB1-E03", "beam": "ECDL.t.t.t", "distance_mm": 550.0, "at": null, "angle_deg": null, "out_direction_deg": 170.9, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_PUMP", "type": "beam_dump", "label": "Pump beam dump", "group": null, "part_number": "LB1", "beam": "ECDL.t.t.t", "distance_mm": 560.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "DPD", "kind": "min_power_mw", "value": 0.3}, {"element_id": "DPD_B", "kind": "min_power_mw", "value": 0.3}, {"element_id": "PD1", "kind": "min_power_mw", "value": 0.8}], "notes": "The thick glass beam splitter in Figure 2 produces two parallel front/back surface probe reflections (modelled as cascaded 5% samplers BS1 and BS2 at x=125 mm, y=180 mm and y=138 mm) that pass through the wide-aperture Rb vapor cell (centred at [406, 159]). After CELL, M4 sits at x=598 mm (distance 473 mm from BS1) and M5 sits at x=652 mm (distance 527 mm from BS2). The transmitted main beam folds at M2 to partial mirror PM (20% pickoff to Fabry-Perot cavity FPC and PD1) and continues to M8, which steers the counter-propagating pump beam at 170.9 deg back through the Rb cell (crossing probe 2 inside the cell) into beam dump BD_PUMP.", "logic": null}, "report": {"passed": false, "score": 0.0, "checks": [{"id": "off_table", "severity": "error", "message": "L1 at (999,295) is outside the 890x325 mm baseplate", "element_id": "L1", "segment_id": null, "value": null, "limit": null}, {"id": "off_table", "severity": "error", "message": "DPD at (1099,295) is outside the 890x325 mm baseplate", "element_id": "DPD", "segment_id": null, "value": null, "limit": null}, {"id": "off_table", "severity": "error", "message": "M5 at (933,138) is