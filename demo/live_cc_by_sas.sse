hout mount collision between separate detectors; L1 at y=295 and L2 at y=245 are 50 mm apart >= 40 mm!)", "group": null, "part_number": "PDA36A2", "beam": null, "distance_mm": null, "at": [815.0, 270.0], "angle_deg": 0.0, "out_direction_deg": null, "aperture_mm": 60.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "Mirror M2 (Pump fold at [122,75])", "group": null, "part_number": "BB05-E03", "beam": "ECDL.t.t", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PM", "type": "sampler", "label": "Partial Mirror (10% to FPC, 90% pump, at [310,75])", "group": null, "part_number": "BSF05-B", "beam": "ECDL.t.t", "distance_mm": 188.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M3", "type": "mirror", "label": "Mirror M3 (FPC fold at [310,33])", "group": null, "part_number": "BB05-E03", "beam": "ECDL.t.t.r", "distance_mm": 42.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, 