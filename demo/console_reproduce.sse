data: {"type": "iteration", "agent_id": "synth-1", "seq": 1, "label": "synthesized design 1", "design": {"name": "rb_sas_1inch_mounted", "description": "Rubidium D2 (780 nm) saturated-absorption spectroscopy setup using 1-inch mounted optics. An input laser beam passes through HWP1 and PBS1 to pick off a spectroscopy branch (V-polarized) while transmitting the main beam. Mirror M1 directs the branch downward into a 10:90 beam sampler (BS). The 10% reflected probe beam is rotated to H polarization by HWP2, folded by mirrors M2 and M3, and sent left through the 75 mm Rb vapor cell and PBS2 onto photodiode PD. The 90% transmitted V-polarized pump beam is folded by M4, passes through optional waveplate HWP3, reflects upward at M5 into PBS2, and is reflected right by PBS2 to counter-propagate with the probe inside the Rb cell before exiting through M3/M2/HWP2/BS to a beam dump.", "modules": [], "baseplate": {"width_mm": 485.0, "height_mm": 225.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "IN", "label": "Input 780 nm beam", "group": null, "part_number": "Toptica DL pro 780", "position": [445.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 780.24, "power_mw": 20.0, "waist_mm": 1.0, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2 (branch pickoff ratio Notice: ~25% branch, 75% main Pass-through) ", "group": null, "part_number": "WPH10M-780", "beam": "IN", "distance_mm": 83.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.4, "focal_length_mm": null, "fast_axis_deg": 15.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS (branch pickoff Notice: transmits H up, reflects V left) ", "group": null, "part_number": "PBS252", "beam": "IN", "distance_mm": 54.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": 25.4, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_MAIN", "type": "beam_dump", "label": "Main transmitted beam dump", "group": null, "part_number": "LB1", "beam": "IN.t", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "Branch fold mirror M1", "group": null, "part_number": "BB1-E03", "beam": "IN.r", "distance_mm": 90.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": 25.4, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BS", "type": "sampler", "label": "Beam sampler (10% probe, 90% pump) ", "group": null, "part_number": "BSF10-B", "beam": "IN.r", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": 25.4, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "