"type": "beam_dump", "label": "Counter-propagating pump dump (reflected at BS) ", "group": null, "part_number": "LB1", "beam": null, "distance_mm": null, "at": [355.0, 85.0], "angle_deg": -90.0, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD", "kind": "min_power_mw", "value": 0.15}], "notes": "1-inch mounted Rb saturated-absorption spectroscopy setup. HWP1 at 15 deg sends 25% (5 mW) V-polarized light into the spectroscopy branch via PBS1. Beam sampler BS reflects 10% (0.5 mW) as the probe, which is rotated to H by HWP2, folded by M2/M3, passes through the Rb cell (60% transmission -> 0.3 mW) and transmits through PBS2 onto photodiode PD. The 90% (4.5 mW) V-polarized pump transmits through BS, folds via M4, HWP3 (0 deg, keeping V) and M5, and enters PBS2 from below to reflect right and counter-propagate against the probe in the Rb cell. After traversing M3, M2, and HWP2 (becoming H), the spent pump hits BS from the left and is terminated by BD_PUMP1 and BD_PUMP2.", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "IN", "source_id": "IN", "start": [445.0, 30.0], "end": [445.0, 113.0], "direction_deg": 90.0, "length_mm": 83.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 4026.4439833766446, "w0_mm": 1.0, "w_start_mm": 1.0, "w_end_mm": 1.0002124402176822, "start_element": "IN", "end_element": "HWP1", "end_reason": "element"}, {"id": "s1", "branch": "IN", "source_id": "IN", "start": [445.0, 113.0], "end": [445.0, 167.0], "direction_deg": 90.0, "length_mm": 54.0, "wavelength_nm":