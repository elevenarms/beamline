insulating mount", "group": null, "part_number": "GC25075-RB", "beam": "IN.r.r", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.65, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS2", "type": "pbs", "label": "PBS (transmits H probe to PD, reflects V pump into cell)}{", "group": null, "part_number": "PBS252", "beam": "IN.r.r", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD", "type": "photodiode", "label": "PD (probe detector)}{", "group": null, "part_number": "PDA36A2", "beam": "IN.r.r.t", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M4", "type": "mirror", "label": "Pump fold mirror 1 (90%)", "group": null, "part_number": "BB1-E03", "beam": "IN.r.t", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP3", "type": "half_wave_plate", "label": "lambda/2 (pump alignment, kept at 0 deg to maintain V)}{", "group": null, "part_number": "WPH10M-780", "beam": "IN.r.t", "distance_mm": 150.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 0.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M5", "type": "mirror", "label": "Pump fold mirror 2", "group": null, "part_number": "BB1-E03", "beam": "IN.r.t", "distance_mm": 105.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_pump_t", "type": "beam_dump", "label": "Counter-propagating pump dump (90% transmitted through BS)}{", "group": null, "part_number": "LB1", "beam": "IN.r.t.r.t", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_pump_r_out", "type": "beam_dump", "label": "Counter-propagating pump dump (10% reflected by BS via M1 and PBS1)}{", "group": null, "part_number": "LB1", "beam": "IN.r.t.r.r.r", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD", "kind": "min_power_mw", "value": 0.15}], "notes": "Snap geometry: IN at (435,30) dir 90 -> HWP1 at (435,110) -> PBS1 at (435,165). Reflected branch (V, 5 mW) goes left (180 deg) to M1 at (350,165), down (-90 deg) to BS at (350,125). Probe (10% R = 0.5 mW) goes left (180 deg) through HWP2 at (300,125) [fast_axis=45 deg rotates V->H] to M2 at (260,125), down to M3 at (260,90), left through CELL at (175,90) [T=0.65 -> 0.325 mW] and PBS2 at (95,90) to PD at (40,90). Pump (90% T = 4.5 mW, V) goes down to M4 at (350,45), left through HWP3 at (200,45) to M5 at (95,45), up to PBS2 at (95,90), where V reflects right (0 deg) through CELL, M3, M2, HWP2 (V->H), and BS to dumps BD_pump_t (90% T at (395,125)) and BD_pump_r_out (10% R via M1 and PBS1 at (470,165)).", "logic": null}, "report": {"passed": false, "score": 65.0, "checks": [{"id": "collision", "severity": "warning", "message": "M2 and M3 footprints overlap (35.0 mm apart)", "element_id": "M2", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "PBS1 receives no light", "element_id": "PBS1", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "BD_main receives no light", "element_id": "BD_main", "segment_id": null, "value": null, "limi