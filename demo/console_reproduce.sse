data: {"type": "candidate", "index": 0, "stage": "design", "design": {"name": "rb_sas_1inch_mounted", "description": "Saturated absorption spectroscopy (SAS) setup for Rb D2 (780 nm) using 1-inch mounted optics. Input beam passes through a half-wave plate (HWP1) and polarizing beamsplitter (PBS1), picking off a spectroscopy branch. A beam sampler (BS) divides the branch into a 10% reflected probe arm (rotated to H by HWP2, steered via M2 and M3 through the Rb vapor cell and PBS2 onto photodiode PD) and a 90% transmitted pump arm (steered via M4, HWP3, and M5 to PBS2, which reflects the V-polarized pump counter-propagating through the Rb cell). Unused pass-through and counter-propagating pump beams are caught by beam dumps.", "modules": [], "baseplate": {"width_mm": 485.0, "height_mm": 185.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "IN", "label": "Input 780 nm laser", "group": null, "part_number": "Toptica DL pro 780", "position": [443.0, 25.0], "direction_deg": 90.0, "wavelength_nm": 780.24, "power_mw": 20.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2 (branch pickoff ratio control) [IN]", "group": null, "part_number": "WPH10M-780", "beam": "IN", "distance_mm": 70.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 15.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS (branch pickoff) [IN]", "group": null, "part_number": "PBS252", "beam": "IN", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_main", "type": "beam_dump", "label": "Main transmitted beam dump [IN.t]", "group": null, "part_number": "LB1", "beam": "IN.t", "distance_mm": 28.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "mirror (branch fold) [IN.r]", "group": null, "part_number": "BB1-E03", "beam": "IN.r", "distance_mm": 90.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BS", "type": "sampler", "label": "beam sampler (10% R / 90% T) [IN.r]", "group": null, "part_number": "BSF10-B", "beam": "IN.r", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP2", "type": "half_wave_plate", "label": "lambda/2 (probe V to H) [IN.r.r]", "group": null, "part_number": "WPH10M-780", "beam": "IN.r.r", "distance_mm": 56.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "mirror (probe dogleg 1) [IN.r.r]", "group": null, "part_number": "BB1-E03", "beam": "IN.r.r", "distance_mm": 42.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M3", "type": "mirror", "label": "mirror (probe dogleg 2) [IN.r.r]", "group": null, "part_number": "BB1-E03", "beam": "IN.r.r", "distance_mm": 39.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "CELL", "type": "vapor_cell", "label": "Rb cell / insulating mount [IN.r.r]", "group": null, "part_number": "GC25075-RB", "beam": "IN.r.r", "distance_mm": 82.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.6, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS2", "type": "pbs", "label": "PBS (pump injection / probe pass) [IN.r.r]", "group": null, "part_number": "PBS252", "beam": "IN.r.r", "distance_mm": 81.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD", "type": "photodiode", "label": "PD (probe detector) [IN.r.r.t]", "group": null, "part_number": "PDA36A2", "beam": "IN.r.r.t", "distance_mm": 59.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M4", "type": "mirror", "label": "mirror (pump fold 1) [IN.r.t]", "group": null, "part_number": "BB1-E03", "beam": "IN.r.t", "distance_mm": 89.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP3", "type": "half_wave_plate", "label": "lambda/2 (pump optional) [IN.r.t]", "group": null, "part_number": "WPH10M-780", "beam": "IN.r.t", "distance_mm": 117.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 0.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M5", "type": "mirror", "label": "mirror (pump fold 2) [IN.r.t]", "group": null, "part_number": "BB1-E03", "beam": "IN.r.t", "distance_mm": 144.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_pump", "type": "beam_dump", "label": "Counter-propagating pump dump [IN.r.t.r]", "group": null, "part_number": "LB1", "beam": null, "distance_mm": null, "at": [295.0, 86.0], "angle_deg": 0.0, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD", "kind": "min_power_mw", "value": 0.15}], "notes": "1-inch mounted Rb saturated absorption spectroscopy layout. HWP1 at 15 deg sends ~25% (5 mW) V-polarized light into the spectroscopy branch via PBS1. BS reflects 10% (0.5 mW) into the probe arm and transmits 90% (4.5 mW) into the pump arm. HWP2 at 45 deg rotates the probe polarization from V to H so that it transmits through CELL (60% transmission -> 0.3 mW) and PBS2 onto PD. The V-polarized pump reflects at M4, passes through optional HWP3 (fast axis 0 deg, keeping V), reflects at M5 (+y), and reflects at PBS2 (+x) to counter-propagate through CELL overlap with the probe, terminating in BD_pump after M3.", "logic": null}, "report": {"passed": true, "score": 96.2, "checks": [{"id": "no_light", "severity": "info", "message": "BD_pump receives no light", "element_id": "BD_pump", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "info", "message": "met: PD: 4.800 mW (need \u2265 0.150)", "element_id": "PD", "segment_id": null, "value": 4.799999999999999, "limit": 0.15}], "metrics": {"input_mw": 20.0, "delivered_mw": 4.799999999999999, "dumped_mw": 15.000000000000002, "stray_mw": 0.0, "n_elements": 15.0, "n_segments": 16.0, "target.PD.min_power_mw": 4.799999999999999, "delivered_fraction": 0.23999999999999994}}, "trace": {"segments": [{"id": "s0", "branch": "IN", "source_id": "IN", "start": [443.0, 25.0], "end": [443.0, 95.0], "direction_deg": 90.0, "length_mm": 70.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 2576.924149361053, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8002951023765144, "start_element": "IN", "end_element": "HWP1", "end_reason": "element"}, {"id": "s1", "branch": "IN", "source_id": "IN", "start": [443.0, 95.0], "end": [443.0, 150.0], "direction_deg": 90.0, "length_mm": 54.99999999999999, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[0.8660254037844387, 0.0], [0.49999999999999994, -3.5352507957496895e-17]], "polarization_label": "linea