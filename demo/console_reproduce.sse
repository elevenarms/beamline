data: {"type": "iteration", "agent_id": "synth-2", "seq": 2, "label": "synthesized design 2", "design": {"name": "rb_sas_1inch_mounted", "description": "Rubidium D2 (780 nm) saturated-absorption spectroscopy branch using 1-inch mounted optics. A half-wave plate (HWP1) and polarizing beamsplitter (PBS1) pick off a V-polarized branch toward mirror M1, while the transmitted main beam goes to a dump/downstream setup. A beam sampler (BS) splits the branch into a 10% reflected probe and a 90% transmitted pump. The probe polarization is rotated from V to H by HWP2, folded by M2 and M3 through the Rb vapor cell (CELL) and PBS2 onto photodiode PD. The 90% V-polarized pump is routed via M4, optional HWP3, and M5 into PBS2, which reflects it counter-propagating through the Rb cell; after the cell, M3, M2, HWP2 (rotating V to H) and BS, the pump exits and is caught by beam dumps.", "modules": [], "baseplate": {"width_mm": 485.0, "height_mm": 220.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "IN", "label": "780 nm Rb laser input", "group": null, "part_number": "Toptica DL pro 780", "position": [445.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 780.24, "power_mw": 20.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2 (branch pickoff control, 22.5 deg -> 50% branch, or 15 deg -> 25%)", "group": null, "part_number": "WPH10M-780", "beam": "IN", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 15.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS (pickoff branch to left, main beam straight up Technical/downstream)}{", "group": null, "part_number": "PBS252", "beam": "IN", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_main", "type": "beam_dump", "label": "Main transmitted beam dump (continues upward off-board in figure)}{", "group": null, "part_number": "LB1", "beam": "IN.t", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "Branch fold mirror", "group": null, "part_number": "BB1-E03", "beam": "IN.r", "distance_mm": 95.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BS", "type": "sampler", "label": "Beam sampler (10% R probe, 90% T pump)}{", "group": null, "part_number": "BSF10-B", "beam": "IN.r", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_ax