data: {"type": "iteration", "agent_id": "repair-1", "seq": 3, "label": "repair 1", "design": {"name": "rb_sas_1inch_mounted", "description": "Rubidium D2 (780 nm) saturated-absorption spectroscopy branch using 1-inch mounted optics. A half-wave plate (HWP1) and polarizing beamsplitter (PBS1) pick off a V-polarized branch toward mirror M1, while the transmitted main beam goes to a dump/downstream setup. A beam sampler (BS) splits the branch into a 10% reflected probe and a 90% transmitted pump. The probe polarization is rotated from V to H by HWP2, folded by M2 and M3 through the Rb vapor cell (CELL) and PBS2 onto photodiode PD. The 90% V-polarized pump is routed via M4, HWP3, and M5 into PBS2, which reflects it counter-propagating through the Rb cell; after the cell, M3, M2, HWP2 and BS, the returning pump is caught by beam dumps.", "modules": [], "baseplate": {"width_mm": 485.0, "height_mm": 220.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "IN", "label": "780 nm Rb laser input", "group": null, "part_number": "Toptica DL pro 780", "position": [435.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 780.24, "power_mw": 20.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2 (branch pickoff control, 15 deg -> 25%)", "group": null, "part_number": "WPH10M-780", "beam": "IN", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 15.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS (pickoff branch to left, main beam straight up/downstream_setup_dump)}{", "group": null, "part_number": "PBS252", "beam": "IN", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_main", "type": "beam_dump", "label": "Main transmitted beam dump (continues upward off-board in figure)}{", "group": null, "part_number": "LB1", "beam": "IN.t", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "Branch fold mirror", "group": null, "part_number": "BB1-E03", "beam": "IN.r", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BS", "type": "sampler", "label": "Beam sampler (10% R probe, 90% T pump)}{", "group": null, "part_number": "BSF10-B", "beam": "IN.r", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP2", "type": "half_wave_plate", "label": "lambda/2 (rotates V probe to H)}{", "group": null, "part_number": "WPH10M-780", "beam": "IN.r.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "Probe fold mirror 1", "group": null, "part_number": "BB1-E03", "beam": "IN.r.r", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M3", "type": "mirror", "label": "Probe fold mirror 2", "group": null, "part_number": "BB1-E03", "beam": "IN.r.r", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "CELL", "type": "vapor_cell", "label": "Rb cell in insulating mount", "group": null, "part_number": "GC25075-RB", "beam": "IN.r.r", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.65, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS2", "type": "pbs", "label": "PBS (transmits H probe to PD, reflects V pump into cell)}{", "group": null, "part_number": "PBS252", "beam": "IN.r.r", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD", "type": "photodiode", "label": "PD (probe detector)}{", "group": null, "part_number": "PDA36A2", "beam": "IN.r.r.t", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M4", "type": "mirror", "label": "Pump fold mirror 1 (90%)", "group": null, "part_number": "BB1-E03", "beam": "IN.r.t", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP3", "type": "half_wave_plate", "label": "lambda/2 (pump alignment, kept at 0 deg to maintain V)}{", "group": null, "part_number": "WPH10M-780", "beam": "IN.r.t", "distance_mm": 150.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 0.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M5", "type": "mirror", "label": "Pump fold mirror 2", "group": null, "part_number": "BB1-E03", "beam": "IN.r.t", "distance_mm": 105.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_pump_t", "type": "beam_dump", "label": "Counter-propagating pump dump (90% transmitted through BS)}{", "group": null, "part_number": "LB1", "beam": "IN.r.t.r.t", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_pump_r_out", "type": "beam_dump", "label": "Counter-propagating pump dump (10% reflected by BS via M1 and PBS1)}{", "group": null, "part_number": "LB1", "beam": "IN.r.t.r.r.r", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD", "kind": "min_power_mw", "value": 0.15}], "notes": "Snap geometry: IN at (435,30) dir 90 -> HWP1 at (435,110) -> PBS1 at (435,165). Reflected branch (V, 5 mW) goes left (180 deg) to M1 at (350,165), down (-90 deg) to BS at (350,125). Probe (10% R = 0.5 mW) goes left (180 deg) through HWP2 at (300,125) [fast_axis=45 deg rotates V->H] to M2 at (260,125), down to M3 at (260,90), left through CELL at (175,90) [T=0.65 -> 0.325 mW] and PBS2 at (95,90) to PD at (40,90). Pump (90% T = 4.5 mW, V) goes down to M4 at (350,45), left through HWP3 at (200,45) to M5 at (95,45), up to PBS2 at (95,90), where V reflects right (0 deg) through CELL, M3, M2, HWP2 (V->H), and BS to dumps BD_pump_t (90% T at (395,125)) and BD_pump_r_out (10% R via M1 and PBS1 at (470,165)).", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "IN", "source_id": "IN", "start": [435.0, 30.0], "end": [435.0, 110.0], "direction_deg": 90.0, "length_mm": 80.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 2576.924149361053, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8003854180869068, "start_element": "IN", "end_element": "HWP1", "end_reason": "element"}, {"id": "s1", "branch": "IN", "source_id": "IN", "start": [435.0, 110.0], "end": [435.0, 130.00000000000006], "direction_deg": 90.0, "length_mm": 20.000000000000057, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[0.8660254037844387, 0.0], [0.49999999999999994, -3.5352507957496895e-17]], "polarization_label": "linear 30\u00b0", "waist_z_mm": -80.0, "rayleigh_mm": 2576.924149361053, "w0_mm": 0.8, "w_start_mm": 0.8003854180869068, "w_end_mm": 0.8006021342228069, "start_element": "HWP1", "end_element": "BD_pump_r_out", "end_reason": "absorbed"}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "placed": true, "position": [435.0, 110.0], "angle_deg": 90.0, "hits": [{"segment_id": "s0", "power_in_mw": 20.0, "w_mm": 0.8003854180869068, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "PBS1", "type": "pbs", "placed": true, "position": [435.0, 165.0], "angle_deg": 90.0, "hits": [], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "BD_main", "type": "beam_dump", "placed": true, "position": [435.0, 205.0], "angle_deg": 90.0, "hits": [], "coupling_efficiency": null, "power_out_mw": 0.0, "error": null}, {"id": "M1", "type": "mirror", "placed": true, "position": [350.0, 165.00000000000003], "angle_deg": -45.0, "hits": [], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "BS", "type": "sampler", "placed": true, "position": [350.0, 125.00000000000003], "angle_deg": 1.4210854715202004e-14, "hits": [], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "HWP2", "type": "half_wave_plate", "placed": true, "position": [300.0, 125.00000000000004], "angle_deg": 180.0, "hits": [], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "M2", "type": "mirror", "placed": true, "position": [260.0, 125.00000000000006], "angle_deg": -45.00000000000001, "hits": [], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "M3", "type": "mirror", "placed": true, "position": [260.0, 90.00000000000006], "angle_deg": 135.0, "hits": [], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "CELL", "type": "vapor_cell", "placed": true, "position": [175.0, 90.00000000000007], "angle_deg": 180.0, "hits": [], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "PBS2", "type": "pbs", "placed": true, "position": [95.0, 90.00000000000009], "angle_deg": 180.0, "hits": [], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "PD", "type": "photodiode", "placed": true, "position": [40.0, 90.0000000000001], "angle_deg": 180.0, "hits": [], "coupling_efficiency": null, "power_out_mw": 0.0, "error": null}, {"id": "M4", "type": "mirror", "placed": true, "position": [350.0, 45.00000000000003], "angle_deg": 135.0, "hits": [], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "HWP3", "type": "half_wave_plate", "placed": true, "position": [200.0, 45.000000000000064], "angle_deg": 180.0, "hits": [], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "M5", "type": "mirror", "placed": true, "position": [95.0, 45.000000000000085], "angle_deg": 44.99999999999999, "hits": [], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "BD_pump_t", "type": "beam_dump", "placed": true, "position": [395.0, 125.00000000000001], "angle_deg": -1.2722218725854067e-14, "hits": [], "coupling_efficiency": null, "power_out_mw": 0.0, "error": null}, {"id": "BD_pump_r_out", "type": "beam_dump", "placed": true, "position": [434.99999999999994, 130.00000000000006], "angle_deg": -90.00000000000004, "hits": [{"segment_id": "s1", "power_in_mw": 20.0, "w_mm": 0.8006021342228069, "clip_loss": 0.0, "offset_mm": 5.684341886080802e-14}], "coupling_efficiency": null, "power_out_mw": 20.0, "error": null}], "branches": ["IN"], "nonconverged": []}, "report": {"passed": false, "score": 65.0, "checks": [{"id": "collision", "severity": "warning", "message": "M2 and M3 footprints overlap (35.0 mm apart)", "element_id": "M2", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "PBS1 receives no light", "element_id": "PBS1", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "BD_main receives no light", "element_id": "BD_main", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "M1 receives no light", "element_id": "M1", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "BS receives no light", "element_id": "BS", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "HWP2 receives no light", "element_id": "HWP2", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "M2 receives no light", "element_id": "M2", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "M3 receives no light", "element_id": "M3", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "CELL receives no light", "element_id": "CELL", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "PBS2 receives no light", "element_id": "PBS2", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "PD receives no light", "element_id": "PD", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "M4 receives no light", "element_id": "M4", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "HWP3 receives no light", "element_id": "HWP3", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "M5 receives no light", "element_id": "M5", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "BD_pump_t receives no light", "element_id": "BD_pump_t", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "error", "message": "unmet: PD: 0.000 mW (need \u2265 0.150)", "element_id": "PD", "segment_id": null, "value": 0.0, "limit": 0.15}], "metrics": {"input_mw": 20.0, "delivered_mw": 0.0, "dumped_mw": 20.0, "stray_mw": 0.0, "n_elements": 16.0, "n_segments": 2.0, "target.PD.min_power_mw": 0.0, "delivered_fraction": 0.0}}, "parent_seq": 2, "diff": [{"op": "move", "element_id": "M1", "field": "distance_mm", "from": 95.0, "to": 85.0, "note": "distance_mm: 95 \u2192 85 \u2014 Reduced distance_mm from 95 to 85 mm to keep M1 at x=350 mm after shifting IN to x=435 mm."}, {"op": "move", "element_id": "BS", "field": "distance_mm", "from": 35.0, "to": 40.0, "note": "distance_mm: 35 \u2192 40 \u2014 Set distance_mm to 40 mm (y=125 mm) to give >= 40 mm separation from M1."}, {"op": "move", "element_id": "M3", "field": "distance_mm", "from": 40.0, "to": 35.0, "note": "distance_mm: 40 \u2192 35 \u2014 Adjusted distance_mm to 35 mm so the probe row stays at y=90 mm."}, {"op": "move", "element_id": "M4", "field": "distance_mm", "from": 85.0, "to": 80.0, "note": "distance_mm: 85 \u2192 80 \u2014 Adjusted distance_mm to 80 mm so the pump row stays at y=45 mm."}, {"op": "move", "element_id": "HWP3", "field": "distance_mm", "from": 115.0, "to": 150.0, "note": "distance_mm: 115 \u2192 150 \u2014 Moved to distance_mm=150 mm (x=200 mm) so its mount does not collide with CELL or M3."}, {"op": "move", "element_id": "M5", "field": "distance_mm", "from": 140.0, "to": 105.0, "note": "distance_mm: 140 \u2192 105 \u2014 Adjusted distance_mm to 105 mm to keep M5 at x=95 mm aligned with PBS2."}, {"op": "move", "element_id": "BD_pump_t", "field": "distance_mm", "from": 55.0, "to": 45.0, "note": "distance_mm: 55 \u2192 45 \u2014 Reduced distance_mm to 45 mm (x=395, y=125) so the PBS1->M1 beam does not cross its mount."}, {"op": "add", "element_id": "BD_pump_r_out", "field": null, "from": null, "to": null, "note": "added beam_dump on IN.r.t.r.r.r at 35 mm"}, {"op": "remove", "element_id": "BD_pump_r", "field": null, "from": null, "to": null, "note": "removed beam_dump \u2014 Replaced unplaced BD_pump_r on IN.r.t.r.r with BD_pump_r_out on IN.r.t.r.r.r (35 mm right of PBS1) where the 10% BS-reflected return pump actually exits PBS1."}], "rationale": "BD_pump_r was left unplaced on branch IN.r.t.r.r (because BS reflects a +x beam to +90 deg, which retraces into M1 and PBS1 rather than going down, so IN.r.t.r.r was absorbed at PBS1 before BD_pump_r could be placed, dropping an error blocker on PBS1-M1 that blocked all light) and the counter-propagating pump escaping PBS1's right port was unterminated; I removed BD_pump_r, shifted the input column left to x=435 so BD_pump_r_out fits on the board at (470,165) to catch the 10% BS-reflected pump after it reflects off M1 and PBS1, and nudged BS/HWP3/BD_pump_t to clear mount footprints."}

data: {"type": "agent", "agent_id": "repair-1", "role": "repair", "state": "done", "title": "Repair 1 \u2014 fix 1 error", "parent": "synth-2", "model": "gemini-4-argon", "thinking_level": "low", "elapsed_ms": 22923.0, "message": null}

data: {"type": "candidate", "index": 1, "stage": "repair", "round": 1, "design": {"name": "rb_sas_1inch_mounted", "description": "Rubidium D2 (780 nm) saturated-absorption spectroscopy branch using 1-inch mounted optics. A half-wave plate (HWP1) and polarizing beamsplitter (PBS1) pick off a V-polarized branch toward mirror M1, while the transmitted main beam goes to a dump/downstream setup. A beam sampler (BS) splits the branch into a 10% reflected probe and a 90% transmitted pump. The probe polarization is rotated from V to H by HWP2, folded by M2 and M3 through the Rb vapor cell (CELL) and PBS2 onto photodiode PD. The 90% V-polarized pump is routed via M4, HWP3, and M5 into PBS2, which reflects it counter-propagating through the Rb cell; after the cell, M3, M2, HWP2 and BS, the returning pump is caught by beam dumps.", "modules": [], "baseplate": {"width_mm": 485.0, "height_mm": 220.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "IN", "label": "780 nm Rb laser input", "group": null, "part_number": "Toptica DL pro 780", "position": [435.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 780.24, "power_mw": 20.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2 (branch pickoff control, 15 deg -> 25%)", "group": null, "part_number": "WPH10M-780", "beam": "IN", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 15.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS (pickoff branch to left, main beam straight up/downstream_setup_dump)}{", "group": null, "