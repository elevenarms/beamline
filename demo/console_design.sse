ower_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "QWP1", "type": "quarter_wave_plate", "label": "Cat-eye lambda/4 (45 deg)", "group": "aom_doublepass_160mhz", "part_number": "WPQ05M-780", "beam": "L1.t.t.+1", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_AOM0", "type": "beam_dump", "label": "Forward 0th-order razor block", "group": "aom_doublepass_160mhz", "part_number": "LB1", "beam": null, "distance_mm": null, "at": [222.0, 100.371], "angle_deg": 180.8515, "out_direction_deg": null, "aperture_mm": 1.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_RETRO", "type": "mirror", "label": "Cat-eye retro mirror", "group": "aom_doublepass_160mhz", "part_number": "BB05-E03", "beam": "L1.t.t.+1", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": 0.8515, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_OUT1", "type": "mirror", "label": "Output steering mirror", "group": "power_monitor_and_fiber_out", "part_number": "BB05-E03", "beam": "L1.t.t.+1.+1.r", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_GHOST", "type": "beam_dump", "label": "Return 0th-order ghost block", "group": "aom_doublepass_160mhz", "part_number": "LB1", "beam": "L1.t.t.+1.0.r", "distance_mm": 38.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 1.2, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S_MON", "type": "sampler", "label": "5% power monitor sampler", "group": "power_monitor_and_fiber_out", "part_number": "BSF05-B", "beam": "L1.t.t.+1.+1.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_MON", "type": "photodiode", "label": "Power monitor photodiode", "group": "power_monitor_and_fiber_out", "part_number": "PDA36A2", "beam": "L1.t.t.+1.+1.r.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC1", "type": "fiber_coupler", "label": "Output fiber coupler (PM780-HP)", "group": "power_monitor_and_fiber_out", "part_number": "PAF2-A4B", "beam": "L1.t.t.+1.+1.r.t", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 4.6, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.3, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_auto1", "type": "beam_dump", "label": "auto dump (2.94 mW)", "group": "laser_source_and_isolation", "part_number": null, "beam": "L1.t.t.0.+1.r.t", "distance_mm": 72.7, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "FC1", "kind": "min_power_mw", "value": 8.0}, {"element_id": "FC1", "kind": "min_coupling", "value": 0.65}, {"element_id": "FC1", "kind": "polarization", "value": "V"}, {"element_id": "PD_MON", "kind": "min_power_mw", "value": 0.35}, {"element_id": "PD_SAS", "kind": "min_power_mw", "value": 0.08}], "notes": "Compact Folded U-Turn Layout: Top rail carries 780.24 nm ECDL through isolator ISO1 and HWP1+PBS_SPLIT. ~10% (2.7 mW) is reflected down into S_SAS to form the SAS probe (transmitted through HWP_SAS, PBS_SAS1, CELL1, PBS_SAS2 to PD_SAS) and counter-propagating V-polarized pump (routed via M_PUMP1, M_PUMP2 into PBS_SAS2, counter-propagating through CELL1, and reflected upward by PBS_SAS1 into BD_PUMP). The main H-polarized beam (24.3 mW) folds via M_U1 and M_U2 onto the y=100 mm lower rail (-x) through PBS_AOM and AOM1 in a cat-eye double-pass (f=75 mm LENS1, QWP1, M_RETRO). Forward 0th order is caught at BD_AOM0; return +1.0 ghost order is caught at BD_GHOST; the +160 MHz V-polarized beam reflects down at PBS_AOM, turns right at M_OUT1, picks off 5% at S_MON into PD_MON (~0.88 mW), and couples ~13.9 mW (83.2% coupling efficiency) into FC1.", "logic": null}, "report": {"passed": true, "score": 83.11163330487051, "checks": [{"id": "collision", "severity": "warning", "message": "QWP1 and BD_AOM0 footprints overlap (3.7 mm apart)", "element_id": "QWP1", "segment_id": null, "value": null, "limit": null}, {"id": "collision", "severity": "warning", "message": "FC1 and BD_auto1 footprints overlap (6.3 mm apart)", "element_id": "FC1", "segment_id": null, "value": null, "limit": null}, {"id": "beam_through_mount", "severity": "warning", "message": "beam L1.t.t.0.+1.r.t passes through FC1's mount without interacting", "element_id": "FC1", "segment_id": "s21", "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "BD_PUMP receives no light", "element_id": "BD_PUMP", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "BD_AOM0 receives no light", "element_id": "BD_AOM0", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "info", "message": "met: FC1: 15.013 mW (need \u2265 8.000)", "element_id": "FC1", "segment_id": null, "value": 15.01331098262594, "limit": 8.0}, {"id": "target", "severity": "info", "message": "met: FC1: coupling 87.3% (need \u2265 65.0%)", "element_id": "FC1", "segment_id": null, "value": 0.872598570750415, "lim