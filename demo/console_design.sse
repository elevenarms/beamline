data: {"type": "candidate", "index": 1, "stage": "design", "design": {"name": "rb_sas_aom_doublepass_orthogonal", "description": "Rb-87 780.24 nm laser system using the Orthogonal L-Branch Layout: an ECDL source passes an optical isolator and HWP+PBS to pick off ~10% vertically into the upper-right quadrant for Doppler-free Rb saturated absorption spectroscopy (PD_SAS), while the main beam continues horizontally along the bottom edge into a cat-eye +160 MHz double-pass AOM. The return V-polarized +160 MHz beam is extracted upward (+y) through a 5% power-monitoring sampler (PD_MON) and coupled into an output PM fiber (FC1).", "modules": [{"id": "laser_source_and_isolation", "title": "Laser Source & Isolation", "region": [10.0, 20.0, 175.0, 95.0], "description": "780.24 nm ECDL input, optical isolator, and SAS pickoff HWP + PBS."}, {"id": "aom_doublepass_160mhz", "title": "+160 MHz Double-Pass AOM", "region": [190.0, 10.0, 340.0, 110.0], "description": "Horizontal bottom-edge cat-eye double-pass 80 MHz AOM (+1 order) with QWP polarization flip and 0th-order/ghost blocks."}, {"id": "power_monitor_and_fiber_out", "title": "5% Monitor & Fiber Output", "region": [190.0, 120.0, 105.0, 165.0], "description": "Vertical (+y) extraction branch with 5% sampler to PD_MON and mode-matched coupling into FC1."}, {"id": "rb_sas_locking", "title": "Rb Saturated Absorption Spectroscopy", "region": [140.0, 130.0, 395.0, 160.0], "description": "Upper-right quadrant counter-propagating pump-probe Rb vapor cell spectroscopy loop onto PD_SAS."}], "baseplate": {"width_mm": 550.0, "height_mm": 300.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "780 nm ECDL (Toptica DL pro)", "group": "laser_source_and_isolation", "part_number": "Toptica DL pro 780", "position": [25.0, 60.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 30.0, "waist_mm": 0.43, "waist_offset_mm": 200.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO1", "type": "isolator", "label": "Optical isolator (780 nm)", "group": "laser_source_and_isolation", "part_number": "IO-3D-780-VLP", "beam": "L1", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.9, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP1", "type": "half_wave_plate", "label": "SAS pickoff lambda/2 (~10% V)", "group": "laser_source_and_isolation", "part_number": "WPH05M-780", "beam": "L1", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 9.2, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "SAS pickoff PBS", "group": "laser_source_and_isolation", "part_number": "PBS052", "beam": "L1", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS2", "type": "pbs", "label": "Double-pass extraction PBS", "group": "aom_doublepass_160mhz", "part_number": "PBS052", "beam": "L1.t", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "a