ge": "met: PD_MON: 0.778 mW (need \u2265 0.350)", "element_id": "PD_MON", "segment_id": null, "value": 0.777884738620711, "limit": 0.35}, {"id": "target", "severity": "info", "message": "met: PD_SAS: 0.161 mW (need \u2265 0.080)", "element_id": "PD_SAS", "segment_id": null, "value": 0.16140758953152592, "limit": 0.08}], "metrics": {"input_mw": 30.0, "delivered_mw": 14.905030005830762, "dumped_mw": 10.203969157032226, "stray_mw": 0.0, "n_elements": 24.0, "n_segments": 33.0, "target.FC1.min_power_mw": 13.965737677678526, "target.FC1.min_coupling": 0.9449199716198223, "target.FC1.polarization": 1.0, "target.PD_MON.min_power_mw": 0.777884738620711, "target.PD_SAS.min_power_mw": 0.16140758953152592, "delivered_fraction": 0.4968343335276921}}, "parent_seq": 4, "diff": [{"op": "retarget", "element_id": "BD_PUMP", "field": "beam", "from": null, "to": "L1.r.t.r.r", "note": "beam: None \u2192 L1.r.t.r.r \u2014 Placed directly on branch L1.r.t.r.r (distance 25 mm) to catch the rejected SAS pump beam instead of sitting unused at (240, 165)."}, {"op": "move", "element_id": "BD_PUMP", "field": "distance_mm", "from": null, "to": 25.0, "note": "distance_mm: None \u2192 25 \u2014 Placed directly on branch L1.r.t.r.r (distance 25 mm) to catch the rejected SAS pump beam instead of sitting unused at (240, 165)."}, {"op": "move", "element_id": "BD_PUMP", "field": "at", "from": [240.0, 165.0], "to": null, "note": "at: (240, 165) \u2192 None \u2014 Placed directly on branch L1.r.t.r.r (distance 25 mm) to catch the rejected SAS pump beam instead of sitting unused at (240, 165)."}, {"op": "rotate", "element_id": "BD_PUMP", "field": "angle_deg", "from": -90.0, "to": null, "note": "angle_deg: -90 \u2192 None \u2014 Placed directly on branch L1.r.t.r.r (distance 25 mm) to catch the rejected SAS pump beam instead of sitting unused at (240, 165)."}, {"op": "move", "element_id": "BD_AOM0", "field": "at", "from": [430.006, 55.297], "to": [435.0, 55.904], "note": "at: (430.006, 55.297) \u2192 (435, 55.904) \u2014 Repositioned from (430.006, 55.297) to (435.0, 55.904) along the focused L1.t.t.0 path after QWP1 so it blocks the forward 0th-order beam before M_RETRO and prevents the return ghost from crossing FC1's mount."}, {"op": "remove", "element_id": "BD_auto1", "field": null, "from": null, "to": null, "note": "removed beam_dump \u2014 Removed redundant auto-dump since L1.t.t.0 is now properly blocked by BD_AOM0."}, {"op": "remove", "element_id": "BD_auto2", "field": null, "from": null, "to": null, "note": "removed beam_dump \u2014 Removed redundant auto-dump now that BD_PUMP terminates L1.r.t.r.r."}], "rationale": "Moved the 0th-order razor block (BD_AOM0) onto the actual focused 0th-order beam path at (435.0, 55.904) so it absorbs the forward 0th-order beam before M_RETRO, eliminating the return L1.t.t.0.+1.r.t ghost that passed through FC1's mount, and cleaned up redundant unused dumps."}

