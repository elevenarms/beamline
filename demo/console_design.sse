element_id": "S_SAS", "field": null, "from": null, "to": null, "note": "added sampler on L1.r at 60 mm"}, {"op": "add", "element_id": "HWP_SAS", "field": null, "from": null, "to": null, "note": "added half_wave_plate on L1.r.r at 40 mm"}, {"op": "add", "element_id": "PBS_SAS1", "field": null, "from": null, "to": null, "note": "added pbs on L1.r.r at 40 mm"}, {"op": "add", "element_id": "CELL1", "field": null, "from": null, "to": null, "note": "added vapor_cell on L1.r.r.t at 80 mm"}, {"op": "add", "element_id": "PBS_SAS2", "field": null, "from": null, "to": null, "note": "added pbs on L1.r.r.t at 80 mm"}, {"op": "add", "element_id": "PD_SAS", "field": null, "from": null, "to": null, "note": "added photodiode on L1.r.r.t.t at 45 mm"}, {"op": "add", "element_id": "M_PUMP1", "field": null, "from": null, "to": null, "note": "added mirror on L1.r.t at 55 mm"}, {"op": "add", "element_id": "M_PUMP2", "field": null, "from": null, "to": null, "note": "added mirror on L1.r.t at 240 mm"}, {"op": "add", "element_id": "BD_PUMP", "field": null, "from": null, "to": null, "note": "added beam_dump at (270, 235)"}, {"op": "add", "element_id": "M_U1", "field": null, "from": null, "to": null, "note": "added mirror on L1.t at 310 mm"}, {"op": "add", "element_id": "M_U2", "field": null, "from": null, "to": null, "note": "added mirror on L1.t at 160 mm"}, {"op": "add", "element_id": "PBS_AOM", "field": null, "from": null, "to": null, "note": "added pbs on L1.t at 90 mm"}, {"op": "add", "element_id": "AOM1", "field": null, "from": null, "to": null, "note": "added aom on L1.t.t at 65 mm"}, {"op": "add", "element_id": "LENS1", "field": null, "from": null, "to": null, "note": "added lens on L1.t.t.+1 at 75 mm"}, {"op": "add", "element_id": "QWP1", "field": null, "from": null, "to": null, "note": "added quarter_wave_plate on L1.t.t.+1 at 45 mm"}, {"op": "add", "element_id": "BD_AOM0", "field": null, "from": null, "to": null, "note": "added beam_dump at (222, 100.371)"}, {"op": "add", "element_