ion": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "QWP1", "type": "quarter_wave_plate", "label": "Cat-eye lambda/4 (45 deg)", "group": "aom_doublepass_160mhz", "part_number": "WPQ05M-780", "beam": "L1.t.t.+1", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_AOM0", "type": "beam_dump", "label": "Forward 0th-order razor block", "group": "aom_doublepass_160mhz", "part_number": "LB1", "beam": null, "distance_mm": null, "at": [222.0, 100.371], "angle_deg": 180.8515, "out_direction_deg": null, "aperture_mm": 1.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_RETRO", "type": "mirror", "label": "Cat-eye retro mirror", "group": "aom_doublepass_160mhz", "part_number": "BB05-E03", "beam": "L1.t.t.+1", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": 0.8515, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_OUT1", "type": "mirror", "label": "Output steering mirror", "group": "power_monitor_and_fiber_out", "part_number": "BB05-E03", "beam": "L1.t.t.+1.+1.r", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_GHOST", "type": "beam_dump", "label": "Return 0th-order ghost block", "group": "aom_doublepass_160mhz", "part_number": "LB1", "beam": "L1.t.t.+1.0.r", "distance_mm": 38.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 1.2, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S_MON", "type": "sampler", "label": "5% power monitor sampler", "group": "power_monitor_and_fiber_out", "part_number": "BSF05-B", "beam": "L1.t.t.+1.+1.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_MON", "type": "photodiode", "label": "Power monitor photodiode", "group": "power_monitor_and_fiber_out", "part_number": "PDA36A2", "beam": "L1.t.t.+1.+1.r.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC1", "type": "fiber_coupler", "label": "Output fiber coupler (PM780-HP)", "group": "power_monitor_and_fiber_out", "part_number": "PAF2-A4B", "beam": "L1.t.t.+1.+1.r.t", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 4.6, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.3, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_auto1", "type": "beam_dump", "label": "auto dump (2.94 mW)", "group": "laser_source_and_isolation", "part_number": null, "beam": "L1.t.t.0.+1.r.t", "distance_mm": 72.7, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "FC1", "kind": "min_power_mw", "value": 8.0}, {"element_id": "FC1", "kind": "min_coupling", "value": 0.65}, {"element_id": "FC1", "kind": "polarization", "value": "V"}, {"element_id": "PD_MON", "kind": "min_power_mw", "value": 0.35}, {"element_id": "PD_SAS", "kind": "min_power_mw", "value": 0.08}], "notes": "Compact Folded U-Turn Layout: Top rail carries 780.24 nm ECDL through isolator ISO1 and HWP1+PBS_SPLIT. ~10% (2.7 mW) is reflected down into S_SAS to form the SAS probe (transmitted through HWP_SAS, PBS_SAS1, CELL1, PBS_SAS2 to PD_SAS) and counter-propagating V-polarized pump (routed via M_PUMP1, M_PUMP2 into PBS_SAS2, counter-propagating through CELL1, and reflected upward by PBS_SAS1 into BD_PUMP). The main H-polarized beam (24.3 mW) folds via M_U1 and M_U2 onto the y=100 mm lower rail (-x) through PBS_AOM and AOM1 in a cat-eye double-pass (f=75 mm LENS1, QWP1, M_RETRO). Forward 0th order is caught at BD_AOM0; return +1.0 ghost order is caught at BD_GHOST; the +160 MHz V-polarized beam reflects down at PBS_AOM, turns right at M_OUT1, picks off 5% at S_MON into PD_MON (~0.88 mW), and couples ~13.9 mW (83.2% coupling efficiency) into FC1.", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "L1", "source_id": "L1", "start": [40.0, 260.0], "end": [95.0, 260.0], "direction_deg": 0.0, "length_mm": 55.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 30.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 450.0, "rayleigh_mm": 744.4894925263416, "w0_mm": 0.43, "w_start_mm": 0.5024470357832577, "w_end_mm": 0.48677426782728983, "start_element": "L1", "end_element": "ISO1", "end_reason": "element"}, {"id": "s1", "branch": "L1", "source_id": "L1", "start": [95.0, 260.0], "end": [145.0, 260.0], "direction_deg": 0.0, "length_mm": 50.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 27.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 395.0, "rayleigh_mm": 744.4894925263416, "w0_mm": 0.43, "w_start_mm": 0.48677426782728983, "w_end_mm": 0.4739263299207602, "start_element": "ISO1", "end_element": "HWP1", "end_reason": "element"}, {"id": "s2", "branch": "L1", "source_id": "L1", "start": [145.0, 260.0], "end": [190.0, 260.0], "direction_deg": 0.0, "length_mm": 45.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 27.0, "jones": [[0.9488760116444965, 0.0], [0.3156490369471025, -2.036928840056085e-17]], "polar