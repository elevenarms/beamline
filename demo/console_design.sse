", "part_number": "GC25075-RB", "beam": "L1.r.r.t", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.65, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS_SAS2", "type": "pbs", "label": "Pump injection PBS", "group": "rb_sas_locking", "part_number": "PBS052", "beam": "L1.r.r.t", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_SAS", "type": "photodiode", "label": "SAS locking photodiode", "group": "rb_sas_locking", "part_number": "PDA36A2", "beam": "L1.r.r.t.t", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_PUMP", "type": "mirror", "label": "Pump steering mirror", "group": "rb_sas_locking", "part_number": "BB05-E03", "beam": "L1.r.t", "distance_mm": 175.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_PUMP", "type": "beam_dump", "label": "Spent pump dump", "group": "rb_sas_locking", "part_number": "LB1", "beam": null, "distance_mm": null, "at": [350.0, 215.0], "angle_deg": 90.0, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "FC1", "kind": "min_power_mw", "value": 8.0}, {"element_id": "FC1", "kind": "min_coupling", "value": 0.65}, {"element_id": "FC1", "kind": "polarization", "value": "V"}, {"element_id": "PD_MON", "kind": "min_power_mw", "value": 0.35}, {"element_id": "PD_SAS", "kind": "min_power_mw", "value": 0.08}], "notes": "Orthogonal L-Branch Layout: (1) Main horizontal arm at y=60 mm runs through PBS1, PBS2, AOM1 (80 MHz, +1 order), f=75 mm cat-eye lens, QWP1, and retro mirror M_RETRO. (2) Return +160 MHz V-polarized beam reflects upward (+90 deg) at PBS2 (x=220 mm) through 5% sampler S_MON (reflecting 5% to PD_MON) into mode-matched fiber coupler FC1. (3) SAS pickoff reflects upward at PBS1 (x=155 mm) to y=245 mm, folds right into the upper-right quadrant, and splits at S_SAS into a weak H-polarized probe (+x at y=160 mm through PBS_SAS1, CELL1, PBS_SAS2 to PD_SAS) and a counter-propagating V-polarized pump injected at PBS_SAS2 and dumped at BD_PUMP.", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "L1", "source_id": "L1", "start": [25.0, 60.0], "end": [70.0, 60.0], "direction_deg": 0.0, "length_mm": 45.0, "wavelength_nm": 780.24, "freq