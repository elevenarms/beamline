data: {"type": "candidate", "index": 4, "stage": "repair", "round": 1, "design": {"name": "rb87_sas_and_doublepass_aom_two_lane", "description": "Parallel Two-Lane Horizontal Layout for a 780.24 nm Rb-87 laser system. The ECDL output passes through an optical isolator and a HWP+PBS pickoff that routes ~10% of the light upward into the upper horizontal lane for Doppler-free saturated absorption spectroscopy (SAS) in a 75 mm Rb vapor cell (PD_SAS). The remaining ~90% continues along the lower horizontal rail into an 80 MHz cat-eye double-pass AOM (+160 MHz total shift, H to V polarization via double-passed QWP). The return V-polarized beam reflects upward at the extraction PBS into a middle horizontal lane, where a 5% wedged sampler picks off light to a power-monitoring photodiode (PD_MON) and the remaining 95% is coupled into a PM780-HP output fiber (FC1).", "modules": [{"id": "source_iso", "title": "780 nm ECDL & Isolation", "region": [15.0, 20.0, 175.0, 70.0], "description": "780.24 nm laser source, optical isolator, and SAS/main power split."}, {"id": "aom_doublepass", "title": "+160 MHz Cat-Eye Double-Pass AOM", "region": [195.0, 10.0, 340.0, 105.0], "description": "80 MHz TeO2 AOM in cat-eye retroreflection configuration with 0th-order and ghost dumps."}, {"id": "monitor_fiber", "title": "5% Power Monitor & Fiber Coupler", "region": [200.0, 115.0, 335.0, 65.0], "description": "Middle lane extracting the +160 MHz V-polarized beam through a 5% sampler to PD_MON and FC1."}, {"id": "rb_sas", "title": "Rb-87 Saturated Absorption Spectroscopy", "region": [135.0, 180.0, 405.0, 110.0], "description": "Upper lane counter-propagating pump-probe spectroscopy loop through a 75 mm Rb vapor cell."}], "baseplate": {"width_mm": 550.0, "height_mm": 300.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "780 nm ECDL", "group": "source_iso", "part_number": "Toptica DL pro 780", "position": [35.0, 55.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 30.0, "waist_mm": 0.43, "waist_offset_mm": 265.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO1", "type": "isolator", "label": "Optical isolator", "group": "source_iso", "part_number": "IO-3D-780-VLP", "beam": "L1", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.9, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP1", "type": "half_wave_plate", "label": "SAS split lambda/2", "group": "source_iso", "part_number": "WPH05M-780", "beam": "L1", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 9.2, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "SAS pickoff PBS", "group": "source_iso", "part_number": "PBS052", "beam": "L1", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S_SAS", "type": "sampler", "label": "Probe pickoff (10%)", "group": "rb_sas", "part_number": "BSF05-B", "beam": "L1.r", "distance_mm": 145.0, "at": 