ency_per_w": null}, {"id": "M_PUMP2", "type": "mirror", "label": "Pump fold mirror 2", "group": "rb_sas_locking", "part_number": "BB05-E03", "beam": "L1.r.t", "distance_mm": 240.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_PUMP", "type": "beam_dump", "label": "Spent pump dump", "group": "rb_sas_locking", "part_number": "LB1", "beam": null, "distance_mm": null, "at": [270.0, 235.0], "angle_deg": 90.0, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_U1", "type": "mirror", "label": "U-turn fold mirror 1", "group": "aom_doublepass_160mhz", "part_number": "BB05-E03", "beam": "L1.t", "distance_mm": 310.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_U2", "type": "mirror", "label": "U-turn fold mirror 2", "group": "aom_doublepass_160mhz", "part_number": "BB05-E03", "beam": "L1.t", "distance_mm": 160.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm":