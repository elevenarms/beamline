data: {"type": "iteration", "agent_id": "designer-4", "seq": 2, "label": "autofix", "design": {"name": "rb_sas_and_doublepass_aom_inline", "description": "SAS-First Inline Split Layout: A 780.24 nm ECDL passes through an optical isolator and a HWP+PBS splitter (PBS1) that reflects ~10% vertically into a left-side Rb saturated-absorption spectroscopy (SAS) loop and transmits ~90% horizontally into a right-side cat-eye double-pass 80 MHz AOM (+160 MHz shift). The return V-polarized beam from the double-pass AOM reflects upward at PBS2, passes through a 5% power-monitoring sampler (S_MON -> PD_MON), and is steered into a mode-matched PM780-HP fiber coupler (FC1).", "modules": [{"id": "laser_source_and_isolation", "title": "Laser Input & Isolation", "region": [15.0, 10.0, 175.0, 70.0], "description": "780.24 nm ECDL, optical isolator, and HWP+PBS split between SAS and main AOM arm"}, {"id": "rb_sas_locking", "title": "Rb Saturated Absorption Spectroscopy", "region": [20.0, 85.0, 210.0, 205.0], "description": "Vertical counter-propagating pump/probe Rb vapor cell loop with probe locking photodiode PD_SAS"}, {"id": "aom_doublepass_160mhz", "title": "Cat-Eye Double-Pass 80 MHz AOM", "region": [200.0, 10.0, 335.0, 110.0], "description": "Double-pass 80 MHz AOM (+160 MHz total shift) with f=75 mm cat-eye lens, QWP, and retro mirror"}, {"id": "power_monitor_and_fiber_out", "title": "5% Monitor & Fiber Coupler Output", "region": [200.0, 120.0, 335.0, 170.0], "description": "Two-mirror steering, 5% pickoff photodiode PD_MON, and mode-matched fiber coupler FC1"}], "baseplate": {"width_mm": 550.0, "height_mm": 300.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "780 nm ECDL (30 mW, collimated w0=0.43 mm, waist at AOM1/FC1 ~340 mm downstream) ", "group": "laser_source_and_isolation", "part_number": "Toptica DL pro 780", "position": [25.0, 45.0], "direction_deg": 0.0, "wavelength_nm": 780.24, "power_mw": 30.0, "waist_mm": 0.43