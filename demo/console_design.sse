_number": "LB1", "beam": null, "distance_mm": null, "at": [430.006, 55.297], "angle_deg": 0.8513, "out_direction_deg": null, "aperture_mm": 1.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_RETRO", "type": "mirror", "label": "Cat-eye retro mirror", "group": "aom_doublepass", "part_number": "BB05-E03", "beam": "L1.t.t.+1", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": 180.8513, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_GHOST", "type": "beam_dump", "label": "Return 0th-order ghost block", "group": "monitor_fiber", "part_number": "LB1", "beam": "L1.t.t.+1.0.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 1.5, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_OUT", "type": "mirror", "label": "Middle-lane fold mirror", "group": "monitor_fiber", "part_number": "BB05-E03", "beam": "L1.t.t.+1.+1.r", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "