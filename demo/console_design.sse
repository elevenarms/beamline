ns right at M_OUT1, picks off 5% at S_MON into PD_MON (~0.88 mW), and couples ~13.9 mW (83.2% coupling efficiency) into FC1.", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "L1", "source_id": "L1", "start": [40.0, 260.0], "end": [95.0, 260.0], "direction_deg": 0.0, "length_mm": 55.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 30.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 450.0, "rayleigh_mm": 744.4894925263416, "w0_mm": 0.43, "w_start_mm": 0.5024470357832577, "w_end_mm": 0.48677426782728983, "start_element": "L1", "end_element": "ISO1", "end_reason": "element"}, {"id": "s1", "branch": "L1", "source_id": "L1", "start": [95.0, 260.0], "end": [145.0, 260.0], "direction_deg": 0.0, "length_mm": 50.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 27.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 395.0, "rayleigh_mm": 744.4894925263416, "w0_mm": 0.43, "w_start_mm": 0.48677426782728983, "w_end_mm": 0.4739263299207602, "start_element": "ISO1", "end_element": "HWP1", "end_reason": "element"}, {"id": "s2", "branch": "L1", "source_id": "L1", "start": [145.0, 260.0], "end": [190.0, 260.0], "direction_deg": 0.0, "length_mm": 45.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 27.0, "jones": [[0.9488760116444965, 0.0], [0.3156490369471025, -2.036928840056085e-17]], "polarization_label": "linear 18\u00b0", "waist_z_mm": 345.0, "rayleigh_mm": 744.4894925263416, "w0_mm": 0.43, "w_start_mm": 0.4739263299207602, "w_end_mm": 0.4635984966744786, "start_element": "HWP1", "end_element": "PBS_SPLIT", "end_reason": "element"}, {"id": "s3", "branch": "L1.t", "source_id": "L1", "start": [190.0, 260.0], "end": [500.0, 260.0], "direction_deg": 0.0, "length_mm": 310.0, "wavelength_nm": 780.24, "freq_shift_mhz": 0.0, "power_mw": 24.3098735078079, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 300.0, "rayleigh_mm": 744.4894925263416, "w0_mm": 