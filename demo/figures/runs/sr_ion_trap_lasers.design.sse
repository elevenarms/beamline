data: {"type": "candidate", "index": 1, "stage": "design", "design": {"name": "sr_ion_perimeter_bank_delivery", "description": "88Sr+ Ion Trap Laser Delivery and Photoionization Bench using a perimeter laser bank layout. All four laser sources (1092 nm repumper, 422 nm cooling, 461 nm 1st-step PI, 405 nm 2nd-step PI) are mounted along the left (west) baseplate edge. The 422 nm cooling laser passes an isolator and a 5% wedged sampler (which sends ~0.9 mW via two steering mirrors into fiber coupler FC_LOCK in the lower-left for transfer-cavity locking), then enters the ion trap center at (310, 200) from the west. The 1092 nm repumper is routed around the top-east perimeter to enter the trap from the east opposing the 422 nm beam; 650 nm cutoff dichroics on either side of the trap separate the counter-propagating exit beams into PD_422 and PD_1092. The 461 nm and 405 nm beams are combined on a 430 nm dichroic in the lower center and traverse the trap center vertically (south-to-north) to PD_PI.", "modules": [{"id": "cooling_422_and_lock_pickoff", "title": "422 nm Cooling & Transfer-Cavity Lock Pickoff", "region": [20.0, 115.0, 260.0, 125.0], "description": "Isolates 422 nm cooling light, picks off 5% to FC_LOCK via two alignment mirrors, and delivers the main cooling beam from the west into the trap center at (310, 200)."}, {"id": "repumper_1092_delivery", "title": "1092 nm Repumper Perimeter Routing & East Trap Entry", "region": [20.0, 245.0, 465.0, 95.0], "description": "Routes the 1092 nm repumper along the north/east perimeter to enter the trap from the east opposing 422 nm, with dichroic separation into PD_422 and PD_1092."}, {"id": "photoionization_461_405_combiner", "title": "461 nm + 405 nm Photoionization Combiner", "region": [20.0, 15.0, 330.0, 95.0], "description": "Combines 461 nm and 405 nm photoionization lasers on a 430 nm cutoff dichroic and focuses them south-to-north through the ion trap center to PD_PI."}], "baseplate": {"width_mm": 500.0, "height_mm": 350.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L_1092", "label": "1092 nm Repumper Laser (ECDL / DFB, H-pol, west bank top) ", "group": "repumper_1092_delivery", "part_number": "Toptica DL pro 1092", "position": [40.0, 310.0], "direction_deg": 0.0, "wavelength_nm": 1091.79, "power_mw": 20.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "L_422", "label": "422 nm Doppler Cooling Laser (SHG/ECDL, H-pol, west bank) ", "group": "cooling_422_and_lock_pickoff", "part_number": "Toptica TA-SHG pro 422", "position": [40.0, 200.0], "direction_deg": 0.0, "wavelength_nm": 422.67, "power_mw": 20.0, "waist_mm": 0.42, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "L_461", "label": "461 nm Neutral Sr 1st-Step PI Laser (west bank lower-mid) ", "group": "photoionization_461_405_combiner", "part_number": "Toptica DL pro 461", "position": [40.0, 85.0], "direction_deg": 0.0, "wavelength_nm": 460.86, "power_mw": 10.0, "waist_mm": 0.5, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "L_405", "label": "405 nm Sr+ 2nd-Step Ionizing Laser (west bank bottom) ", "group": "photoionization_461_405_combiner", "part_number": "Toptica iBeam smart 405", "position": [40.0, 35.0], "direction_deg": 0.0, "wavelength_nm": 405.0, "power_mw": 10.0, "waist_mm": 0.5, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO_422", "type": "isolator", "label": "422 nm Optical Isolator", "group": "cooling_422_and_lock_pickoff", "part_number": "IO-3D-422-VLP", "beam": "L_422", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.92, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S_LOCK", "type": "sampler", "label": "5% Wedged Pickoff Sampler (to transfer cavity lock) ", "group": "cooling_422_and_lock_pickoff", "part_number": "BSF05-A", "beam": "L_422", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_LOCK1", "type": "mirror", "label": "Lock Fiber Steering Mirror 1", "group": "cooling_422_and_lock_pickoff", "part_number": "BB05-E01", "beam": "L_422.r", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_LOCK2", "type": "mirror", "label": "Lock Fiber Steering Mirror 2", "group": "cooling_422_and_lock_pickoff", "part_number": "BB05-E01", "beam": "L_422.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC_LOCK", "type": "fiber_coupler", "label": "Transfer-Cavity Wavelength Lock Fiber Coupler", "group": "cooling_422_and_lock_pickoff", "part_number": "PAF2-A4A", "beam": "L_422.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 4.5, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 3.2, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP_422", "type": "half_wave_plate", "label": "422 nm Polarization Control lambda/2", "group": "cooling_422_and_lock_pickoff", "part_number": "WPH05M-405", "beam": "L_422.t", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 0.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "DM_WEST", "type": "dichroic", "label": "West Dichroic (transmits 422 nm east, reflects 1092 nm north) ", "group": "cooling_422_and_lock_pickoff", "part_number": "DMLP650", "beam": "L_422.t", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": 650.0, "reflect": "above", "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "LENS_WEST", "type": "lens", "label": "West Trap Lens (f=100 mm, focuses 422 nm at trap x=310) ", "group": "cooling_422_and_lock_pickoff", "part_number": "LA1509-A", "beam": "L_422.t.t", "distance_mm": 35.0, "a