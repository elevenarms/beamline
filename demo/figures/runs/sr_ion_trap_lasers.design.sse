saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_PI", "type": "photodiode", "label": "Post-Trap PI Monitor PD", "group": "photoionization_461_405_combiner", "part_number": "PDA36A2", "beam": "L_461.t", "distance_mm": 210.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "FC_LOCK", "kind": "min_power_mw", "value": 0.5}, {"element_id": "FC_LOCK", "kind": "min_coupling", "value": 0.7}, {"element_id": "PD_422", "kind": "min_power_mw", "value": 15.0}, {"element_id": "PD_1092", "kind": "min_power_mw", "value": 15.0}, {"element_id": "PD_PI", "kind": "min_power_mw", "value": 18.0}], "notes": "Ion trap center is located at (280, 200) mm where the horizontal 422 nm / 1092 nm cooling+repump axis and the vertical 461 nm + 405 nm photoionization axis cross orthogonally. DM_WEST (cutoff 650 nm, reflect above) transmits 422 nm into the trap and reflects counter-propagating 1092 nm upward into PD_1092. DM_EAST (cutoff 650 nm, reflect above) reflects incoming 1092 nm (+90 deg to 180 deg) westward into the trap and transmits exiting 422 nm eastward into PD_422. DM_PI (cutoff 430 nm, reflect below) transmits 461 nm upward (+90 deg) and reflects 405 nm (from 0 deg to +90 deg) so both photoionization beams co-propagate through the trap center to PD_PI."}, "report": {"passed": false, "score": 48.16664027236642, "checks": [{"id": "stray_beam", "severity": "error", "message": "laser safety: unterminated beam on L_1092.r.r (18.00 mW) leaves the table from (200,200) at -90\u00b0; add a beam dump", "element_id": null, "segment_id": "s14", "value": 18.0, "limit": 0.5}, {"id": "no_light", "severity": "info", "message": "PD_1092 receives no light", "element_id": "PD_1092", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "info", "message": "met: FC_LOCK: 0.900 mW (need \u2265 0.500)", "element_id": "FC_LOCK", "segment_id": null, "value": 0.8996832683971475, "limit": 0.5}, {"id": "target", "severity": "info", "message": "met: FC_LOCK: coupling 100.0% (need \u2265 70.0%)", "element_id": "FC_LOCK", "segment_id": null, "value": 0.9996480759968306, "limit": 0.7}, {"id": "target", "severity": "info", "message": "met: PD_422: 17.100 mW (need \u2265 15.000)", "element_id": "PD_422", "segment_id": null, "value": 17.099999999999998, "limit": 15.0}, {"id": "target", "severity": "error", "message": "unmet: PD_1092: 0.000 mW (need \u2265 15.000)", "element_id": "PD_1092", "segment_id": null, "value": 0.0, "limit": 15.0}, {"id": "target", "severity": "info", "message": "met: PD_PI: 20.000 mW (need \u2265 18.000)", "element_id": "PD_PI", "segment_id": null, "value": 20.0, "limit": 18.0}], "metrics": {"input_mw": 60.0, "delivered_mw": 37.99968326839714, "dumped_mw": 0.0, "stray_mw": 18.0, "n_elements": 16.0, "n_segments": 20.0, "target.FC_LOCK.min_power_mw": 0.8996832683971475, "target.FC_LOCK.min_coupling": 0.9996480759968306, "target.PD_422.min_power_mw": 17.099999999999998, "target.PD_1092.min_power_mw": 0.0, "target.PD_PI.min_power_mw": 20.0, "delivered_fraction": 0.6333280544732857}}, "trace": {"segments": [{"id": "s0", "branch": "L_422", "source_id": "L_422", "start": [25.0, 200.0], "end": [70.0, 200.0], "direction_deg": 0.0, "length_mm": 45.0, "wavelength_nm": 422.67, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 180.0, "rayleigh_mm": 2675.7833659647613, "w0_mm": 0.6, "w_start_mm": 0.601356044288938, "w_end_mm": 0.6007631515427665, "start_element": "L_422", "end_element": "ISO_422", "end_reason": "element"}, {"id": "s1", "br