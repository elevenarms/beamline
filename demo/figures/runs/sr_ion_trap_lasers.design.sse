data: {"type": "final", "design": {"name": "sr_ion_trap_modular_bench", "description": "88Sr+ ion trap laser delivery and photoionization bench organized into three modular functional zones converging on a central ion-trap aperture at (260, 220) mm. West module (cooling_422_and_lock_pickoff): 422 nm Doppler cooling laser passes an isolator and a 5% wedged sampler (walked by two mirrors into transfer-cavity lock fiber FC_LOCK), then passes a HWP, west dichroic DM_WEST (transmitting < 650 nm, reflecting 1092 nm), and f=100 mm trap lens into the trap center from the west. East module (repumper_1092_delivery): 1092 nm repumper passes an isolator, HWP, fold mirror, east dichroic DM_EAST (transmitting > 650 nm, reflecting 422 nm), and f=100 mm lens into the trap from the east (counter-propagating to 422 nm); after traversing the trap, 422 nm is picked off by DM_EAST into PD_422 and 1092 nm is picked off by DM_WEST into PD_1092. Bottom-center module (photoionization_461_405_combiner): 461 nm first-step and 405 nm second-step photoionization beams are steered and combined colinearly on a 430 nm cutoff dichroic DM_PI, focused vertically through the trap center (260, 220) mm via an f=100 mm lens, and monitored on post-trap photodiode PD_PI.", "modules": [{"id": "cooling_422_and_lock_pickoff", "title": "422 nm Cooling & Transfer-Cavity Lock Pickoff (West Zone, Trap Center at x=260, y=220)", "region": [10.0, 145.0, 210.0, 195.0], "description": "Isolates 422 nm cooling laser, picks off 5% into wavelength-lock fiber FC_LOCK, and focuses main 422 nm beam into the trap from the west while separating counter-propagating 1092 nm to PD_1092."}, {"id": "photoionization_461_405_combiner", "title": "461 nm + 405 nm Photoionization Combiner (Bottom-Center Zone)", "region": [150.0, 10.0, 210.0, 130.0], "description": "Combines 461 nm and 405 nm photoionization beams on a 430 nm dichroic and focuses them south-to-north through the ion trap center to PD_PI."}, {"id": "repumper_1092_delivery", "title": "1092 nm Repumper Delivery & Exit Monitors (East Zone)", "region": [300.0, 145.0, 190.0, 195.0], "description": "Isolates and steers 1092 nm repumper into the trap from the east opposing 422 nm, and collects exiting 422 nm onto PD_422."}], "baseplate": {"width_mm": 500.0, "height_mm": 350.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L_422", "label": "422 nm Doppler Cooling Laser", "group": "cooling_422_and_lock_pickoff", "part_number": "Toptica DL pro 422", "position": [25.0, 170.0], "direction_deg": 0.0, "wavelength_nm": 422.67, "power_mw": 20.0, "waist_mm": 0.43, "waist_offset_mm": 160.0, "polarization": "H", "enabled": true}, {"id": "L_1092", "label": "1092 nm Repumper Laser", "group": "repumper_1092_delivery", "part_number": "Toptica DL pro 1092", "position": [465.0, 320.0], "direction_deg": -90.0, "wavelength_nm": 1091.79, "power_mw": 20.0, "waist_mm": 0.6, "waist_offset_mm": 100.0, "polarization": "H", "enabled": true}, {"id": "L_461", "label": "461 nm 1st-Stage PI Laser", "group": "photoionization_461_405_combiner", "part_number": "Toptica DL pro 461", "position": [180.0, 30.0], "direction_deg": 0.0, "wavelength_nm": 460.86, "power_mw": 10.0, "waist_mm": 0.5, "waist_offset_mm": 170.0, "polarization": "H", "enabled": true}, {"id": "L_405", "label": "405 nm 2nd-Stage PI Laser", "group": "photoionization_461_405_combiner", "part_number": "Toptica iBeam smart 405", "position": [340.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 405.0, "power_mw": 10.0, "waist_mm": 0.5, "waist_offset_mm": 170.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO_422", "type": "isolator", "label": "422 nm Optical Isolator", "group": "cooling_422_and_lock_pickoff", "part_number": "IO-3D-422", "beam": "L_422", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.92, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S_LOCK", "type": "sampler", "label": "5% Lock Pickoff Sampler", "group": "cooling_422_and_lock_pickoff", "part_number": "BSF05-A", "beam": "L_422", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_LOCK1", "type": "mirror", "label": "Lock Walk Mirror 1", "group": "cooling_422_and_lock_pickoff", "part_number": "BB05-E01", "beam": "L_422.r", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_LOCK2", "type": "mirror", "label": "Lock Walk Mirror 2", "group": "cooling_422_and_lock_pickoff", "part_number": "BB05-E01", "beam": "L_422.r", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficienc