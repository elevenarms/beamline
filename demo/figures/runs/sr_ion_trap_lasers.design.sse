data: {"type": "candidate", "index": 0, "stage": "design", "design": {"name": "sr_plus_crossed_axis_trap_bench", "description": "88Sr+ ion trap laser delivery bench using a crossed-axis central trap layout. The 422 nm Doppler cooling laser (west) and 1092 nm repumper laser (east) counter-propagate horizontally through the central ion trap focal region (x=280, y=200) and are separated after the trap by 650 nm cutoff dichroics onto exit monitoring photodiodes PD_422 and PD_1092. A 5% wedged sampler picks off ~0.9 mW of the 422 nm beam into fiber coupler FC_LOCK via two alignment mirrors for transfer-cavity wavelength locking. In the lower quadrant, 461 nm and 405 nm photoionization beams are combined on a 430 nm cutoff dichroic and pass vertically through the trap center to post-trap photodiode PD_PI.", "modules": [{"id": "cooling_422_and_lock_pickoff", "title": "422 nm Cooling & Lock Pickoff", "region": [15.0, 150.0, 220.0, 185.0], "description": "Isolates 422 nm cooling laser, picks off 5% into wavelength-lock fiber FC_LOCK, and delivers the main cooling beam from the west into the trap center."}, {"id": "repumper_1092_delivery", "title": "1092 nm Repumper & Exit Monitors", "region": [320.0, 115.0, 175.0, 210.0], "description": "Delivers 1092 nm repumper from the east opposing the 422 nm axis and separates post-trap beams onto PD_422 and PD_1092."}, {"id": "photoionization_461_405_combiner", "title": "461 nm + 405 nm Photoionization Combiner", "region": [140.0, 20.0, 175.0, 310.0], "description": "Combines 461 nm and 405 nm photoionization lasers on a 430 nm dichroic and sends them vertically through the trap center to PD_PI."}], "baseplate": {"width_mm": 500.0, "height_mm": 350.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L_422", "label": "422 nm Cooling Laser", "group": "cooling_422_and_lock_pickoff", "part_number": "Toptica DL pro 422", "position": [25.0, 200.0], "direction_deg": 0.0, "wavelength_nm": 422.67, "power_mw": 20.0, "waist_mm": 0.6, "waist_offset_mm": 180.0, "polarization": "H", "enabled": true}, {"id": "L_1092", "label": "1092 nm Repumper Laser", "group": "repumper_1092_delivery", "part_number": "Toptica DL pro 1092", "position": [475.0, 140.0], "direction_deg": 180.0, "wavelength_nm": 1091.79, "power_mw": 20.0, "waist_mm": 0.6, "waist_offset_mm": 180.0, "polarization": "H", "enabled": true}, {"id": "L_461", "label": "461 nm 1st-Step PI Laser", "group": "photoionization_461_405_combiner", "part_number": "Toptica DL pro 461", "position": [160.0, 45.0], "direction_deg": 0.0, "wavelength_nm": 460.86, "power_mw": 10.0, "waist_mm": 0.6, "waist_offset_mm": 160.0, "polarization": "H", "enabled": true}, {"id": "L_405", "label": "405 nm 2nd-Step PI Laser", "group": "photoionization_461_405_combiner", "part_number": "Toptica iBeam smart 405", "position": [160.0, 95.0], "direction_deg": 0.0, "wavelength_nm": 405.0, "power_mw": 10.0, "waist_mm": 0.6, "waist_offset_mm": 110.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO_422", "type": "isolator", "label": "422 nm Isolator", "group": "cooling_422_and_lock_pickoff", "part_number": "IO-3D-422", "beam": "L_422", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.9, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S_LOCK", "type": "sampler", "label": "5% Lock Pickoff Sampler", "group": "cooling_422_and_lock_pickoff", "part_number": "BSF05-A", "beam": "L_422", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz"