"fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_1092_2", "type": "mirror", "label": "1092 nm East Trap-Entry Fold Mirror", "group": "repumper_1092_delivery", "part_number": "BB05-E03", "beam": "L_1092", "distance_mm": 110.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_1092", "type": "photodiode", "label": "1092 nm Post-Trap Exit Monitor Photodiode", "group": "repumper_1092_delivery", "part_number": "PDA36A2", "beam": "L_1092.t.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_461_1", "type": "mirror", "label": "461 nm Steering Mirror 1", "group": "photoionization_461_405_combiner", "part_number": "BB05-E01", "beam": "L_461", "distance_mm": 190.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_461_2", "type": "mirror", "label": "461 nm Steering Mirror 2 (toward PI combiner) ", "group": "photoionization_461_405_combiner", "part_number": "BB05-E01", "beam": "L_461", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_405_1", "type": "mirror", "label": "405 nm Steering Mirror (turns north into combiner) ", "group": "photoionization_461_405_combiner", "part_number": "BB05-E01", "beam": "L_405", "distance_mm": 270.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "DM_PI", "type": "dichroic", "label": "PI Dichroic Combiner (430 nm cutoff: reflects 461, transmits 405) ", "group": "photoionization_461_405_combiner", "part_number": "DMSP425", "beam": "L_405", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": 430.0, "reflect": "above", "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "LENS_PI", "type": "lens", "label": "PI Trap Focusing Lens (f=100 mm, focuses 461+405 at trap) ", "group": "photoionization_461_405_combiner", "part_number": "LA1509-A", "beam": "L_405.t", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_PI", "type": "photodiode", "label": "Co-Propagating 461+405 nm Post-Trap Monitor Photodiode", "group": "photoionization_461_405_combiner", "part_number": "PDA36A2", "beam": "L_405.t", "distance_mm": 145.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "FC_LOCK", "kind": "min_power_mw", "value": 0.5}, {"element_id": "FC_LOCK", "kind": "min_coupling", "value": 0.7}, {"element_id": "PD_422", "kind": "min_power_mw", "value": 15.0}, {"element_id": "PD_1092", "kind": "min_power_mw", "value": 15.0}, {"element_id": "PD_PI", "kind": "min_power_mw", "value": 18.0}], "notes": "Ion trap center is located at (310, 200) mm. The 422 nm cooling beam (from the west along +x) and 1092 nm repumper (routed from the west laser bank around the top perimeter to enter from the east along -x) counter-propagate through the trap center and are separated by DM_EAST and DM_WEST (650 nm cutoff dichroics) into PD_422 (17.48 mW) and PD_1092 (18.40 mW). The 5% pickoff from S_LOCK is steered by M_LOCK1 and M_LOCK2 into FC_LOCK (0.76 mW coupled, 82.6% coupling efficiency). The 461 nm and 405 nm photoionization lase