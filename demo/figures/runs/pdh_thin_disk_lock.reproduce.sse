data: {"type": "final", "design": {"name": "tdl_injection_seeded_pdh", "description": "1030 nm injection-seeded thin-disk laser (TDL) with Pound-Drever-Hall (PDH) feedback loop. A V-polarized seed laser enters PBS1 from below and is reflected left through a quarter-wave plate (QWP1 at 45 deg) into the thin-disk laser head (modeled as a high-reflectivity retro-mirror with weak leakage to the intra-resonator photodiode PD_INTRA). On the return pass through QWP1, the polarization is rotated to H and transmits through PBS1 toward the output coupler / high-reflector HR1, which reflects the main 1030 nm pulses upward (caught by output dump BD_OUT) while transmitting a small leakage fraction to the fast PDH photodiode PD_FAST.", "modules": [], "baseplate": {"width_mm": 490.0, "height_mm": 220.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "SEED", "label": "Seed laser (1030 nm, V-polarized for PBS reflection + 1% H leakage check, or pure V with TDL source; here pure V seed retro-reflected off TDL active mirror with 98% reflection and 2% transmission to PD_INTRA, modeled as a sampler S_TDL at the TDL position + TDL pulse source for amplified output) \u2014 modeled cleanly with SEED (V, 20 mW) and TDL_LEAK / TDL_OUT", "group": null, "part_number": "Toptica DL pro 1030", "position": [289.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 1030.0, "power_mw": 50.0, "waist_mm": 1.0, "waist_offset_mm": 0.0, "polarization": "V", "enabled": true}], "elements": [{"id": "PBS1", "type": "pbs", "label": "PBS", "group": null, "part_number": "PBS253", "beam": "SEED", "distance_mm": 128.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "QWP1", "type": "quarter_wave_plate", "label": "lambda/4", "group": null, "part_number": "WPQ05M-1030", "beam": "SEED.r", "distance_mm": 95.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "TDL", "type": "beamsplitter", "label": "Thin-disk laser (active retro / leakage mirror, 95% reflect, 5% leak to PD_INTRA, normal along +x via shallow-angle or sampler; using beamsplitter with angle_deg=180 for transmitted leakage to PD_INTRA and retro-mirror M_TDL for return beam) \u2014 wait: let's make TDL a mirror and add a collinear source for PD_INTRA or make TDL a sampler", "group": null, "part_number": "TDL-1030", "beam": "SEED.r", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.95, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_TDL_RETRO", "type": "mirror", "label": "TDL resonator retro-reflector", "group": null, "part_number": "BB1-E03", "beam": "SEED.r.r", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_INTRA", "type": "photodiode", "label": "PD intra", "group": null, "part_number": "PDA36A2", "beam": "SEED.r.t", "distance_mm": 79.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HR1", "type": "sampler", "label": "HR (95% reflect 1030 nm pulses out, 5% transmit to fast PD H-pol -> use beamsplitter with split_ratio=0.95, out_direction_deg=90.0 so reflected pulses go up and transmitted leakage goes to PD_FAST!)", "group": null, "part_number": "BSF10-C", "beam": "SEED.r.r.r.t", "distance_mm": 89.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.95, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_OUT", "type": "beam_dump", "label": "1030 nm pulses out", "group": null, "part_number": "BT610", "beam": "SEED.r.r.r.t.r", "distance_mm": 42.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_FAST", "type": "photodiode", "label": "fast PD", "group": null, "part_number": "DET08C", "beam": "SEED.r.r.r.t.t", "distance_mm": 83.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_TDL_LEAK", "type": "beam_dump", "label": "TDL return leakage dump", "group": null, "part_number": "LB1", "beam": null, "distance_mm": null, "at": [109.0, 115.0], "angle_deg": 270.0, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD_INTRA", "kind": "min_power_mw", "value": 1.0}, {"element_id": "PD_FAST", "kind": "min_power_mw", "value": 1.0}], "notes": "The seed laser (SEED) at [289, 30] injects 50 mW of V-polarized 1030 nm light upward into PBS1 ([289, 158]). PBS1 reflects V to the left (180 deg) through QWP1 ([194, 158], fast axis 45 deg, converting V to circular) into the thin-disk laser module TDL ([109, 158]). TDL is modeled as a high-reflectivity splitter (95% reflect, 5% transmit) coupled to a resonator retro-mirror M_TDL_RETRO ([109, 198]) so that 5% of the intra-resonator light leaks straight left to PD_INTRA ([30, 158]) while the main intra-resonator beam retro-reflects back right through QWP1. On the return pass through QWP1, the polarization becomes H and transmits straight through PBS1 to the output coupler HR1 ([378, 158]), which reflects 95% of the 1030 nm pulses upward (into BD_OUT at [378, 200]) and transmits 5% leakage to PD_FAST ([461, 158])."}, "report": {"passed": true, "score": 95.475625, "checks": [{"id": "target", "severity": "info", "message": "met: PD_INTRA: 2.500 mW (need \u2265 1.000)", "element_id": "PD_INTRA", "segment_id": null, "value": 2.500000000000002, "limit": 1.0}, {"id": "target", "severity": "info", "message": "met: PD_FAST: 2.256 mW (need \u2265 1.000)", "element_id": "PD_FAST", "segment_id": null, "value": 2.256250000000002, "limit": 1.0}], "metrics": {"input_mw": 50.0, "delivered_mw": 4.756250000000004, "dumped_mw": 45.24375, "stray_mw": 0.0, "n_elements": 9.0, "n_segments": 12.0, "target.PD_INTRA.min_power_mw": 2.500000000000002, "target.PD_FAST.min_power_mw": 2.256250000000002, "delivered_fraction": 0.09512500000000008}}, "trace": {"segments": [{"id": "s0", "branch": "SEED", "source_id": "SEED", "start": [289.0, 30.0], "end": [289.0, 158.0], "direction_deg": 90.0, "length_mm": 128.0, "wavelength_nm": 1030.0, "freq_shift_mhz": 0.0, "power_mw": 50.0, "jones": [[0.0, 0.0], [1.0, 0.0]], "polarization_label": "V", "waist_z_mm": 0.0, "rayleigh_mm": 3050.089954941547, "w0_mm": 1.0, "w_start_mm": 1.0, "w_end_mm": 1.0008801841833066, "start_element": "SEED", "end_element": "PBS1", "end_reason": "element"}, {"id": "s1", "branch": "SEED.r", "source_id": "SEED", "start": [289.0, 158.0], "end": [194.0, 158.00000000000003], "direction_deg": 180.0, "length_mm": 94.99999999999999, "wavelength_nm": 1030.0, "freq_shift_mhz": 0.0, "power_mw": 50.0, "jones": [[-0.0, 0.0], [1.0, 0.0]], "polarization_label": "V", "waist_z_mm": -128.0, "rayleigh_mm": 3050.089954941547, "w0_mm": 1.0, "w_start_mm": 1.0008801841833066, "w_end_mm": 1.002669163757846, "start_element": "PBS1", "end_element": "QWP1", "end_reason": "element"}, {"id": "s2", "branch": "SEED.r", "source_id": "SEED", "start": [194.0, 158.00000000000003], "end": [109.0, 158.00000000000006], "direction_deg": 180.0, "length_mm": 84.99999999999999, "wa