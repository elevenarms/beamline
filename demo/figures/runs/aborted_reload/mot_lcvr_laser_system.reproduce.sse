ance_mm": 41.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "FC1", "kind": "min_power_mw", "value": 120.0}, {"element_id": "FC2", "kind": "min_power_mw", "value": 120.0}, {"element_id": "FC3", "kind": "min_power_mw", "value": 40.0}], "notes": "Reproduces the 87Rb MOT and Detection Laser System with LCVR Polarization Control on a 700 x 470 mm baseplate. Free-space beams from ECDL1 (cooling) and ECDL2 (repump) are amplified by TA1 and TA2, modulated by AOM1 and AOM2, and split at PBS1 and PBS2. The main H-polarized beams pass through the LCVR1 and LCVR2 polarization control stages (HWP2-LCVR1-HWP3 and HWP5-LCVR2-HWP6) into fiber couplers FC1 (FS input 1) and FC2 (FS input 2) which feed the 2x4 PM fiber splitter (outputs a, b, c, d). The V-polarized pickoff beams from PBS1 and PBS2 are combined at PBS3 into the Detection fiber coupler FC3."}, "report": {"passed": false, "score": 20.0, "checks": [{"id": "no_light", "severity": "info", "message": "HWP1 receives no light", "element_id": "HWP1", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "PBS1 receives no light", "element_id": "PBS1", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "HWP2 receives no light", "element_id": "HWP2", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "LCVR1 receives no light", "element_id": "LCVR1", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "HWP3 receives no light", "element_id": "HWP