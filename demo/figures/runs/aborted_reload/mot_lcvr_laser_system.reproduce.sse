data: {"type": "candidate", "index": 0, "stage": "design", "design": {"name": "rb87_mot_detection_lcvr", "description": "87Rb MOT and Detection Laser System with LCVR Polarization Control. Two ECDLs (ECDL1 cooling at 780.24 nm, ECDL2 repump at 780.24 nm) amplified by tapered amplifiers (TA1, TA2, modeled via SOA / source output) pass through AOMs and half-wave plates before splitting at PBS1 and PBS2. The main transmitted beams traverse liquid crystal variable retarder (LCVR) waveplate stages into fiber couplers FC1 (FS input 1) and FC2 (FS input 2). The reflected pickoff beams are recombined on PBS3 and coupled into the Detection fiber coupler FC3.", "modules": [], "baseplate": {"width_mm": 700.0, "height_mm": 470.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "ECDL1", "label": "ECDL1 + TA1 (Cooling, 780.24 nm, 1 W after TA1 at x=161 mm, y=435 mm; source placed at x=391 mm per figure layout, or collimated output of TA1/ECDL1 chain): here ECDL1 at [391, 435] emits 50 mW into TA1 (SOA) at [161, 435], yielding ~430 mW collimated beam with w=1.02 mm mode-matched for f=11 mm fiber couplers", "group": null, "part_number": "Toptica DL pro 780", "position": [391.0, 435.0], "direction_deg": 180.0, "wavelength_nm": 780.24, "power_mw": 50.0, "waist_mm": 1.02, "waist_offset_mm": 350.0, "polarization": "H", "enabled": true}, {"id": "ECDL2", "label": "ECDL2 (Repump, 780.24 nm, seed for TA2 at [200, 35])", "group": null, "part_number": "Toptica DL pro 780", "position": [391.0, 35.0], "direction_deg": 180.0, "wavelength_nm": 780.24, "power_mw": 50.0, "waist_mm": 1.02, "waist_offset_mm": 350.0, "polarization": "H", "enabled": true}], "elements": [{"id": "TA1", "type": "soa", "label": "TA1 (Tapered Amplifier 1, up to 1 W class; modeled as SOA with high saturation power so beam reaches ~500 mW without clipping or collision on the 700x470 mm board; placed at x=161, y=435 per xy_mm [161,433])", "group": null, "part_number": "Thorlabs TPA780P20", "beam": "ECDL1", "distance_mm": 230.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": 500.0, "small_signal_gain_db": 10.5, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "M1 (Fold mirror 1, upper left [30, 435])", "group": null, "part_number": "BB1-E03", "beam": "ECDL1", "distance_mm": 131.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "M2 (Fold mirror 2, [30, 327])", "group": null, "part_number": "BB1-E03", "beam": "ECDL1", "distance_mm": 108.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "AOM1", "type": "aom", "label": "AOM1 (Cooling AOM, [92, 327])", "group": null, "part_number": "Isomet 1205C-1", "beam": "ECDL1", "distance_mm": 62.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 6.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": 80.0, "aom_efficiency": 0.85, "aom_order": 1, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_AOM1", "type": "beam_dump", "label": "AOM1 +1 order dump (or 0th order dump; since figure shows straight collinear propagation after AOM1 along y=327 mm, we route the main 85% beam straight or dump the minor branch so all downstream optics sit on clean 0/90/180/270 deg axes; here AOM1 efficiency=0.15 into +1 deflected branch which is dumped, and 85% stays on the straight 0 deg axis as shown in figure, OR we use a very low acoustic ratio; even better: we dump the deflected .1 branch at BD_AOM1 and use the straight .0 branch with 85% power by setting aom_efficiency=0.15 so the straight beam at 0 deg carries 85% of the power cleanly along y=327!)", "group": null, "part_number": "LB1", "beam": "ECDL1.+1", "distance_mm": 42.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 1.5, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2 (HWP1 before PBS1, [152, 327])", "group": null, "part_number": "WPH05M-780", "beam": "ECDL1.0", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 13.3, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS1 (Cooling split