data: {"type": "final", "design": {"name": "ultrafast_pump_probe_setup", "description": "Generic ultrafast pump-probe setup. An 800 nm, 100 mW pulsed laser is split 50:50 by BS1. The reflected arm (probe) travels up into a two-mirror retroreflector delay stage (M_delay1, M_delay2) and is steered horizontally by M_probe to the Sample. The transmitted arm (pump) goes to M_pump1 and through a bottom U-turn (M_pump1, M_pump2) up to M_pump_fold, which directs the pump at a crossing angle onto the Sample (modelled as a photodiode with a 25 mm aperture to detect both overlapping beams).", "modules": [{"id": "delay_stage", "title": "Retroreflector Delay Stage", "region": [92.0, 165.0, 95.0, 45.0], "description": "Two mirrors on a translation stage providing variable optical delay for the probe arm."}], "baseplate": {"width_mm": 365.0, "height_mm": 215.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "Laser", "label": "Pulsed laser", "group": null, "part_number": "Ti:Sapphire 800 nm", "position": [30.0, 79.0], "direction_deg": 0.0, "wavelength_nm": 800.0, "power_mw": 100.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H"}], "elements": [{"id": "BS1", "type": "beamsplitter", "label": "BS", "group": null, "part_number": "BS010", "beam": "Laser", "distance_mm": 86.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.5, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "M_delay1", "type": "mirror", "label": "Delay M1", "group": null, "part_number": "BB05-E03", "beam": "Laser.r", "distance_mm": 108.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": 25.4, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz