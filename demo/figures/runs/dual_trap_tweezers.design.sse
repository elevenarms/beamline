at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "qpd_backscatter_detection.PD4", "type": "photodiode", "label": "Trap 2 backscatter reference monitor", "group": "qpd_backscatter_detection", "part_number": "PDA36A2", "beam": "qpd_backscatter_detection.L1.r.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "qpd_backscatter_detection.LENS2", "type": "lens", "label": "Trap 2 QPD focusing lens (f=100 mm)", "group": "qpd_backscatter_detection", "part_number": "LA1509-C", "beam": "qpd_backscatter_detection.L1.r.t", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "qpd_backscatter_detection.PD2", "type": "photodiode", "label": "Trap 2 lens-focused QPD", "group": "qpd_backscatter_detection", "part_number": "PDQ80A", "beam": "qpd_backscatter_detection.L1.r.t", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "qpd_backscatter_detection.PD1", "kind": "min_power_mw", "value": 8.0}, {"element_id": "qpd_backscatter_detection.PD2", "kind": "min_power_mw", "value": 8.0}, {"element_id": "qpd_backscatter_detection.PD3", "kind": "min_power_mw", "value": 0.5}, {"element_id": "qpd_backscatter_detection.PD4", "kind": "min_power_mw", "value": 0.5}], "notes": "[qpd_backscatter_detection] U-shaped layout: Fiber collimator L1 launches at (45, 45) along +x to M1 (390, 45), which folds +y to M2 (390, 225) and folds back along -x (180 deg) so both the fiber launch and the QPD detectors (PD1, PD2 at x=70) sit on the left side of the 450x300 mm baseplate. PBS1 separates Trap 1 (H, transmitted along y=225) and Trap 2 (V, reflected down to M3 at y=135 and folded along -x). BS1 and BS2 pick off 10% (2 mW each) to reference photodiodes PD3 and PD4, while LENS1 and LENS2 (f=100 mm) focus the remaining 90% (18 mW each) onto quadrant photodiodes PD1 and PD2 placed at the back focal planes."}, "trace": {"segments": [{"id": "s0", "branch": "qpd_backscatter_detection.L1", "source_id": "qpd_backscatter_detection.L1", "start": [70.0, 445.0], "end": [415.0, 445.0], "direction_deg": 0.0, "length_mm": 345.0, "wavelength_nm": 1064.0, "freq_shift_mhz": 0.0, "power_mw": 40.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 1889.6797916329583, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8132235231740967, "start_element": "qpd_backscatter_detection.L1", "end_element": "qpd_backscatter_detection.M1", "end_reason": "element"}, {"id": "s1", "branch": "qpd_backscatter_d