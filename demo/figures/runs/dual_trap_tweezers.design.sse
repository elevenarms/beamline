n": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "dual_trap_interferometer.FC1", "type": "fiber_coupler", "label": "Trap 1 H-arm fiber coupler", "group": "dual_trap_interferometer", "part_number": "PAF2S-11C", "beam": "dual_trap_interferometer.L1.t.t.t.r", "distance_mm": 120.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 11.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.8, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "dual_trap_interferometer.FC2", "type": "fiber_coupler", "label": "Trap 2 V-arm fiber coupler", "group": "dual_trap_interferometer", "part_number": "PAF2S-11C", "beam": "dual_trap_interferometer.L1.t.r.r.t", "distance_mm": 120.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 11.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.8, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "dual_trap_interferometer.FC1", "kind": "min_power_mw", "value": 450.0}, {"element_id": "dual_trap_interferometer.FC2", "kind": "min_power_mw", "value": 450.0}, {"element_id": "dual_trap_interferometer.PD1", "kind": "min_power_mw", "value": 5.0}], "notes": "[dual_trap_interferometer] U-shaped layout: L1 enters at (50, 70) heading +x (0 deg), expands 2x via LENS1 (-50 mm) and LENS2 (+100 mm) separated by 50 mm (w = 1.30 mm, matched to f=11 mm fiber couplers with MFD=5.8 um for >82% coupling efficiency). S1 picks off 2% (36 mW) to PD1. HWP1 (22.5 deg) + PBS1 splits 882 mW into Trap 1 (H, transmitted) and 882 mW into Trap 2 (V, reflected). Trap 1 folds via M1 and M2 to the upper return path at y=280 heading -x (180 deg) through PBS2; Trap 2 steers via M3 (320, 160), M4 (390, 160), M6 (390, 220), and M7 (320, 220) into PBS2 from below (90 deg) and reflects into the -x return path overlapped with Trap 1. HWP2 (45 deg) swaps H<->V before PBS3 so Trap 1 reflects down to M5 and exits left into FC1 at (60, 190), while Trap 2 transmits straight into FC2 at (60, 280), placing all inputs and outputs on the left side of the U-fold."}, "trace": {"segments": [{"id": "s0", "branch": "dual_trap_interferometer.L1", "source_id": "dual_trap_interferometer.L1", "start": [700.0, 95.0], "end": [760.0, 95.0], "direction_deg": 0.0, "length_mm": 60.0, "wavelength_nm": 1064.0, "freq_shift_mhz": 0.0, "power_mw": 1800.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 1247.483924945195, "w0_mm": 0.65, "w_start_mm": 0.65, "w_end_mm": 0.6507513892883993, "start_element": "dual_trap_interferometer.L1", "end_element": "dual_trap_interferometer.LENS1", "end_reason": "element"}, {"id": "s1", "branch": "dual_trap_interferometer.L1", "source_id": "dual_trap_interferometer.L1", "start": [760.0, 95.0], "end": [810.0, 95.0], "direction_deg": 0.0, "length_mm": 50.0, "wavelength_nm": 1064.0, "freq_shift_mhz": 0.0, "power_mw": 1800.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -49.824652700778465, "rayleigh_mm": 1.9885721551038142, "w0_mm": 0.025951744366156757, "w_start_mm": 0.6507513892883993, "w_end_mm": 1.303014241852819, "start_element": "dual_trap_interferometer.LENS1", "end_element": "dual_trap_interferometer.LENS2", "end_reason": "element"}, {"id": "s2", "branch": "dual_trap_interferometer.L1", "source_id": "dual_trap_interferometer.L1", "start": [810.0, 95.0], "end": [870.0, 95.0], "direction_deg": 0.0, "length_mm": 60.0, "wavelength_nm": 1064.0, "freq_shift_mhz": 0.0, "pow