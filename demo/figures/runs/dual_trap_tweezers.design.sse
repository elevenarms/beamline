data: {"type": "status", "stage": "verify", "message": "[qpd_backscatter_detection] best of 2 candidates: score 100 \u2014 all checks passed", "module_id": "qpd_backscatter_detection"}

data: {"type": "module_done", "module_id": "qpd_backscatter_detection", "design": {"name": "qpd_backscatter_detection", "description": "Dual-Trap Back-Scattered Light Quadrant Photodiode Detection Module (1064 nm, U-shaped layout). Receives 40 mW of combined back-scattered light from Trap 1 and Trap 2 via fiber launch L1 on the left edge, routes it across to the right edge and folds it back in a U-turn with two mirrors so inputs and outputs sit on the left side. A half-wave plate and PBS demultiplex the two trap channels (20 mW each). Each channel passes through a 10:90 beamsplitter sending 10% (2 mW) to a reference monitor photodiode (PD3 for Trap 1, PD4 for Trap 2) and 90% (18 mW) through an f=100 mm focusing lens onto its respective quadrant photodiode (PD1 for Trap 1 QPD, PD2 for Trap 2 QPD).", "modules": [{"id": "qpd_backscatter_detection", "title": "Dual-Trap Back-Scattered Light Quadrant Photodiode Detection Module", "region": [25.0, 400.0, 450.0, 300.0], "description": "Receives the picked-off back-scattered 1064 nm light from the two orthogonally polarized traps, separates the two trap polarizations on a PBS (configured with a HWP to demultiplex Trap 1 and Trap 2), passes each through a 10:90 splitter (sampler/beamsplitter) to a power reference photodiode (PD3, PD4), and focuses each trap's back-scattered beam with an f=100 mm focusing lens onto its own quadrant photodiode (PD1 for Trap 1 QPD, PD2 for Trap 2 QPD)."}], "baseplate": {"width_mm": 1500.0, "height_mm": 725.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "sources": [{"id": "qpd_backscatter_detection.L1", "label": "Backscatter fiber launch (from relay_and_objective_launch)", "group": "qpd_backscatter_detection", "part_number": "PAF2-A7C", "position": [70.0, 445.0], "direction_deg": 0.0, "wavelength_nm": 1064.0, "power_mw": 40.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "qpd_backscatter_detection.M1", "type": "mirror", "label": "U-turn fold mirror 1", "group": "qpd_backscatter_detection", "part_number": "BB1-E03", "beam": "qpd_backscatter_detection.L1", "distance_mm": 345.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "qpd_backscatter_detection.M2", "type": "mirror", "label": "U-turn fold mirror 2", "group": "qpd_backscatter_detection", "part_number": "BB1-E03", "beam": "qpd_backscatter_detection.L1", "distance_mm": 180.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "qpd_backscatter_detection.HWP1", "type": "half_wave_plate", "label": "Demux lambda/2 (balance Trap 1 & Trap 2)", "group": "qpd_backscatter_detection", "part_number": "WPH05M-1064", "beam": "qpd_backscatter_detection.L1", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 22.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "qpd_backscatter_detection.PBS1", "type": "pbs", "label": "Trap 1 / Trap 2 demux PBS", "group": "qpd_backscatter_detection", "part_number": "PBS253", "beam": "qpd_backscatter_detection.L1", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "qpd_backscatter_detection.BS1", "type": "beamsplitter", "label": "Trap 1 10:90 reference pickoff", "group": "qpd_backscatter_detection", "part_number": "BSN11", "beam": "qpd_backscatter_detection.L1.t", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "qpd_backscatter_detection.PD3", "type": "photodiode", "label": "Trap 1 backscatter reference monitor", "group": "qpd_backscatter_detection", "part_number": "PDA36A2", "beam": "qpd_backscatter_detection.L1.t.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "qpd_backscatter_detection.LENS1", "type": "lens", "label": "Trap 1 QPD focusing lens (f=100 mm)", "group": "qpd_backscatter_detection", "part_number": "LA1509-C", "be