ror", "label": "Trap 2 injection mirror", "group": "dual_trap_interferometer", "part_number": "BB1-E03", "beam": "L1.t.r", "distance_mm": 70.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP2", "type": "half_wave_plate", "label": "Channel routing HWP (45 deg, H<->V) ", "group": "dual_trap_interferometer", "part_number": "WPH05M-1064", "beam": "L1.t.t.t", "distance_mm": 70.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS3", "type": "pbs", "label": "Fiber delivery separator PBS", "group": "dual_trap_interferometer", "part_number": "PBS253", "beam": "L1.t.t.t", "distance_mm": 70.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M5", "type": "mirror", "label": "Trap 1 fiber fold mirror", "group": "dual_trap_interferometer", "part_number": "BB1-E03", "beam": "L1.t.t.t.r", "distance_mm": 90.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC1", "type": "fiber_coupler", "label": "Trap 1 H-arm fiber coupler", "group": "dual_trap_interferometer", "part_number": "PAF2S-11C", "beam": "L1.t.t.t.r", "distance_mm": 120.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 11.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.8, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC2", "type": "fiber_coupler", "label": "Trap 2 V-arm fiber coupler", "group": "dual_trap_interferometer", "part_number": "PAF2S-11C", "beam": "L1.t.r.r.t", "distance_mm": 120.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 11.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.8, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "FC1", "kind": "min_power_mw", "value": 450.0}, {"element_id": "FC2", "kind": "min_power_mw", "value": 450.0}, {"element_id": "PD1", "kind": "min_power_mw", "value": 5.0}], "notes": "U-shaped layout: L1 enters at (50, 70) heading +x (0 deg), expands 2x via LENS1 (-50 mm) and LENS2 (+100 mm) separated by 50 mm (w = 1.30 mm, matched to f=11 mm fiber couplers with MFD=5.8 um for >82% coupling efficiency). S1 picks off 2% (36 mW) to PD1. HWP1 (22.5 deg) + PBS1 splits 882 mW into Trap 1 (H, transmitted) and 882 mW into Trap 2 (V, reflected). Trap 1 folds via M1 and M2 to the upper return path at y=280 heading -x (180 deg) through PBS2; Trap 2 steers via M3 (320, 160), M4 (390, 160), M6 (390, 220), and M7 (320, 220) into PBS2 from below (90 deg) and reflects into the -x return path overlapped with Trap 1. HWP2 (45 deg) swaps H<->V before PBS3 so Trap 1 reflects down to M5 and exits left into FC1 at (60, 190), while Trap 2 transmits straight into FC2 at (60, 280), placing all inputs and outputs on the left side of the U-fold."}, "timings": {"candidates_s": 28.1, "repair_s": 22.8, "total_s": 50.9}}

