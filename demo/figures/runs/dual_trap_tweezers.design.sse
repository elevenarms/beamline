data: {"type": "module_done", "module_id": "relay_and_objective_launch", "design": {"name": "relay_and_objective_launch", "description": "250/500 mm 4f Keplerian relay telescope, short-pass dichroic objective launch (FC1), and 10:90 back-scattered light pickoff (FC2) with forward power monitor (PD1) for a 1064 nm dual-trap optical tweezers bench.", "modules": [{"id": "relay_and_objective_launch", "title": "250/500 mm 4f Relay, Short-Pass Dichroic Objective Launch & Backscatter Pickoff", "region": [25.0, 25.0, 600.0, 350.0], "description": "Recombines the two orthogonally polarized trap beams on a PBS, relays them through a f=250 mm / f=500 mm Keplerian 4f telescope onto a short-pass dichroic mirror that reflects 1064 nm into the high-NA objective aperture (modeled as fiber coupler FC1 with mode-matching), and picks off the back-scattered trap light with a sampler/10:90 splitter into fiber coupler FC2 for quadrant photodiode tracking while monitoring forward power on PD1."}], "baseplate": {"width_mm": 1500.0, "height_mm": 725.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "sources": [{"id": "relay_and_objective_launch.L1", "label": "Recombined dual-trap launch (1064 nm, 900 mW from interferometer + PBS2 recombination Stage, w=0.62 mm -> 1.24 mm after 2x relay for mode matching) ", "group": "relay_and_objective_launch", "part_number": "PAF2-A4C", "position": [65.0, 305.0], "direction_deg": 0.0, "wavelength_nm": 1064.0, "power_mw": 900.0, "waist_mm": 0.62, "waist_offset_mm": 310.0, "polarization": "H", "enabled": true}], "elements": [{"id": "relay_and_objective_launch.HWP1", "type": "half_wave_plate", "label": "Input polarization trim lambda/2", "group": "relay_and_objective_launch", "part_number": "WPH05M-1064", "beam": "relay_and_objective_launch.L1", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 0.0, "split_ratio": null, "cutoff_nm": null, "reflect"