": 5.046918393114552e-05, "offset_mm": 0.0}], "coupling_efficiency": 0.9809095654193476, "power_out_mw": 865.1622366998644, "error": null}, {"id": "dual_trap_interferometer.FC2", "type": "fiber_coupler", "placed": true, "position": [709.9999999999999, 305.0000000000001], "angle_deg": 180.0, "hits": [{"segment_id": "s19", "power_in_mw": 882.0000000000002, "w_mm": 1.3317756106653793, "clip_loss": 3.912693565488734e-05, "offset_mm": 0.0}], "coupling_efficiency": 0.9875579131959219, "power_out_mw": 871.0260794388033, "error": null}], "branches": ["dual_trap_interferometer.L1", "dual_trap_interferometer.L1.t", "dual_trap_interferometer.L1.t.t", "dual_trap_interferometer.L1.t.t.t", "dual_trap_interferometer.L1.t.t.t.r", "dual_trap_interferometer.L1.t.r", "dual_trap_interferometer.L1.t.r.r", "dual_trap_interferometer.L1.t.r.r.t", "dual_trap_interferometer.L1.r"], "nonconverged": []}, "report": {"passed": true, "score": 99.92274532260741, "checks": [{"id": "target", "severity": "info", "message": "met: FC1: 865.162 mW (need \u2265 450.000)", "element_id": "FC1", "segment_id": null, "value": 865.1622366998644, "limit": 450.0}, {"id": "target", "severity": "info", "message": "met: FC2: 871.026 mW (need \u2265 450.000)", "element_id": "FC2", "segment_id": null, "value": 871.0260794388033, "limit": 450.0}, {"id": "target", "severity": "info", "message": "met: PD1: 36.000 mW (need \u2265 5.000)", "element_id": "PD1", "segment_id": null, "value": 36.0, "limit": 5.0}], "metrics": {"input_mw": 1800.0, "delivered_mw": 1772.1883161386677, "dumped_mw": 0.0, "stray_mw": 0.0, "n_elements": 18.0, "n_segments": 21.0, "target.FC1.min_power_mw": 865.1622366998644, "target.FC2.min_power_mw": 871.0260794388033, "target.PD1.min_power_mw": 36.0, "delivered_fraction": 0.984549064521482}}, "local_design": {"name": "dual_trap_interferometer", "description": "U-shaped Dual-Trap PBS Split, Steer, and Recombination Module at 1064 nm. Accepts 1.8 W from fiber launch L1, expands the beam 2x with a -50/