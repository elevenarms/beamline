1064 nm, U-shaped layout). Receives 40 mW of combined back-scattered light from Trap 1 and Trap 2 via fiber launch L1 on the left edge, routes it across to the right edge and folds it back in a U-turn with two mirrors so inputs and outputs sit on the left side. A half-wave plate and PBS demultiplex the two trap channels (20 mW each). Each channel passes through a 10:90 beamsplitter sending 10% (2 mW) to a reference monitor photodiode (PD3 for Trap 1, PD4 for Trap 2) and 90% (18 mW) through an f=100 mm focusing lens onto its respective quadrant photodiode (PD1 for Trap 1 QPD, PD2 for Trap 2 QPD).", "modules": [], "baseplate": {"width_mm": 450.0, "height_mm": 300.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "sources": [{"id": "L1", "label": "Backscatter fiber launch (from relay_and_objective_launch)", "group": "qpd_backscatter_detection", "part_number": "PAF2-A7C", "position": [45.0, 45.0], "direction_deg": 0.0, "wavelength_nm": 1064.0, "power_mw": 40.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "M1", "type": "mirror", "label": "U-turn fold mirror 1", "group": "qpd_backscatter_detection", "part_number": "BB1-E03", "beam": "L1", "distance_mm": 345.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "U-turn fold mirror 2", "group": "qpd_backscatter_detection", "part_number": "BB1-E03", "beam": "L1", "distance_mm": 180.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, 