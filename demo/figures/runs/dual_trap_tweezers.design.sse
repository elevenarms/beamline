data: {"type": "status", "stage": "plan", "message": "architecture: 1064 nm Dual-Trap Optical Tweezers and Back-Scatter Quadrant Photodiode Bench \u2014 4 modules on a 1500x725 mm table: 3 W 1064 nm Laser Conditioning & Expansion Module, Dual-Trap PBS Split, Steer, and Recombination Module, 250/500 mm 4f Relay, Short-Pass Dichroic Objective Launch & Backscatter Pickoff, Dual-Trap Back-Scattered Light Quadrant Photodiode Detection Module"}

data: {"type": "modules", "modules": [{"id": "laser_source_1064", "title": "3 W 1064 nm Laser Conditioning & Expansion Module", "region": [500.0, 400.0, 500.0, 250.0], "description": "Isolates the 3 W 1064 nm laser, expands the beam 2x with a f=-50 mm / f=+100 mm Galilean telescope, picks off 5% with a wedged sampler onto photodiode PD1 for laser power stabilization, controls total power with a half-wave plate and PBS (dumping rejected power into BD1), and couples the conditioned beam into PM fiber coupler FC1 via two steering mirrors and a mode-matching lens."}, {"id": "dual_trap_interferometer", "title": "Dual-Trap PBS Split, Steer, and Recombination Module", "region": [650.0, 25.0, 550.0, 350.0], "description": "Collimates the 1064 nm fiber input from laser_source_1064, expands it with a -50/+100 mm telescope, splits the beam with a half-wave plate (at 22.5 deg for 50:50 split) and PBS1 into two orthogonal-polarization arms (Trap 1 H-polarized, Trap 2 V-polarized) each equipped with independent steering mirrors, recombines both arms on PBS2, and couples the two trap paths into PM delivery fibers FC1 and FC2 for relay to the objective module while monitoring split balance on PD1."}, {"id": "relay_and_objective_launch", "title": "250/500 mm 4f Relay, Short-Pass Dichroic Objective Launch & Backscatter Pickoff", "region": [25.0, 25.0, 600.0, 350.0], "description": "Recombines the two orthogonally polarized trap beams on a PBS, relays them through a f=250 mm / f=500 mm Keplerian 4f telescope onto a short-pass dichroic mirror that reflects 1064 nm into the high-NA objective aperture (modeled as fiber coupler FC1 with mode-matching), and picks off the back-scattered trap light with a sampler/10:90 splitter into fiber coupler FC2 for quadrant photodiode tracking while monitoring forward power on PD1."}, {"id": "qpd_backscatter_detection", "title": "Dual-Trap Back-Scattered Light Quadrant Photodiode Detection Module", "region": [25.0, 400.0, 450.0, 300.0], "description": "Receives the picked-off back-scattered 1064 nm light from the two orthogonally polarized traps, separates the two trap polarizations on a PBS (configured with a HWP to demultiplex Trap 1 and Trap 2), passes each through a 10:90 splitter (sampler/beamsplitter) to a power reference photodiode (PD3, PD4), and focuses each trap's back-scattered beam with an f=100 mm focusing lens onto its own quadrant photodiode (PD1 for Trap 1 QPD, PD2 for Trap 2 QPD)."}], "table": {"width_mm": 1500.0, "height_mm": 725.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "links": [{"from_module": "laser_source_1064", "to_module": "dual_trap_interferometer", "purpose": "Deliver isolated, expanded, power-stabilized 1064 nm beam (1.8 W) into the dual-trap interferometer"}, {"from_module": "dual_trap_interferometer", "to_module": "relay_and_objective_launch", "purpose": "Deliver steered Trap 1 and Trap 2 beams to the 250/500 mm relay telescope and short-pass dichroic objective launch"}, {"from_module": "relay_and_objective_launch", "to_module": "qpd_backscatter_detection", "purpose": "Deliver picked-off back-scattered light from both traps to the dual lens-focused quadrant photodiode detection module"}], "title": "1064 nm Dual-Trap Optical Tweezers and Back-Scatter Quadrant Photodiode Bench"}

data: {"type": "status", "stage": "design", "message": "designing 4 modules in parallel (2 candidates each)"}

: ping - 2026-10-25 19:10:39.385317+00:00

