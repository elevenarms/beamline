data: {"type": "final", "design": {"name": "1064 nm Dual-Trap Optical Tweezers and Back-Scatter Quadrant Photodiode Bench", "description": "Four-module 1064 nm optical tweezers architecture: (1) 3 W 1064 nm laser isolation, -50/+100 mm expansion, intensity stabilization pickoff, and PM fiber launch; (2) dual-trap Mach-Zehnder polarization interferometer splitting with HWP + PBS into two steerable trap arms and recombining on a second PBS; (3) 250/500 mm 2x 4f relay telescope and short-pass dichroic launch to the high-NA objective port with 10:90 backscatter pickoff; (4) polarization-resolved back-scattered light detection onto two lens-focused quadrant photodiodes.\nFiber links: laser_source_1064 -> dual_trap_interferometer (Deliver isolated, expanded, power-stabilized 1064 nm beam (1.8 W) into the dual-trap interferometer); dual_trap_interferometer -> relay_and_objective_launch (Deliver steered Trap 1 and Trap 2 beams to the 250/500 mm relay telescope and short-pass dichroic objective launch); relay_and_objective_launch -> qpd_backscatter_detection (Deliver picked-off back-scattered light from both traps to the dual lens-focused quadrant photodiode detection module)", "modules": [{"id": "laser_source_1064", "title": "3 W 1064 nm Laser Conditioning & Expansion Module", "region": [500.0, 400.0, 500.0, 250.0], "description": "Isolates the 3 W 1064 nm laser, expands the beam 2x with a f=-50 mm / f=+100 mm Galilean telescope, picks off 5% with a wedged sampler onto photodiode PD1 for laser power stabilization, controls total power with a half-wave plate and PBS (dumping rejected power into BD1), and couples the conditioned beam into PM fiber coupler FC1 via two steering mirrors and a mode-matching lens."}, {"id": "dual_trap_interferometer", "title": "Dual-Trap PBS Split, Steer, and Recombination Module", "region": [650.0, 25.0, 550.0, 350.0], "description": "Collimates the 1064 nm fiber input from laser_source_1064, expands it with a -50/+100 mm telescope, splits the beam with a half-wave plate (at 22.5 deg for 50:50 split) and PBS1 into two orthogonal-polarization arms (Trap 1 H-polarized, Trap 2 V-polarized) each equipped with independent steering mirrors, recombines both arms on PBS2, and couples the two trap paths into PM delivery fibers FC1 and FC2 for relay to the objective module while monitoring split balance on PD1."}, {"id": "relay_and_objective_launch", "title": "250/500 mm 4f Relay, Short-Pass Dichroic Objective Launch & Backscatter Pickoff", "region": [25.0, 25.0, 600.0, 350.0], "description": "Recombines the two orthogonally polarized trap beams on a PBS, relays them through a f=250 mm / f=500 mm Keplerian 4f telescope onto a short-pass dichroic mirror that reflects 1064 nm into the high-NA objective aperture (modeled as fiber coupler FC1 with mode-matching), and picks off the back-scattered trap light with a sampler/10:90 splitter into fiber coupler FC2 for quadrant photodiode tracking while monitoring forward power on PD1."}, {"id": "qpd_backscatter_detection", "title": "Dual-Trap Back-Scattered Light Quadrant Photodiode Detection Module", "region": [25.0, 400.0, 450.0, 300.0], "description": "Receives the picked-off back-scattered 1064 nm light from the two orthogonally polarized traps, separates the two trap polarizations on a PBS (configured with a HWP to demultiplex Trap 1 and Trap 2), passes each through a 10:90 splitter (sampler/beamsplitter) to a power reference photodiode (PD3, PD4), and focuses each trap's back-scattered beam with an f=100 mm focusing lens onto its own quadrant photodiode (PD1 for Trap 1 QPD, PD2 for Trap 2 QPD)."}], "baseplate": {"width_mm": 1500.0, "height_mm": 725.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "sources": [{"id": "laser_source_1064.L1", "label": "Mephisto 3W 1064nm NPRO", "group": "laser_source_1064", "part_number": "Coherent Mephisto 3000NE", "position": [530.0, 580.0], "direction_deg": 0.0, "wavelength_nm": 1064.0, "power_mw": 3000.0, "waist_mm": 0.52, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "dual_trap_interferometer.L1", "label": "1064 nm Fiber Launch (1.8 W. H-pol) ", "group": "dual_trap_interferometer", "part_number": "PAF2-A7C", "position": [700.0, 95.0], "direction_deg": 0.0, "wavelength_nm": 1064.0, "power_mw": 1800.0, "waist_mm": 0.65, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "relay_and_objective_launch.L1", "label": "Recombined dual-trap launch (1064 nm, 900 mW from interferometer + PBS2 recombination Stage, w=0.62 mm -> 1.24 mm after 2x relay for mode matching) ", "group": "relay_and_objective_launch", "part_number": "PAF2-A4C", "position": [65.0, 305.0], "direction_deg": 0.0, "wavelength_nm": 1064.0, "power_mw": 900.0, "waist_mm": 0.62, "waist_offset_mm": 310.0, "polarization": "H", "enabled": true}, {"id": "qpd_backscatter_detection.L1", "label": "Backscatter fiber launch (from relay_and_objective_launch)", "group": "qpd_backscatter_detection", "part_number": "PAF2-A7C", "position": [70.0, 445.0], "direction_deg": 0.0, "wavelength_nm": 1064.0, "power_mw": 40.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "laser_source_1064.ISO1", "type": "isolator", "label": "Optical Isolator (1064 nm)", "group": "laser_source_1064", "part_number": "IO-3-1064-VHP", "beam": "laser_source_1064.L1", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.92, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "laser_source_1064.LENS1", "type": "lens", "label": "Telescope diverging lens (f=-50 mm)", "group": "laser_source_1064", "part_number": "LC1715-C", "beam": "laser_source_1064.L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": -50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "laser_source_1064.LENS2", "type": "lens", "label": "Telescope collimating lens (f=+100 mm)", "group": "laser_source_1064", "part_number": "LA1509-C", "beam": "laser_source_1064.L1", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "laser_source_1064.S1", "type": "sampler", "label": "5% Wedged beam sampler", "group": "laser_source_1064", "part_number": "BSF10-C", "beam": "laser_source_1064.L1", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "laser_source_1064.PD1", "type": "photodiode", "label": "Power monitor photodiode", "group": "laser_source_1064", "part_number": "PDA100A2", "beam": "laser_source_1064.L1.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "laser_source_1064.HWP1", "type": "half_wave_plate", "label": "Power control lambda/2", "group": "laser_source_1064", "part_number": "WPH05M-1064", "beam": "laser_source_1064.L1.t", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 7.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "laser_source_1064.PBS1", "type": "pbs", "label": "Power control PBS", "group": "laser_source_1064", "part_number": "PBS253", "beam": "laser_source_1064.L1.t", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "laser_source_1064.BD1", "type": "beam_dump", "label": "High-power beam dump (rejected V)", "group": "laser_source_1064", "part_number": "BT610", "beam": "laser_source_1064.L1.t.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_o