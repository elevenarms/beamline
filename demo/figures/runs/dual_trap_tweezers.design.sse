data: {"type": "module_done", "module_id": "dual_trap_interferometer", "design": {"name": "dual_trap_interferometer", "description": "U-shaped Dual-Trap PBS Split, Steer, and Recombination Module at 1064 nm. Accepts 1.8 W from fiber launch L1, expands the beam 2x with a -50/+100 mm Galilean telescope (w0 = 0.65 mm -> 1.30 mm), picks off 2% onto PD1 for split/power monitoring, and splits 50:50 via HWP1 (22.5 deg) and PBS1 into Trap 1 (H) and Trap 2 (V) arms. The two arms are steered around a U-fold to PBS2 for recombination verification, then separated by HWP2 + PBS3 on the return leg so both Trap 1 (FC1) and Trap 2 (FC2) exit on the left side near the input.", "modules": [{"id": "dual_trap_interferometer", "title": "Dual-Trap PBS Split, Steer, and Recombination Module", "region": [650.0, 25.0, 550.0, 350.0], "description": "Collimates the 1064 nm fiber input from laser_source_1064, expands it with a -50/+100 mm telescope, splits the beam with a half-wave plate (at 22.5 deg for 50:50 split) and PBS1 into two orthogonal-polarization arms (Trap 1 H-polarized, Trap 2 V-polarized) each equipped with independent steering mirrors, recombines both arms on PBS2, and couples the two trap paths into PM delivery fibers FC1 and FC2 for relay to the objective module while monitoring split balance on PD1."}], "baseplate": {"width_mm": 1500.0, "height_mm": 725.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "sources": [{"id": "dual_trap_interferometer.L1", "label": "1064 nm Fiber Launch (1.8 W. H-pol) ", "group": "dual_trap_interferometer", "part_number": "PAF2-A7C", "position": [700.0, 95.0], "direction_deg": 0.0, "wavelength_nm": 1064.0, "power_mw": 1800.0, "waist_mm": 0.65, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "dual_trap_interferometer.LENS1", "type": "lens", "label": "Telescope diverging lens f=-50 mm", "group": "dual_trap_interferometer", "part_number": "LC1715-C", "beam": "dual_trap_interferometer.L1", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": -50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "dual_trap_interferometer.LENS2", "type": "lens", "label": "Telescope collimating lens f=+100 mm", "group": "dual_trap_interferometer", "part_number": "LA1509-C", "beam": "dual_trap_interferometer.L1", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "dual_trap_interferometer.S1", "type": "sampler", "label": "Input power & balance pickoff (2%)", "group": "dual_trap_interferometer", "part_number": "BSF10-C", "beam": "dual_trap_interferometer.L1", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.02, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "dual_trap_interferometer.PD1", "type": "photodiode", "label": "Split ratio monitor PD", "group": "dual_trap_interferometer", "part_number": "PDA36A2", "beam": "dual_trap_interferometer.L1.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg"