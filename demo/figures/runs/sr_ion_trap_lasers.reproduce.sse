ngth_nm": 984.0}, {"from": "AOM_984", "to": "EOM_984", "label": "984 nm", "wavelength_nm": 984.0}, {"from": "EOM_984", "to": "M_984", "label": "984 nm", "wavelength_nm": 984.0}, {"from": "M_984", "to": "DM_984_1092", "label": "984 nm", "wavelength_nm": 984.0}, {"from": "L_1092", "to": "M_1092", "label": "1092 nm", "wavelength_nm": 1092.0}, {"from": "M_1092", "to": "DM_984_1092", "label": "1092 nm", "wavelength_nm": 1092.0}, {"from": "DM_984_1092", "to": "TRAP", "label": "984 + 1092 nm", "wavelength_nm": 984.0}, {"from": "L_690", "to": "TC", "label": "690 nm", "wavelength_nm": 690.0}, {"from": "L_422", "to": "TC", "label": "422 nm", "wavelength_nm": 422.0}, {"from": "L_782", "to": "TC", "label": "782 nm", "wavelength_nm": 782.0}, {"from": "L_1092", "to": "TC", "label": "1092 nm", "wavelength_nm": 1092.0}, {"from": "L_984", "to": "TC", "label": "984 nm", "wavelength_nm": 984.0}], "parameters": [{"name": "wavelength_Sr_PI1", "value": "461", "unit": "nm", "evidence": "ECDL 461 nm"}, {"name": "wavelength_Sr_PI2", "value": "405", "unit": "nm", "evidence": "ECDL 405 nm"}, {"name": "wavelength_Th_690", "value": "690", "unit": "nm", "evidence": "ECDL 690 nm"}, {"name": "wavelength_Sr_cool", "value": "422", "unit": "nm", "evidence": "ECDL 422 nm"}, {"name": "wavelength_Rb_ref", "value": "782", "unit": "nm", "evidence": "Rb-stabilized ECDL 782 nm"}, {"name": "wavelength_Sr_repump", "value": "1092", "unit": "nm", "evidence": "DFB 1092 nm"}, {"name": "wavelength_Th_984", "value": "984", "unit": "nm", "evidence": "ECDL 984 nm"}], "notes": "Six lasers converge on a linear Paul ion trap at the center, while four of the lasers (690, 422, 1092, 984 nm) plus a Rb-stabilized 782 nm reference laser are sent to a transfer cavity for frequency stabilization.", "scale_mm_per_px": 0.699, "baseplate_mm": [715, 600]}}

