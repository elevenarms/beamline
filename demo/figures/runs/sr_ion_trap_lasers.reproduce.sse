data: {"type": "final", "design": {"name": "sr_th_ion_trap_laser_setup", "description": "Six-laser optical delivery and transfer-cavity stabilization setup for a Sr+ and Th3+ linear Paul ion trap. Left arm: 690 nm ECDL (through an AOM) and 422 nm ECDL (Sr+ Doppler cooling) are combined on dichroic DM_690_422 and directed into the ion trap. Right arm: 984 nm ECDL (through an AOM) and 1092 nm DFB repumper are combined on dichroic DM_984_1092 and enter the trap counter-propagating along the trap axis. Upper diagonal arm: 461 nm and 405 nm Sr photoionization ECDLs are combined on DM_461_405 and enter the trap at 45 deg. Lower section: pickoffs from the 690, 422, 1092, and 984 nm lasers together with a Rb-stabilized 782 nm reference ECDL are routed to the transfer cavity (TC) for frequency stabilization.", "modules": [{"id": "left_arm", "title": "690 nm & 422 nm Left Delivery Arm", "region": [10.0, 200.0, 240.0, 340.0], "description": "690 nm Th3+ spectroscopy laser (with AOM) and 422 nm Sr+ cooling laser combined on DM_690_422"}, {"id": "upper_pi", "title": "461 nm & 405 nm Sr Photoionization", "region": [180.0, 480.0, 470.0, 110.0], "description": "461 nm and 405 nm ECDLs combined on DM_461_405 for two-step Sr photoionization"}, {"id": "ion_trap", "title": "Linear Paul Ion Trap", "region": [300.0, 260.0, 140.0, 140.0], "description": "Central vacuum chamber and linear Paul trap where all six beams converge"}, {"id": "right_arm", "title": "984 nm & 1092 nm Right Delivery Arm", "region": [340.0, 110.0, 365.0, 260.0], "description": "984 nm Th3+ laser (with AOM) and 1092 nm Sr+ repump DFB laser combined on DM_984_1092"}, {"id": "transfer_cavity", "title": "Transfer Cavity Frequency Stabilization", "region": [10.0, 10.0, 700.0, 160.0], "description": "Rb-stabilized 782 nm reference and pickoffs from 690, 422, 1092, and 984 nm routed to the transfer cavity"}], "baseplate": {"width_mm": 715.0, "height_mm": 600.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L_690", "label": "ECDL 690 nm", "group": "left_arm", "part_number": "Toptica DL pro 690", "position": [60.0, 497.0], "direction_deg": 0.0, "wavelength_nm": 690.0, "power_mw": 10.0, "waist_mm": 0.5, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "L_422", "label": "ECDL 422 nm", "group": "left_arm", "part_number": "Toptica DL pro 422", "position": [114.0, 241.0], "direction_deg": 0.0, "wavelength_nm": 422.0, "power_mw": 15.0, "waist_mm": 0.5, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "L_984", "label": "ECDL 984 nm", "group": "right_arm", "part_number": "Toptica DL pro 984", "position": [683.0, 35.0], "direction_deg": 90.0, "wavelength_nm": 984.0, "power_mw": 15.0, "waist_mm": 0.5, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "L_1092", "label": "DFB 1092 nm", "group": "right_arm", "part_number": "Eagleyard DFB-1092", "position": [373.0, 149.0], "direction_deg": 0.0, "wavelength_nm": 1092.0, "power_mw": 20.0, "waist_mm": 0.5, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "L_461", "label": "ECDL 461 nm", "group": "upper_pi", "part_number": "Toptica DL pro 461", "position": [199.0, 572.0], "direction_deg": 0.0, "wavelength_nm": 461.0, "power_mw": 5.0, "waist_mm": 0.5, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "L_405", "label": "ECDL 405 nm", "group": "upper_pi", "part_number": "Toptica DL pro 405", "position": [368.0, 509.0], "direction_deg": 0.0, "wavelength_nm": 405.0, "power_mw": 2.0, "waist_mm": 0.5, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "L_782", "label": "Rb-stabilized ECDL 782 nm", "group": "transfer_cavity", "part_number": "Toptica DL pro 780", "position": [125.0, 129.0], "direction_deg": -90.0, "wavelength_nm": 782.0, "power_mw": 5.0, "waist_mm": 0.5, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "S_690", "type": "sampler", "label": "690 nm TC pickoff", "group": "left_arm", "part_number": "BSF05-B", "beam": "L_690", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_690_TC", "type": "mirror", "label": "690 nm TC fold mirror", "group": "transfer_cavity", "part_number": "BB05-E03", "beam": "L_690.r", "distance_mm": 469.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_690_1", "type": "mirror", "label": "M_690_1", "group": "left_arm", "part_number": "BB05-E03", "beam": "L_690.t", "distance_mm": 48.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "AOM_690", "type": "aom", "label": "AOM (690 nm)", "group": "left_arm", "part_number": "Isomet 1205C-1", "beam": "L_690.t", "distance_mm": 99.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 4.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_f