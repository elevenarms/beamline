data: {"type": "final", "design": {"name": "backscatter_raman_spectroscopy", "description": "Backscatter (180 deg) Raman spectroscopy setup with a sample chamber (532 nm excitation laser, 50:50 beamsplitter, objective lens, retro-reflecting sample, filter, tube lens) coupled through an entrance slit into a Czerny-Turner spectrometer (collimating mirror, diffraction grating, focusing mirror, and CCD detector).", "modules": [{"id": "sample_chamber", "title": "Sample chamber", "region": [5.0, 5.0, 170.0, 190.0], "description": "Laser delivery, focusing objective, sample, filter, and backscattered signal collection"}, {"id": "spectrometer", "title": "Spectrometer", "region": [5.0, 195.0, 170.0, 140.0], "description": "Czerny-Turner spectrometer with entrance slit, collimating/focusing mirrors, grating, and CCD detector"}], "baseplate": {"width_mm": 200.0, "height_mm": 340.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "Laser", "label": "532 nm Excitation Laser", "group": "sample_chamber", "part_number": "Thorlabs DJ532-40", "position": [151.0, 70.0], "direction_deg": 180.0, "wavelength_nm": 532.0, "power_mw": 50.0, "waist_mm": 0.5, "waist_offset_mm": 0.0, "polarization": "H"}], "elements": [{"id": "BS", "type": "beamsplitter", "label": "Beam splitter", "group": "sample_chamber", "part_number": "BS010", "beam": "Laser", "distance_mm": 111.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.5, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "BD1", "type": "beam_dump", "label": "Transmitted laser dump", "group": "sample_chamber", "part_number": "LB1", "beam": "Laser.t", "distance_mm": 25.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "L1", "type": "lens", "label": "Focussing optics", "group": "sample_chamber", "part_number": "AC127-030-A", "beam": "Laser.r", "distance_mm": 32.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 1000.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "Sample", "type": "mirror", "label": "Sample", "group": "sample_chamber", "part_number": "BB05-E02", "beam": "Laser.r", "distance_mm": 28.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "BD2", "type": "beam_dump", "label": "Return reflected dump", "group": "sample_chamber", "part_number": "LB1", "beam": "Laser.r.r", "distance_mm": 130.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "Filter", "type": "dichroic", "label": "Long-pass filter", "group": "sample_chamber", "part_number": "FELH0550", "beam": "Laser.r.t", "distance_mm": 28.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": 500.0, "reflect": "below", "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "L2", "type": "lens", "label": "Tube lens", "group": "sample_chamber", "part_number": "LA1509-A", "beam": "Laser.r.t.t", "distance_mm": 27.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 1000.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "Slit", "type": "iris", "label": "Entrance slit", "group": "spectrometer", "part_number": "ID5MS", "beam": "Laser.r.t.t", "distance_mm": 81.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 6.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "M1", "type": "mirror", "label": "Collimating mirror", "group": "spectrometer", "part_number": "CM254-100-G01", "beam": "Laser.r.t.t", "distance_mm": 82.0, "at": null, "angle_deg": null, "out_direction_deg": -40.9144, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "Grating", "type": "mirror", "label": "Grating", "group": "spectrometer", "part_number": "GR25-1205", "beam": "Laser.r.t.t", "distance_mm": 79.404, "at": null, "angle_deg": null, "out_direction_deg": 40.9144, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "M2", "type": "mirror", "label": "Focusing mirror", "group": "spectrometer", "part_number": "CM254-100-G01", "beam": "Laser.r.t.t", "distance_mm": 79.404, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}, {"id": "CCD", "type": "photodiode", "label": "CCD detector", "group": "spectrometer", "part_number": "PDA36A2", "beam": "Laser.r.t.t", "distance_mm": 102.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 12.7, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null}], "targets": [{"element_id": "CCD", "kind": "min_power_mw", "value": 5.0}], "notes": "The 532 nm laser (50 mW) is reflected downward by beamsplitter BS through focusing optics L1 onto the Sample (modeled as a retro-reflecting mirror at y=10 mm). Backscattered light returns upward through L1 and transmits through BS (25% of input = 12.5 mW), passes through the long-pass Filter, collection tube lens L2 and entrance slit (Slit), and traverses the folded Czerny-Turner path (M1 -> Grating -> M2) onto the CCD detector. BD2 is placed at x=170 mm (beyond the laser at x=151 mm) so it catches the retro-reflected return branch Laser.r.r without blocking the forward laser beam."}, "report": {"passed": true, "score": 96.25, "checks": [{"id": "target", "severity": "info", "message": "met: CCD: 12.500 mW (need \u2265 5.000)", "element_id": "CCD", "segment_id": null, "value": 12.5, "limit": 5.0}], "metrics"