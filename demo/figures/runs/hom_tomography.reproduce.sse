data: {"type": "final", "design": {"name": "hom_qst_photon_preparation", "description": "Target and probe photon preparation via PPLN SHG/SPDC waveguides followed by Hong-Ou-Mandel quantum state tomography (HOM-QST).", "modules": [{"id": "target_prep", "title": "Target photon preparation", "region": [30.0, 150.0, 630.0, 190.0], "description": "1550 nm pulsed pump -> SHG (775 nm) -> PBS split -> optical delay line (motion stage) -> PPLN/W1 waveguide -> SPF + VHG signal/idler separation into D3 and fiber 1."}, {"id": "probe_prep", "title": "Probe photon preparation", "region": [20.0, 10.0, 490.0, 135.0], "description": "775 nm pump reflected from PBS1 combined at DM with 1535 nm CW seed -> PPLN/W2 waveguide -> SPF + VHG separation into D4 and fiber 2."}, {"id": "hom_qst", "title": "HOM-QST", "region": [530.0, 10.0, 450.0, 200.0], "description": "Two-photon polarization tomography and Hong-Ou-Mandel interference at 50:50 beamsplitter HBS with fiber-coupled detectors D1, D2."}], "baseplate": {"width_mm": 1000.0, "height_mm": 350.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "FC_in1", "label": "Pulse laser 1550 nm (after SHG to 775 nm, fiber collimator) [PL1, SHG]", "group": "target_prep", "part_number": "PAF2-A4B", "position": [60.0, 215.0], "direction_deg": 0.0, "wavelength_nm": 775.0, "power_mw": 40.0, "waist_mm": 0.43, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "FC_in2", "label": "CW laser 1535 nm (fiber collimator) [CWL]", "group": "probe_prep", "part_number": "PAF2-A4C", "position": [110.0, 40.0], "direction_deg": 0.0, "wavelength_nm": 1535.0, "power_mw": 10.0, "waist_mm": 0.43, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "FC_hom1", "label": "HOM input 1 collimator (from FC_out1, 1550 nm) [PPLN/W1]", "group": "hom_qst", "part_number": "PAF2-A4C", "position": [565.0, 180.0], "direction_deg": 0.0, "wavelength_nm": 1550.0, "power_mw": 10.0, "waist_mm": 0.43, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "FC_hom2", "label": "HOM input 2 collimator (from FC_out2, 1550 nm) [PPLN/W2]", "group": "hom_qst", "part_number": "PAF2-A4C", "position": [565.0, 70.0], "direction_deg": 0.0, "wavelength_nm": 1550.0, "power_mw": 10.0, "waist_mm": 0.43, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "L1", "type": "lens", "label": "SHG input lens [L1]", "group": "target_prep", "part_number": "LA1509-B", "beam": "FC_in1", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L2", "type": "lens", "label": "SHG collimating lens [L2]", "group": "target_prep", "part_number": "LA1509-B", "beam": "FC_in1", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP1", "type": "half_wave_plate", "label": "Pump split HWP [HWP1]", "group": "target_prep", "part_number": "WPH05M-780", "beam": "FC_in1", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 22.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmiss