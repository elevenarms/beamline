ed 2x by L1 (f=-50 mm) and L2 (f=+100 mm), split 50:50 at PBS1 via HWP (22.5 deg), steered via tip-tilt mirrors TTM1 and TTM2, recombined at PBS2, relayed by 4f telescope L3-L4 (f=125 mm each), reflected by dichroic DM (reflects >805 nm) into objective obj. At the sample plane (SampleDichroic), the 1064 nm trapping beams are deflected into BD_Trap so they do not block the counter-propagating 532 nm visible illumination VisIllum, which transmits through SampleDichroic (VisIllum.t), obj, and DM (VisIllum.t.t) to the camera detector VisCam."}, "report": {"passed": true, "score": 95.9090909090909, "checks": [{"id": "target", "severity": "info", "message": "met: QPD1: 5.000 mW (need \u2265 2.000)", "element_id": "QPD1", "segment_id": null, "value": 4.999999999999999, "limit": 2.0}, {"id": "target", "severity": "info", "message": "met: QPD2: 5.000 mW (need \u2265 2.000)", "element_id": "QPD2", "segment_id": null, "value": 5.000000000000002, "limit": 2.0}, {"id": "target", "severity": "info", "message": "met: VisCam: 10.000 mW (need \u2265 4.000)", "element_id": "VisCam", "segment_id": null, "value": 10.0, "limit": 4.0}], "metrics": {"input_mw": 110.0, "delivered_mw": 20.0, "dumped_mw": 90.0, "stray_mw": 0.0, "n_elements": 22.0, "n_segments": 32.0, "target.QPD1.min_power_mw": 4.999999999999999, "target.QPD2.min_power_mw": 5.000000000000002, "target.VisCam.min_power_mw": 10.0, "delivered_fraction": 0.18181818181818182}}, "trace": {"segments": [{"id": "s0", "branch": "Laser", "source_id": "Laser", "start": [241.0, 520.0], "end": [240.99999999999997, 420.0], "direction_deg": -90.00000000000001, "length_mm": 100.0, "wavelength_nm": 1064.0, "freq_shift_mhz": 0.0, "power_mw": 100.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 2391.625986285463, "w0_mm": 0.9, "w_start_mm": 0.9000000000000001, "w_end_mm": 0.9007863869407319, "start_element": "Laser", "end_element": "L1", "end_reason": "element"}, {"id": "s1", "branch": "Laser", "