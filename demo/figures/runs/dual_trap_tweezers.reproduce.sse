data: {"type": "final", "design": {"name": "dual_beam_optical_tweezers", "description": "Dual-beam 1064 nm optical tweezers setup with Mach-Zehnder-like polarization splitting/recombination (PBS1, TTM1, TTM2, PBS2), 4f relay (L3, L4) to the objective back focal plane, dichroic coupling (DM) for visible-light imaging, and quadrant photodiode detection modules (BS1/L5/PH1/QPD1 and BS2/L6/PH2/QPD2).", "modules": [], "baseplate": {"width_mm": 950.0, "height_mm": 550.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "Laser", "label": "Laser Source (1064 nm CW, trapping & backscattered simulation via partial retroreflection at trap plane D_Trap_Split if needed, here forward + visible path + backscattered injection at sample plane): 1064 nm CW", "group": null, "part_number": "1064 nm CW Laser", "position": [241.0, 520.0], "direction_deg": 270.0, "wavelength_nm": 1064.0, "power_mw": 100.0, "waist_mm": 0.9, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "VisIllum", "label": "Visible light illumination", "group": null, "part_number": "LED-532", "position": [885.0, 340.0], "direction_deg": 270.0, "wavelength_nm": 532.0, "power_mw": 10.0, "waist_mm": 1.0, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "L1", "type": "lens", "label": "L1 (f=-50 mm, beam expander input: -50mm + 100mm at 50mm separation -> 2x expansion to w=1.8mm): f=-50 mm", "group": null, "part_number": "LC1715-C", "beam": "Laser", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.4, "focal_length_mm": -50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L2", "type": "lens", "label": "L2 (f=+100 mm