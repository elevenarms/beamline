.FC_diag.min_power_mw": 3.9951194678107753, "target.FC_diag.min_coupling": 0.998779866952694, "delivered_fraction": 0.999389933476347}}, "local_design": {"name": "tof_trigger_diagnostics", "description": "TOF Start-Trigger Photodiode & UV Beam Diagnostics Module (compact linear layout). Receives an 8 mW 355 nm auxiliary fiber launch from uv_source_attenuator. A half-wave plate and polarizing beamsplitter split the beam into two branches: (1) the transmitted H-polarized branch stays linear along +x through two steering mirrors into the UV reference fiber coupler FC_diag (mode-matched with w=0.80 mm into f=11 mm, MFD=3.2 um UV single-mode fiber); (2) the reflected V-polarized branch folds along +y, passes a 5% fused-silica sampler (pickoff monitored by PD_mon) and an f=75 mm focusing lens into the fast silicon TOF digitizer start-trigger photodiode PD_tof_trig.", "modules": [], "baseplate": {"width_mm": 450.0, "height_mm": 300.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "sources": [{"id": "L1", "label": "355 nm Aux Fiber Launch (from FC_aux)", "group": "tof_trigger_diagnostics", "part_number": "PAF2-11A", "position": [45.0, 90.0], "direction_deg": 0.0, "wavelength_nm": 355.0, "power_mw": 8.0, "waist_mm": 0.8, "waist_offset_mm": 180.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "Split-Ratio lambda/2 (355 nm)", "group": "tof_trigger_diagnostics", "part_number": "WPH05M-355", "beam": "L1", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 22.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "Trigger / Diagnostics PBS Cube", "group": "tof_trigger_diagnostics", "part_number": "PBS12-355", "beam": "L1", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "Diagnostics Walk Mirror 1", "group": "tof_trigger_diagnostics", "part_number": "PF05-03-F01", "beam": "L1.t", "distance_mm": 110.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "Diagnostics Walk Mirror 2", "group": "tof_trigger_diagnostics", "part_number": "PF05-03-F01", "beam": "L1.t", "distance_mm": 70.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC_diag", "type": "fiber_coupler", "label": "UV Diagnostics Fiber Coupler (SM300)", "group": "tof_trigger_diagnostics", "part_number": "PAF2S-11A", "beam": "L1.t", "distance_mm": 120.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 11.0