data: {"type": "status", "stage": "verify", "message": "[uv_source_attenuator] best of 2 candidates: score 99 \u2014 all checks passed", "module_id": "uv_source_attenuator"}

data: {"type": "module_done", "module_id": "uv_source_attenuator", "design": {"name": "uv_source_attenuator", "description": "355 nm Nd:YAG Source, Primary Variable Attenuator & Energy Monitor module for a MALDI-TOF ion source. Receives a 355 nm pulsed Nd:YAG beam (100 mW average power) through an optical isolator, attenuates pulse energy via a motorized half-wave plate + polarizing beamsplitter (dumping rejected V-polarized light into BD_att), picks off 5% with a wedged UV fused silica sampler to an energy-monitor photodiode (PD_energy), and splits the conditioned H-polarized beam into a two-mirror dogleg feeding the main target-delivery UV fiber (FC_main) and a two-mirror dogleg feeding the auxiliary trigger/diagnostics UV fiber (FC_aux).", "modules": [{"id": "uv_source_attenuator", "title": "355 nm Nd:YAG Source, Primary Variable Attenuator & Energy Monitor", "region": [25.0, 400.0, 500.0, 350.0], "description": "Receives the 355 nm pulsed Nd:YAG laser head through an optical isolator, attenuates the pulse energy with a Motorized Half-Wave Plate + Polarizing Beamsplitter (dumping the rejected V-polarized beam into a beam dump), picks off 5% with a wedged sampler to a pulse-energy photodiode (PD_energy), and splits and couples the conditioned H-polarized beam via two-mirror doglegs into the main target-delivery UV fiber (FC_main) and an auxiliary trigger/diagnostics fiber (FC_aux)."}], "baseplate": {"width_mm": 600.0, "height_mm": 1100.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "sources": [{"id": "uv_source_attenuator.L1", "label": "355 nm Pulsed Nd:YAG Laser Head (100 mW)", "group": "uv_source_attenuator", "part_number": "CryLaS FTSS 355-300", "position": [60.0, 575.0], "direction_deg": 0.0, "wavelength_nm": 355.0, "power_mw": 100.0, "waist_mm": 0.48, "waist_offset_mm": 350.0, "polarization": "H", "enabled": true}], "elements": [{"id": "uv_source_attenuator.ISO1", "type": "isolator", "label": "355 nm High-Power UV Isolator", "group": "uv_source_attenuator", "part_number": "IO-3-355-HP", "beam": "uv_source_attenuator.L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.92, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.HWP_att", "type": "half_wave_plate", "label": "Motorized Attenuator lambda/2 (355 nm)", "group": "uv_source_attenuator", "part_number": "WPH05M-355", "beam": "uv_source_attenuator.L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 10.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.PBS_att", "type": "pbs", "label": "High-Energy UV Attenuator PBS", "group": "uv_source_attenuator", "part_number": "PBS10-355", "beam": "uv_source_attenuator.L1", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.BD_att", "type": "beam_dump", "label": "Rejected Pulse Energy Dump", "group": "uv_source_attenuator", "part_number": "BT610", "beam": "uv_source_attenuator.L1.r", "distance_mm": 75.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.S_mon", "type": "sampler", "label": "5% UV Fused Silica Wedged Sampler", "group": "uv_source_attenuator", "part_number": "BSF05-UV", "beam": "uv_source_attenuator.L1.t", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.PD_energy", "type": "photodiode", "label": "5% Primary Pulse-Energy Monitor PD", "group": "uv_source_attenuator", "part_number": "PDA25K2", "beam": "uv_source_attenuator.L1.t.r", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.BS_split", "type": "beamsplitter", "label": "85:15 Main/Aux Branch Splitter", "group": "uv_source_attenuator", "part_number": "BS010-UV", "beam": "uv_source_attenuator.L1.t.t", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.15, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.M_main1", "type": "mirror", "label": "Main Delivery Dogleg Mirror 1", "group": "uv_source_attenuator", "part_number": "NB05-K08", "beam": "uv_source_attenuator.L1.t.t.t", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.M_main2", "type": "mirror", "label": "Main Delivery Dogleg Mirror 2", "group": "uv_source_attenuator", "part_number": "NB05-K08", "beam": "uv_source_attenuator.L1.t.t.t", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.FC_main", "type": "fiber_coupler", "label": "Main MALDI Ablation Fiber Coupler", "group": "uv_source_attenuator", "part_number": "PAF2S-11A", "beam": "uv_source_attenuator.L1.t.t.t", "distance_mm": 75.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 11.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.0, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.M_aux1", "type": "mirror", "label": "Aux Diagnostics Dogleg Mirror 1", "group": "uv_source_attenuator", "part_number": "NB05-K08", "beam": "uv_source_attenuator.L1.t.t.r", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.M_aux2", "type": "mirror", "label": "Aux Diagnostics Dogleg Mirror 2", "group": "uv_source_attenuator", "part_number": "NB05-K08", "beam": "uv_source_attenuator.L1.t.t.r", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.FC_aux", "type": "fiber_coupler", "label": "TOF Trigger & Diagnostics Fiber Coupler", "group": "uv_source_attenuator", "part_number": "PAF2S-11A", "beam": "uv_source_attenuator.L1.t.t.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 11.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.0, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "uv_source_attenuator.FC_main", "kind": "min_power_mw", "value": 35.0}, {"element_id": "uv_source_attenuator.FC_main", "kind": "min_coupling", "value": 0.65}, {"element_id": "uv_source_attenuator.FC_aux", "kind": "min_power_mw", "value": 5.0}, {"element_id": "uv_source_attenuator.PD_energy", "kind": "min_power_mw", "value": 2.0}], "notes": "[uv_source_attenuator] Compact linear layout along y = 175 mm. L1 (100 mW @ 355 nm, waist 0.48 mm matched to f=11 mm coupler for MFD=5.0 um: w = f*lambda/(pi*w_f) = 11*0.355e-3/(pi*2.5e-3) = 0.497 mm) passes through ISO1 (92 mW), HWP_att (10 deg -> 88.3% H, 11.7% V) and PBS_att (dumps ~10.8 mW V into BD_att, transmits ~81.2 mW H). S_mon picks off 5% (~4.06 mW) to PD_energy. BS_split divides the remaining ~77.2 mW into 85% (~65.6 mW) transmitted to the M_main1/M_main2 two-mirror dogleg into FC_main (~62 mW coupled, >95% coupling efficiency) and 15% (~11.6 mW) reflected to the M_aux1/M_aux2 two-mirror dogleg into FC_aux (~11 mW coupled)."}, "trace": {"segments": [{"id": "s0", "branch": "uv_source_attenuator.L1", "source_id": "uv_source_attenuator.L1", "start": [60.0, 575.0], "end": [115.0, 575.0], "direction_deg": 0.0, "length_mm": 55.0, "wavelength_nm": 355.0, "freq_shift_mhz": 0.0, "power_mw": 100.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 350.0, "rayleigh_mm": 2038.937879963629, "w0_mm": 0.48, "w_start_mm": 0.4870206099372642, "w_end_mm": 0.48499795251982236, "start_element": "uv_source_attenuator.L1", "end_element": "uv_source_attenuator.ISO1", "end_reason": "element"}, {"id": "s1", "branch": "uv_source_attenuator.L1", "source_id": "uv_source_attenuator.L1", "start": [115.0, 575.0], "end": [170.0, 575.0], "direction_deg": 0.0, "length_mm": 55.0, "wavelength_nm": 355.0, "freq_shift_mhz": 0.0, "power_mw": 92.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 295.0, "rayleigh_mm": 2038.937879963629, "w0_mm": 0.48, "w_start_mm": 0.48499795251982236, "w_end_mm": 0.48331382200608686, "start_element": "uv_source_attenuator.ISO1", "end_element": "uv_source_attenuator.HWP_att", "end_reason": "element"}, {"id": "s2", "branch": "uv_source_attenuator.L1", "source_id": "uv_source_attenuator.L1", "start": [170.0, 575.0], "end": [215.0, 575.0], "direction_deg": 0.0, "length_mm": 45.0, "wavelength_nm": 355.0, "freq_shift_mhz": 0.0, "power_mw": 92.0, "jones": [[0.9396926207859084, 0.0], [0.3420201433256687, -2.228674911895085e-17]], "polarization_label": "linear 20\u00b0", "waist_z_mm": 240.0, "rayleigh_mm": 2038.937879963629, "w0_mm": 0.48, "w_start_mm": 0.48331382200608686, "w_end_mm": 0.48219019499255056, "start_element": "uv_source_attenuator.HWP_att", "end_element": "uv_source_attenuator.PBS_att", "end_reason": "element"}, {"id": "s3", "branch": "uv_source_attenuator.L1.t", "source_id": "uv_source_attenuator.L1", "start": [215.0, 575.0], "end": [270.0, 575.0], "direction_deg": 0.0, "length_mm": 55.0, "wavelength_nm": 355.0, "freq_shift_mhz": 0.0, "power_mw": 81.238044383473, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 195.0, "rayleigh_mm": 2038.937879963629, "w0_mm": 0.48, "w_start_mm": 0.48219019499255056, "w_end_mm": 0.48113018188488904, "start_element": "uv_source_attenuator.PBS_att", "end_element": "uv_source_attenuator.S_mon", "end_reason": "element"}, {"id": "s4", "branch": "uv_source_attenuator.L1.t.t", "source_id": "uv_source_attenuator.L1", "start": [270.0, 575.0], "end": [325.0, 575.0], "direction_deg": 0.0, "length_mm": 55.0, "wavelength_nm": 355.0, "freq_shift_mhz": 0.0, "power_mw": 77.17614216429934, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 140.0, "rayleigh_mm": 2038.937879963629, "w0_mm": 0.48, "w_st