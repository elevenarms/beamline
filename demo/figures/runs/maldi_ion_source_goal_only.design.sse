ll, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_aux1", "type": "mirror", "label": "Aux Diagnostics Dogleg Mirror 1", "group": "uv_source_attenuator", "part_number": "NB05-K08", "beam": "L1.t.t.r", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_aux2", "type": "mirror", "label": "Aux Diagnostics Dogleg Mirror 2", "group": "uv_source_attenuator", "part_number": "NB05-K08", "beam": "L1.t.t.r", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC_aux", "type": "fiber_coupler", "label": "TOF Trigger & Diagnostics Fiber Coupler", "group": "uv_source_attenuator", "part_number": "PAF2S-11A", "beam": "L1.t.t.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 11.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.0, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "FC_main", "kind": "min_power_mw", "value": 35.0}, {"element_id": "FC_main", "kind": "min_coupling", "value": 0.65}, {"element_id": "FC_aux", "kind": "min_power_mw", "value": 5.0}, {"element_id": "PD_energy", "kind": "min_power_mw", "value": 2.0}], "notes": "Compact linear layout along y = 175 mm. L1 (100 mW @ 355 nm, waist 0.48 mm matched to f=11 mm coupler for MFD=5.0 um: w = f*lambda/(pi*w_f) = 11*0.355e-3/(pi*2.5e-3) = 0.497 mm) passes through ISO1 (92 mW), HWP_att (10 deg -> 88.3% H, 11.7% V) and PBS_att (dumps ~10.8 mW V into BD_att, transmits ~81.2 mW H). S_mon picks off 5% (~4.06 mW) to PD_energy. BS_split divides the remaining ~77.2 mW into 85% (~65.6 mW) transmitted to the M_main1/M_main2 two-mirror dogleg into FC_main (~62 mW coupled, >95% coupling efficiency) and 15% (~11.6 mW) reflected to the M_aux1/M_aux2 two-mirror dogleg into FC_aux (~11 mW coupled)."}, "timings": {"candidates_s": 23.4, "repair_s": 0.0, "total_s": 23.4}}

