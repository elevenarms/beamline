efficiency": 0.9996359165852525, "power_out_mw": 37.735456114038456, "error": null}], "branches": ["maldi_expander_delivery.L1", "maldi_expander_delivery.L1.t", "maldi_expander_delivery.L1.t.t", "maldi_expander_delivery.L1.t.r", "maldi_expander_delivery.L1.r"], "nonconverged": []}, "report": {"passed": true, "score": 99.41358401250525, "checks": [{"id": "target", "severity": "info", "message": "met: PD_target_mon: 1.987 mW (need \u2265 1.200)", "element_id": "PD_target_mon", "segment_id": null, "value": 1.9867999985088503, "limit": 1.2}, {"id": "target", "severity": "info", "message": "met: FC_target: 37.735 mW (need \u2265 20.000)", "element_id": "FC_target", "segment_id": null, "value": 37.735456114038456, "limit": 20.0}, {"id": "target", "severity": "info", "message": "met: FC_target: polarization H (need H, overlap 100.0%)", "element_id": "FC_target", "segment_id": null, "value": 1.0, "limit": null}], "metrics": {"input_mw": 45.0, "delivered_mw": 39.722256112547306, "dumped_mw": 5.264000029822993, "stray_mw": 0.0, "n_elements": 10.0, "n_segments": 10.0, "target.PD_target_mon.min_power_mw": 1.9867999985088503, "target.FC_target.min_power_mw": 37.735456114038456, "target.FC_target.polarization": 1.0, "delivered_fraction": 0.8827168025010512}}, "local_design": {"name": "maldi_expander_delivery", "description": "3x Galilean Beam Expander, Fine Attenuator & f=150 mm MALDI Target Delivery in a U-shaped layout. Launches 355 nm light from FC_main (45 mW, waist 0.5 mm), passes a fine trim variable attenuator (HWP + PBS with beam dump on the rejected port) and a 5% wedged sampler to local energy-monitor photodiode PD_target_mon, expands the beam 3x using a Galilean beam expander (f1 = -50 mm plano-concave + f2 = +150 mm plano-convex separated by 100 mm), folds the expanded beam back via two broadband UV mirrors into a U-shape, and focuses it through an f = 150 mm lens onto the MALDI sample target (terminated at FC_target with f=150 mm, MFD=22.6 um mode-matched to the 11.3 um focused spot radius).", "modules": [], "baseplate": {"width_mm": 550.0, "height_mm": 350.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "sources": [{"id": "L1", "label": "FC_main fiber launch (355 nm from uv_source_attenuator, 45 mW, w0=0.5 mm @ +260 mm at L_exp1, H-pol) [PAF2S-11A]", "group": "maldi_expander_delivery", "part_number": "PAF2S-11A", "position": [40.0, 90.0], "direction_deg": 0.0, "wavelength_nm": 355.0, "power_mw": 45.0, "waist_mm": 0.5, "waist_offset_mm": 260.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP_trim", "type": "half_wave_plate", "label": "Fine trim lambda/2 plate (fast axis 10 deg -> 88.3% H transmitted, 11.7% V dumped) [WPH05M-355]", "group": "maldi_expander_delivery", "part_number": "WPH05M-355", "beam": "L1", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 10.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS_trim", "type": "pbs", "label": "Fine trim polarizing beamsplitter cube [PBS10-355]", "group": "maldi_expander_delivery", "part_number": "PBS10-355", "beam": "L1", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_trim", "type": "beam_dump", "label": "Rejected V-polarization beam dump [LB1]", "group": "maldi_expander_delivery", "part_number": "LB1", "beam": "L1.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S_mon", "type": "sampler", "label": "5% UV wedged pickoff sampler [BSF10-UV]", "group": "maldi_expander_delivery", "part_number": "BSF10-UV", "beam": "L1.t", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_target_mon", "type": "photodiode", "label": "On-target 5% pulse energy monitor photodiode (~1.99 mW) [PDA25K2]", "group": "maldi_expander_delivery", "part_number": "PDA25K2", "beam": "L1.t.r", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L_exp1", "type": "lens", "label": "Galilean expander diverging lens f1 = -50 mm [LC4252-UV]", "group": "maldi_expander_delivery", "part_number": "LC4252-UV", "beam": "L1.t.t", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": -50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L_exp2", "type": "lens", "label": "Galilean expander collimating lens f2 = +150 mm (3x expansion to w=1.5 mm) [LA4874-UV]", "group": "maldi_expander_delivery", "part_number": "LA4874-UV", "beam": "L1.t.t", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 150.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "UV steering mirror 1 (90 deg CCW fold to +y) [NB1-K08]", "group": "maldi_expander_delivery", "part_number": "NB1-K08", "beam": "L1.t.t", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "UV steering mirror 2 (90 deg CCW fold to -x, completing U-turn) [NB1-K08]", "group": "maldi_expander_delivery", "part_number": "NB1-K08", "beam": "L1.t.t", "distance_mm": 170.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC_target", "type": "fiber_coupler", "label": "f = 150 mm MALDI Target Focusing Lens & Sample Target Assembly (focused waist 11.3 um, MFD 22.6 um) [LA4874-UV]", "group": "maldi_expander_delivery", "part_number": "LA4874-UV", "beam": "L1.t.t", "distance_mm": 360.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.4, "focal_length_mm": 150.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 22.6, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD_target_mon", "kind": "min_power_mw", "value": 1.2}, {"element_id": "FC_target", "kind": "min_power_mw", "value": 20.0}, {"element_id": "FC_target", "kind": "polarization", "value": "H"}], "notes": "U-shaped layout on 550x350 mm baseplate: input FC_main launches at (40, 90) along +x; HWP_trim at (100, 90) with fast_axis_deg=10 deg rotates 45 mW H-polarized 355 nm beam to 20 deg linear so PBS_trim at (160, 90) transmits 39.74 mW (H) and reflects 5.26 mW (V) down into BD_trim at (160, 40). S_mon at (220, 90) picks off 5% (1.99 mW) upward into PD_target_mon at (220, 150). The transmitted 37.75 mW beam enters the 3x Galilean beam expander: L_exp1 (f1 = -50 mm) at (300, 90) and L_exp2 (f2 = +150 mm) at (400, 90), separated by f1 + f2 = 100 mm, expanding the collimated waist from 0.5 mm to 1.5 mm. M1 at (480, 90) folds the beam +90 deg to +y, and M2 at (480, 260) folds it +90 deg to -x (180 deg) so the output return arm runs parallel to the input arm. Two 90 deg reflections invert Ex twice ((-1)^2 = +1), preserving pure H polarization. FC_target at (120, 260) integrates the f = 150 mm MALDI target focusing lens (focal_length_mm=150.0, aperture_mm=25.4) and target plane (fiber_mfd_um=22.6 matching 2*w_focus = 2*lambda*f/(pi*w_in) = 22.6 um), delivering >34 mW coupled H-polarized UV power onto the MALDI target with zero stray beams."}, "timings": {"candidates_s": 23.3, "repair_s": 0.0, "total_s": 23.3}}

