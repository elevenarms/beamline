data: {"type": "final", "design": {"name": "355 nm Pulsed Nd:YAG MALDI-TOF Ion Source Optical System", "description": "Modular optical layout for a 355 nm third-harmonic Nd:YAG MALDI-TOF mass spectrometer ion source. Module 1 handles the 355 nm laser head, optical isolation, a primary variable attenuator (HWP + PBS with beam dump), a 5% energy-monitor sampler to a photodiode, and fiber coupling into a UV solarization-resistant patch fiber and an auxiliary calibration/timing branch. Module 2 receives the main UV fiber launch, passes a fine secondary HWP+PBS variable attenuator and 5% pulse-energy monitor, expands the beam via a 3x Galilean telescope, steers it with a two-mirror dogleg, and focuses it with an f = 150 mm lens onto the MALDI sample target (modeled as a target coupler/detector). Module 3 receives the auxiliary calibration branch for time-of-flight trigger generation, beam-profile inspection, and automated alignment diagnostics.\nFiber links: uv_source_attenuator -> maldi_expander_delivery (Delivers primary attenuated 355 nm pulsed Nd:YAG beam to the 3x Galilean expander and f=150 mm MALDI sample target focusing stage); uv_source_attenuator -> tof_trigger_diagnostics (Delivers auxiliary 355 nm pickoff pulses for sub-nanosecond TOF digitizer start triggering and beam diagnostics)", "modules": [{"id": "uv_source_attenuator", "title": "355 nm Nd:YAG Source, Primary Variable Attenuator & Energy Monitor", "region": [25.0, 400.0, 500.0, 350.0], "description": "Receives the 355 nm pulsed Nd:YAG laser head through an optical isolator, attenuates the pulse energy with a Motorized Half-Wave Plate + Polarizing Beamsplitter (dumping the rejected V-polarized beam into a beam dump), picks off 5% with a wedged sampler to a pulse-energy photodiode (PD_energy), and splits and couples the conditioned H-polarized beam via two-mirror doglegs into the main target-delivery UV fiber (FC_main) and an auxiliary trigger/diagnostics fiber (FC_aux)."}, {"id": "maldi_expander_delivery", "title": "3x Galilean Beam Expander, Fine Attenuator & f=150 mm MALDI Target Delivery", "region": [25.0, 25.0, 550.0, 350.0], "description": "Launches the conditioned 355 nm beam from fiber FC_main, passes a fine trim variable attenuator (HWP + PBS with beam dump on the rejected port) and a 5% wedged sampler to a local energy-monitor photodiode (PD_target_mon), expands the beam 3x using a Galilean beam expander (f1 = -50 mm plano-concave lens + f2 = +150 mm plano-convex lens separated by 100 mm), steers the expanded beam via two broadband UV mirrors, and focuses it through an f = 150 mm lens directly onto the MALDI sample target (terminated at target coupler/detector FC_target)."}, {"id": "tof_trigger_diagnostics", "title": "TOF Start-Trigger Photodiode & UV Beam Diagnostics Module", "region": [25.0, 775.0, 450.0, 300.0], "description": "Receives the auxiliary 355 nm pickoff fiber from uv_source_attenuator, splits the beam with a HWP + PBS into a fast time-of-flight (TOF) digitizer start-trigger photodiode branch (with a focusing lens and sampler dump) and a continuous UV power-stability & spatial reference fiber coupler (FC_diag) with two steering mirrors."}], "baseplate": {"width_mm": 600.0, "height_mm": 1100.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "sources": [{"id": "uv_source_attenuator.L1", "label": "355 nm Pulsed Nd:YAG Laser Head (100 mW)", "group": "uv_source_attenuator", "part_number": "CryLaS FTSS 355-300", "position": [60.0, 575.0], "direction_deg": 0.0, "wavelength_nm": 355.0, "power_mw": 100.0, "waist_mm": 0.48, "waist_offset_mm": 350.0, "polarization": "H", "enabled": true}, {"id": "maldi_expander_delivery.L1", "label": "FC_main fiber launch (355 nm from uv_source_attenuator, 45 mW, w0=0.5 mm @ +260 mm at L_exp1, H-pol) [PAF2S-11A]", "group": "maldi_expander_delivery", "part_number": "PAF2S-11A", "position": [65.0, 115.0], "direction_deg": 0.0, "wavelength_nm": 355.0, "power_mw": 45.0, "waist_mm": 0.5, "waist_offset_mm": 260.0, "polarization": "H", "enabled": true}, {"id": "tof_trigger_diagnostics.L1", "label": "355 nm Aux Fiber Launch (from FC_aux)", "group": "tof_trigger_diagnostics", "part_number": "PAF2-11A", "position": [70.0, 865.0], "direction_deg": 0.0, "wavelength_nm": 355.0, "power_mw": 8.0, "waist_mm": 0.8, "waist_offset_mm": 180.0, "polarization": "H", "enabled": true}], "elements": [{"id": "uv_source_attenuator.ISO1", "type": "isolator", "label": "355 nm High-Power UV Isolator", "group": "uv_source_attenuator", "part_number": "IO-3-355-HP", "beam": "uv_source_attenuator.L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.92, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.HWP_att", "type": "half_wave_plate", "label": "Motorized Attenuator lambda/2 (355 nm)", "group": "uv_source_attenuator", "part_number": "WPH05M-355", "beam": "uv_source_attenuator.L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 10.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "uv_source_attenuator.PBS_att", "type": "pbs", "label": "High-Energy UV Attenuator PBS", "group": "uv_source_attenuator", "part_number": "PBS10-355", "beam": "uv_source_attenuator.L1", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axi