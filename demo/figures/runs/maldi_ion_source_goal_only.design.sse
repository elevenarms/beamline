data: {"type": "module_done", "module_id": "maldi_expander_delivery", "design": {"name": "maldi_expander_delivery", "description": "3x Galilean Beam Expander, Fine Attenuator & f=150 mm MALDI Target Delivery in a U-shaped layout. Launches 355 nm light from FC_main (45 mW, waist 0.5 mm), passes a fine trim variable attenuator (HWP + PBS with beam dump on the rejected port) and a 5% wedged sampler to local energy-monitor photodiode PD_target_mon, expands the beam 3x using a Galilean beam expander (f1 = -50 mm plano-concave + f2 = +150 mm plano-convex separated by 100 mm), folds the expanded beam back via two broadband UV mirrors into a U-shape, and focuses it through an f = 150 mm lens onto the MALDI sample target (terminated at FC_target with f=150 mm, MFD=22.6 um mode-matched to the 11.3 um focused spot radius).", "modules": [{"id": "maldi_expander_delivery", "title": "3x Galilean Beam Expander, Fine Attenuator & f=150 mm MALDI Target Delivery", "region": [25.0, 25.0, 550.0, 350.0], "description": "Launches the conditioned 355 nm beam from fiber FC_main, passes a fine trim variable attenuator (HWP + PBS with beam dump on the rejected port) and a 5% wedged sampler to a local energy-monitor photodiode (PD_target_mon), expands the beam 3x using a Galilean beam expander (f1 = -50 mm plano-concave lens + f2 = +150 mm plano-convex lens separated by 100 mm), steers the expanded beam via two broadband UV mirrors, and focuses it through an f = 150 mm lens directly onto the MALDI sample target (terminated at target coupler/detector FC_target)."}], "baseplate": {"width_mm": 600.0, "height_mm": 1100.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "sources": [{"id": "maldi_expander_delivery.L1", "label": "FC_main fiber launch (355 nm from uv_source_attenuator, 45 mW, w0=0.5 mm @ +260 mm at L_exp1, H-pol) [PAF2S-11A]", "group": "maldi_expander_delivery", "part_number": "PAF2S-11A", "position": [65.0, 115.0], "direction_deg": 0.0, "wavelength_nm": 355.0, "power_mw": 45.0, "waist_mm": 0.5, "waist_offset_mm": 260.0, "polarization": "H", "enabled": true}], "elements": [{"id": "maldi_expander_delivery.HWP_trim", "type": "half_wave_plate", "label": "Fine trim lambda/2 plate (fast axis 10 deg -> 88.3% H transmitted, 11.7% V dumped) [WPH05M-355]", "group": "maldi_expander_delivery", "part_number": "WPH05M-355", "beam": "maldi_expander_delivery.L1", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 10.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "maldi_expander_delivery.PBS_trim", "type": "pbs", "label": "Fine trim polarizing beamsplitter cube [PBS10-355]", "group": "maldi_expander_delivery", "part_number": "PBS10-355", "beam": "maldi_expander_delivery.L1", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "maldi_expander_delivery.BD_trim", "type": "beam_dump", "label": "Rejected V-polarization beam dump [LB1]", "group": "maldi_expander_delivery", "part_number": "LB1", "beam": "maldi_expander_delivery.L1.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "maldi_expander_delivery.S_mon", "type": "sampler", "label": "5% UV wedged pickoff sampler [BSF10-UV]", "group": "maldi_expander_delivery", "part_number": "BSF10-UV", "beam": "maldi_expander_delivery.L1.t", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "maldi_expander_delivery.PD_target_mon", "type": "photodiode", "label": "On-target 5% pulse energy monitor photodiode (~1.99 mW) [PDA25K2]", "group": "maldi_expander_delivery", "part_number": "PDA25K2", "beam": "maldi_expander_delivery.L1.t.r", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "maldi_expander_delivery.L_exp1", "type": "lens", "label": "Galilean expander diverging lens f1 = -50 mm [LC4252-UV]", "group": "maldi_expander_delivery", "part_number": "LC4252-UV", "beam": "maldi_expander_delivery.L1.t.t", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": -50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "maldi_expander_delivery.L_exp2", "type": "lens", "label": "Galilean expander collimating lens f2 = +150 mm (3x expansion to w=1.5 mm) [LA4874-UV]", "group": "maldi_expander_delivery", "part_number": "LA4874-UV", "beam": "maldi_expander_delivery.L1.t.t", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 150.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "maldi_expander_delivery.M1", "type": "mirror", "label": "UV steering mirror 1 (90 deg CCW fold to +y) [NB1-K08]", "group": "maldi_expander_delivery", "part_number": "NB1-K08", "beam": "maldi_expander_delivery.L1.t.t", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "maldi_expander_delivery.M2", "type": "mirror", "label": "UV steering mirror 2 (90 deg CCW fold to -x, completing U-turn) [NB1-K08]", "group": "maldi_expander_delivery", "part_number": "NB1-K08", "beam": "maldi_expander_delivery.L1.t.t", "distance_mm": 170.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "maldi_expander_delivery.FC_target", "type": "fiber_coupler", "label": "f = 150 mm MALDI Target Focusing Lens & Sample Target Assembly (focused waist 11.3 um, MFD 22.6 um) [LA4874-UV]", "group": "maldi_expander_delivery", "part_number": "LA4874-UV", "beam": "maldi_expander_delivery.L1.t.t", "distance_mm": 360.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.4, "focal_length_mm": 150.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 22.6, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "maldi_expander_delivery.PD_target_mon", "kind": "min_power_mw", "value": 1.2}, {"element_id": "maldi_expander_delivery.FC_target", "kind": "min_power_mw", "value": 20.0}, {"element_id": "maldi_expander_delivery.FC_target", "kind": "polarization", "value": "H"}], "notes": "[maldi_expander_delivery] U-shaped layout on 550x350 mm baseplate: input FC_main launches at (40, 90) along +x; HWP_trim at (100, 90) with fast_axis_deg=10 deg rotates 45 mW H-polarized 355 nm beam to 20 deg linear so PBS_trim at (160, 90) transmits 39.74 mW (H) and reflects 5.26 mW (V) down into BD_trim at (160, 40). S_mon at (220, 90) picks off 5% (1.99 mW) upward into PD_target_mon at (220, 150). The transmitted 37.75 mW beam enters the 3x Galilean beam expander: L_exp1 (f1 = -50 mm) at (300, 90) and L_exp2 (f2 = +150 mm) at (400, 90), separated by f1 + f2 = 100 mm, expanding the collimated waist from 0.5 mm to 1.5 mm. M1 at (480, 90) folds the beam +90 deg to +y, and M2 at (480, 260) folds it +90 deg to -x (180 deg) so the output return arm runs parallel to the input arm. Two 90 deg reflections invert Ex twice ((-1)^2 = +1), preserving pure H polarization. FC_target at (120, 260) integrates the f = 150 mm MALDI target focusing lens (focal_length_mm=150.0, aperture_mm=25.4) and target plane (fiber_mfd_um=22.6 matching 2*w_focus = 2*lambda*f/(pi*w_in) = 22.6 um), delivering >34 mW coupled H-polarized UV power onto the MALDI target with zero stray beams."}, "trace": {"segments": [{"id": "s0", "branch": "maldi_expander_delivery.L1", "source_id": "maldi_expander_delivery.L1", "start": [65.0, 115.0], "end": [125.0, 115.0], "direction_deg": 0.0, "length_mm": 60.0, "wavelength_nm": 355.0, "freq_shift_mhz": 0.0, "power_mw": 45.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 260.0, "rayleigh_mm": 2212.3891926688684, "w0_mm": 0.5, "w_start_mm": 0.503440898404539, "w_end_mm": 0.5020388833018455, "start_element": "maldi_expander_delivery.L1", "end_element": "maldi_expander_delivery.HWP_trim", "end_reason": "element"}, {"id": "s1", "branch": "maldi_expander_delivery.L1", "source_id": "maldi_expander_delivery.L1", "start": [125.0, 115.0], "end": [185.0, 115.0], "direction_deg": 0.0, "length_mm": 60.0, "wavelength_nm": 355.0, "freq_shift_mhz": 0.0, "power_mw": 45.0, "jones": [[0.9396926207859084, 0.0], [0.3420201433256687, -2.228674911895085e-17]], "polarization_label": "linear 20\u00b0", "waist_z_mm": 200.0, "rayleigh_mm": 2212.3891926688684, "w0_mm": 0.5, "w_start_mm": 0.5020388833018455, "w_end_mm": 0.5010000895908228, "start_element": "maldi_expander_delivery.HWP_trim", "end_element": "maldi_expander_delivery.PBS_trim", "end_reason": "element"}, {"id": "s2", "branch": "maldi_expander_delivery.L1.t", "source_id": "maldi_expander_delivery.L1", "start": [185.0, 115.0], "end": [245.0, 115.0], "direction_deg": 0.0, "length_mm": 60.0, "wavelength_nm": 355.0, "freq_shift_mhz": 0.0, "power_mw": 39.735999970177005, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "wai