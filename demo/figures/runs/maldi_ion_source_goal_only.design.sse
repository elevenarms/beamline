data: {"type": "status", "stage": "plan", "message": "architecture: 355 nm Pulsed Nd:YAG MALDI-TOF Ion Source Optical System \u2014 3 modules on a 600x1100 mm table: 355 nm Nd:YAG Source, Primary Variable Attenuator & Energy Monitor, 3x Galilean Beam Expander, Fine Attenuator & f=150 mm MALDI Target Delivery, TOF Start-Trigger Photodiode & UV Beam Diagnostics Module"}

data: {"type": "modules", "modules": [{"id": "uv_source_attenuator", "title": "355 nm Nd:YAG Source, Primary Variable Attenuator & Energy Monitor", "region": [25.0, 400.0, 500.0, 350.0], "description": "Receives the 355 nm pulsed Nd:YAG laser head through an optical isolator, attenuates the pulse energy with a Motorized Half-Wave Plate + Polarizing Beamsplitter (dumping the rejected V-polarized beam into a beam dump), picks off 5% with a wedged sampler to a pulse-energy photodiode (PD_energy), and splits and couples the conditioned H-polarized beam via two-mirror doglegs into the main target-delivery UV fiber (FC_main) and an auxiliary trigger/diagnostics fiber (FC_aux)."}, {"id": "maldi_expander_delivery", "title": "3x Galilean Beam Expander, Fine Attenuator & f=150 mm MALDI Target Delivery", "region": [25.0, 25.0, 550.0, 350.0], "description": "Launches the conditioned 355 nm beam from fiber FC_main, passes a fine trim variable attenuator (HWP + PBS with beam dump on the rejected port) and a 5% wedged sampler to a local energy-monitor photodiode (PD_target_mon), expands the beam 3x using a Galilean beam expander (f1 = -50 mm plano-concave lens + f2 = +150 mm plano-convex lens separated by 100 mm), steers the expanded beam via two broadband UV mirrors, and focuses it through an f = 150 mm lens directly onto the MALDI sample target (terminated at target coupler/detector FC_target)."}, {"id": "tof_trigger_diagnostics", "title": "TOF Start-Trigger Photodiode & UV Beam Diagnostics Module", "region": [25.0, 775.0, 450.0, 300.0], "description": "Receives the auxiliary 355 nm pickoff fiber from uv_source_attenuator, splits the beam with a HWP + PBS into a fast time-of-flight (TOF) digitizer start-trigger photodiode branch (with a focusing lens and sampler dump) and a continuous UV power-stability & spatial reference fiber coupler (FC_diag) with two steering mirrors."}], "table": {"width_mm": 600.0, "height_mm": 1100.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.0}, "links": [{"from_module": "uv_source_attenuator", "to_module": "maldi_expander_delivery", "purpose": "Delivers primary attenuated 355 nm pulsed Nd:YAG beam to the 3x Galilean expander and f=150 mm MALDI sample target focusing stage"}, {"from_module": "uv_source_attenuator", "to_module": "tof_trigger_diagnostics", "purpose": "Delivers auxiliary 355 nm pickoff pulses for sub-nanosecond TOF digitizer start triggering and beam diagnostics"}], "title": "355 nm Pulsed Nd:YAG MALDI-TOF Ion Source Optical System"}

data: {"type": "status", "stage": "design", "message": "designing 3 modules in parallel (2 candidates each)"}

