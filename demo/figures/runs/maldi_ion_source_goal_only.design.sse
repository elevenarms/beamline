t_mon", "end_reason": "absorbed"}, {"id": "s9", "branch": "maldi_expander_delivery.L1.r", "source_id": "maldi_expander_delivery.L1", "start": [185.0, 115.0], "end": [184.99999999999997, 64.99999999999999], "direction_deg": -90.00000000000003, "length_mm": 50.0, "wavelength_nm": 355.0, "freq_shift_mhz": 0.0, "power_mw": 5.264000029822993, "jones": [[0.0, -0.0], [1.0, 0.0]], "polarization_label": "V", "waist_z_mm": 140.0, "rayleigh_mm": 2212.3891926688684, "w0_mm": 0.5, "w_start_mm": 0.5010000895908228, "w_end_mm": 0.5004135446510818, "start_element": "maldi_expander_delivery.PBS_trim", "end_element": "maldi_expander_delivery.BD_trim", "end_reason": "absorbed"}], "elements": [{"id": "maldi_expander_delivery.HWP_trim", "type": "half_wave_plate", "placed": true, "position": [125.0, 115.0], "angle_deg": 0.0, "hits": [{"segment_id": "s0", "power_in_mw": 45.0, "w_mm": 0.5020388833018455, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "maldi_expander_delivery.PBS_trim", "type": "pbs", "placed": true, "position": [185.0, 115.0], "angle_deg": 90.0, "hits": [{"segment_id": "s1", "power_in_mw": 45.0, "w_mm": 0.5010000895908228, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "maldi_expander_delivery.BD_trim", "type": "beam_dump", "placed": true, "position": [184.99999999999997, 64.99999999999999], "angle_deg": -90.00000000000003, "hits": [{"segment_id": "s9", "power_in_mw": 5.264000029822993, "w_mm": 0.5004135446510818, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": 5.264000029822993, "error": null}, {"id": "maldi_expander_delivery.S_mon", "type": "sampler", "placed": true, "position": [245.0, 115.0], "angle_deg": 0.0, "hits": [{"segment_id": "s2", "power_in_mw": 39.735999970177005, "w_mm": 0.5003267796705612, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"