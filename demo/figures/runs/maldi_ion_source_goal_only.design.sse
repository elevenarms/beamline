ull, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "tof_trigger_diagnostics.FC_diag", "type": "fiber_coupler", "label": "UV Diagnostics Fiber Coupler (SM300)", "group": "tof_trigger_diagnostics", "part_number": "PAF2S-11A", "beam": "tof_trigger_diagnostics.L1.t", "distance_mm": 120.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 11.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 3.2, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "tof_trigger_diagnostics.S1", "type": "sampler", "label": "UV Trigger Branch Sampler (5%)", "group": "tof_trigger_diagnostics", "part_number": "BSF05-UV", "beam": "tof_trigger_diagnostics.L1.r", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "tof_trigger_diagnostics.PD_mon", "type": "photodiode", "label": "Pulse Energy Monitor PD", "group": "tof_trigger_diagnostics", "part_number": "SM05PD2A", "beam": "tof_trigger_diagnostics.L1.r.r", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "tof_trigger_diagnostics.LENS_trig", "type": "lens", "label": "Trigger Focusing Lens (f=75 mm)", "group": "tof_trigger_diagnostics", "part_number": "LA4725-UV", "beam": "tof_trigger_diagnostics.L1.r.t", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 75.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "tof_trigger_diagnostics.PD_tof_trig", "type": "photodiode", "label": "Fast TOF Start-Trigger Photodiode", "group": "tof_trigger_diagnostics", "part_number": "DET10A2", "beam": "tof_trigger_diagnostics.L1.r.t", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "uv_source_attenuator.FC_main", "kind": "min_power_mw", "value": 35.0}, {"element_id": "uv_source_attenuator.FC_main", "kind": "min_coupling", "value": 0.65}, {"element_id": "uv_source_attenuator.FC_aux", "kind": "min_power_mw", "value": 5.0}, {"element_id": "uv_source_attenuator.PD_energy", "kind": "min_power_mw", "value": 2.0}, {"element_id": "maldi_expander_delivery.PD_target_mon", "kind": "min_power_mw", "value": 1.2}, {"element_id": "maldi_expander_delivery.FC_target", "kind": "min_power_mw", "value": 20.0}, {"element_id": "maldi_expander_delivery.FC_target", "kind": "polarization", "value": "H"}, {"element_id": "tof_trigger_diagnostics.PD_tof_trig", "kind": "min_power_mw", "value": 2.0}, {"element_id": "tof_trigger_diagnostics.FC_diag", "kind": "min_power_mw", "value": 1.5}, {"element_id": "tof_trigger_diagnostics.FC_diag", "kind": "min_coupling", "value": 0.65}], "notes": "[uv_source_attenuator] Compact linear layout along y = 175 mm. L1 (100 mW @ 355 nm, waist 0.48 mm matched to f=11 mm coupler for MFD=5.0 um: w = f*lambda/(pi*w_f) = 11*0.355e-3/(pi*2.5e-3) = 0.497 mm) passes through ISO1 (92 mW), HWP_att (10 deg -> 88.3% H, 11.7% V) and PBS_att (dumps ~10.8 mW V into BD_att, transmits ~81.2 mW H). S_mon picks off 5% (~4.06 mW) to PD_energy. BS_split divides the remaining ~77.2 mW into 85% (~65.6 mW) transmitted to the M_main1/M_main2 two-mirror dogleg into FC_main (~62 mW coupled, >95% coupling efficiency) and 15% (~11.6 mW) reflected to the M_aux1/M_aux2 two-mirror dogleg into FC_aux (~11 mW coupled).\n[maldi_expander_delivery] U-shaped layout on 550x350 mm baseplate: input FC_main launches at (40, 90) along +x; HWP_trim at (100, 90) with fast_axis_deg=10 deg rotates 45 mW H-polarized 355 nm beam to 20 deg linear so PBS_trim at (160, 90) transmits 39.74 mW (H) and reflects 5.26 mW (V) down into BD_trim at (160, 40). S_mon at (220, 90) picks off 5% (1.99 mW) upward into PD_target_mon at (220, 150). The transmitted 37.75 mW beam enters the 3x Galilean beam expander: L_exp1 (f1 = -50 mm) at (300, 90) and L_exp2 (f2 = +150 mm) at (400, 90), separated by f1 + f2 = 100 mm, expanding the collimated waist from 0.5 mm to 1.5 mm. M1 at (480, 90) folds the beam +90 deg to +y, and M2 at (480, 260) folds it +90 deg to -x (180 deg) so the output return arm runs parallel to the input arm. Two 90 deg reflections invert Ex twice ((-1)^2 = +1), preserving pure H polarization. FC_target at (120, 260) integrates the f = 150 mm MALDI target focusing lens (focal_length_mm=150.0, aperture_mm=25.4) and target plane (fiber_mfd_um=22.6 matching 2*w_focus = 2*lambda*f/(pi*w_in) = 22.6 um), delivering >34 mW coupled H-polarized UV power onto the MALDI target with zero stray beams.\n[tof_trigger_diagnostics] HWP1 at 22.5 deg splits the 8 mW 355 nm beam 50:50 at PBS1 (4 mW H transmitted along +x, 4 mW V reflected along +y). The transmitted diagnostics beam runs along +x to dogleg steering mirrors M1 (255, 90) and M2 (255, 160) and enters FC_diag at (375, 160) with ~99% mode-matching efficiency (~3.95 mW coupled). The reflected TOF trigger branch passes 5% sampler S1 at (145, 150) (pickoff to PD_mon at (80, 150)) and focusing lens LENS_trig at (145, 205) onto fast silicon detector PD_tof_trig at (145, 270), delivering 3.80 mW."}, "report": {"passed": true, "score": 99.20888460657736, "checks": [{"id": "target", "severity": "info", "message": "met: uv_source_attenuator.FC_main: 65.458 mW (need \u2265 35.000)", "element_id": "uv_source_attenuator.FC_main", "segment_id": null, "value": 65.45750287230841, "limit": 35.0}, {"id": "target", "severity": "info", "message": "met: uv_source_attenuator.FC_main: coupling 99.8% (need \u2265 65.0%)", "element_id": "uv_source_attenuator.FC_main", "segment_id": null, "value": 0.9978320339549364, "limit": 0.65}, {"id": "target", "severity": "info", "message": "met: uv_source_attenuator.FC_aux: 11.555 mW (need \u2265 5.000)", "element_id": "uv_source_attenuator.FC_aux", "segment_id": null, "value": 11.555088289426969, "limit": 5.0}, {"id": "target", "severity": "info", "message": "met: uv_source_attenuator.PD_energy: 4.062 mW (need \u2265 2.000)", "element_id": "uv_source_attenuator.PD_energy", "segment_id": null, "value": 4.06190221917365, "limit": 2.0}, {"id": "target", "severity": "info", "message": "met: maldi_expander_delivery.PD_target_mon: 1.987 mW (need \u2265 1.200)", "element_id": "maldi_expander_delivery.PD_target_mon", "segment_id": null, "value": 1.9867999985088503, "limit": 1.2}, {"id": "target", "severity": "info", "message": "met: maldi_expander_delivery.FC_target: 37.735 mW (need \u2265 20.000)", "element_id": "maldi_expander_delivery.FC_target", "segment_id": null, "value": 37.735456114038456, "limit": 20.0}, {"id": "target", "severity": "info", "message": "met: maldi_expander_delivery.FC_target: polarization H (need H, overlap 100.0%)", "element_id": "maldi_expander_delivery.FC_target", "segment_id": null, "value": 1.0, "limit": null}, {"id": "target", "severity": "info", "message": "met: tof_trigger_diagnostics.PD_tof_trig: 3.800 mW (need \u2265 2.000)", "element_id": "tof_trigger_diagnostics.PD_tof_trig", "segment_id": null, "value": 3.8000000000000007, "limit": 2.0}, {"id": "target", "severity": "info", "message": "met: tof_trigger_diagnostics.FC_diag: 3.995 mW (need \u2265 1.500)", "element_id": "tof_trigger_diagnostics.FC_diag", "segment_id": null, "value": 3.9951194678107753, "limit": 1.5}, {"id": "target", "severity": "info", "message": "met: tof_trigger_diagnostics.FC_diag: coupling 99.9% (need \u2265 65.0%)", "element_id": "tof_trigger_diagnostics.FC_diag", "segment_id": null, "value": 0.998779866952694, "limit": 0.65}], "metrics": {"input_mw": 153.0, "delivered_mw": 128.7918689612671, "dumped_mw": 16.025955646350003, "stray_mw": 0.0, "n_elements": 32.0, "n_segments": 32.0, "target.uv_source_attenuator.FC_main.min_power_mw": 65.45750287230841, "target.uv_source_attenuator.FC_main.min_coupling": 0.9978320339549364, "target.uv_source_attenuator.FC_aux.min_power_mw": 11.555088289426969, "target.uv_source_attenuator.PD_energy.min_power_mw": 4.06190221917365, "target.maldi_expander_delivery.PD_target_mon.min_power_mw": 1.9867999985088503, "target.maldi_expander_delivery.FC_target.min_power_mw": 37.735456114038456, "target.maldi_expander_delivery.FC_target.polarization": 1.0, "target.tof_trigger_diagnostics.PD_tof_trig.min_power_mw": 3.8000000000000007, "target.tof_trigger_diagnostics.FC_diag.min_power_mw": 3.9951194678107753, "target.tof_trigger_diagnostics.FC_diag.min_coupling": 0.998779866952694, "delivered_fraction": 0.8417