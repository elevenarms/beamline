mission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD_tof_trig", "type": "photodiode", "label": "Fast TOF Start-Trigger Photodiode", "group": "tof_trigger_diagnostics", "part_number": "DET10A2", "beam": "L1.r.t", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD_tof_trig", "kind": "min_power_mw", "value": 2.0}, {"element_id": "FC_diag", "kind": "min_power_mw", "value": 1.5}, {"element_id": "FC_diag", "kind": "min_coupling", "value": 0.65}], "notes": "HWP1 at 22.5 deg splits the 8 mW 355 nm beam 50:50 at PBS1 (4 mW H transmitted along +x, 4 mW V reflected along +y). The transmitted diagnostics beam runs along +x to dogleg steering mirrors M1 (255, 90) and M2 (255, 160) and enters FC_diag at (375, 160) with ~99% mode-matching efficiency (~3.95 mW coupled). The reflected TOF trigger branch passes 5% sampler S1 at (145, 150) (pickoff to PD_mon at (80, 150)) and focusing lens LENS_trig at (145, 205) onto fast silicon detector PD_tof_trig at (145, 270), delivering 3.80 mW."}, "timings": {"candidates_s": 23.5, "repair_s": 0.0, "total_s": 23.5}}

