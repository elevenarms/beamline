 "PD1", "type": "photodiode", "placed": true, "position": [-54.99999999999995, 205.00000000000006], "angle_deg": 180.0, "hits": [{"segment_id": "s13", "power_in_mw": 2.300000000000002, "w_mm": 0.6616429898002882, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": 2.300000000000002, "error": null}, {"id": "S2", "type": "sampler", "placed": true, "position": [-4.9999999999999725, 155.00000000000006], "angle_deg": -90.00000000000003, "hits": [{"segment_id": "s14", "power_in_mw": 43.699999999999996, "w_mm": 0.6616429898002882, "clip_loss": 0.0, "offset_mm": 7.105427357601002e-15}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "PD2", "type": "photodiode", "placed": true, "position": [45.00000000000003, 155.00000000000003], "angle_deg": -1.90833280887811e-14, "hits": [{"segment_id": "s18", "power_in_mw": 2.185, "w_mm": 0.6668138679021844, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": 2.185, "error": null}, {"id": "M4", "type": "mirror", "placed": true, "position": [-4.9999999999999964, 100.00000000000006], "angle_deg": 44.999999999999986, "hits": [{"segment_id": "s15", "power_in_mw": 41.51499999999999, "w_mm": 0.6673811716323432, "clip_loss": 0.0, "offset_mm": 7.105427357601002e-15}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "M5", "type": "mirror", "placed": true, "position": [115.0, 100.00000000000006], "angle_deg": 135.0, "hits": [{"segment_id": "s16", "power_in_mw": 41.51499999999999, "w_mm": 0.6836514838488568, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "FC1", "type": "fiber_coupler", "placed": true, "position": [115.00000000000001, 155.00000000000006], "angle_deg": 89.99999999999999, "hits": [{"segment_id": "s17", "power_in_mw": 41.51499999999999, "w_mm": 0.6927503749047595, "clip_loss": 0.0, "offset_mm": 1.4210854715202004e-14}], "coupling_efficiency": 0.934926612068628