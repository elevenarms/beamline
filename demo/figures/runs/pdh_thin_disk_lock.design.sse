data: {"type": "final", "design": {"name": "pdh_injection_locking_1030nm_folded", "description": "1030 nm Pound-Drever-Hall (PDH) injection-locking bench in a folded L-shaped resonator configuration. The 1030 nm seed laser is isolated, rotated to V-polarization via HWP1, and folded +y by M1 into PBS1. PBS1 reflects the V-polarized seed (-x) through a quarter-wave plate (QWP1 at 45 deg) into a folded L-shaped slave laser resonator (M2 folding +y, cat-eye lens LENS1 with f=100 mm, and cavity end mirror M3 at the focal plane). On the return pass, double-passing QWP1 rotates polarization from V to H so the locked resonator output transmits straight (+x) through PBS1 to a 95%-reflecting HR out-coupler (S1). The 5% HR leakage transmits to fast PDH photodiode PD1, while the 95% reflected main output is steered by M4 and M5 into fiber coupler FC1.", "modules": [{"id": "seed_injection", "title": "Seed Laser & Polarization Injection", "region": [15.0, 20.0, 210.0, 250.0], "description": "Isolates the 1030 nm seed laser, sets V polarization, and injects via PBS1 reflection while dumping residual H light."}, {"id": "slave_resonator", "title": "Folded L-Shaped Slave Resonator", "region": [20.0, 120.0, 140.0, 170.0], "description": "Quarter-wave plate, fold mirror M2, f=100 mm intra-cavity lens, and retro-reflecting cavity end mirror M3."}, {"id": "outcoupler_and_pdh_detection", "title": "HR Out-Coupler & PDH Detection", "region": [230.0, 20.0, 205.0, 190.0], "description": "95% HR out-coupler sampler sending 5% leakage to PDH photodiode PD1 and 95% main beam to fiber coupler FC1."}], "baseplate": {"width_mm": 450.0, "height_mm": 300.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "1030 nm Seed Laser (PM980-XP Collimator)", "group": "seed_injection", "part_number": "Toptica DLC pro 1030", "position": [30.0, 50.0], "direction_deg": 0.0, "wavelength_nm": 1030.0, "power_mw": 50.0, "waist_mm": 1.38, "waist_offset_mm": 455.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO1", "type": "isolator", "label": "1030 nm Optical Isolator", "group": "seed_injection", "part_number": "IO-3D-1030-VLP", "beam": "L1", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.92, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP1", "type": "half_wave_plate", "label": "Input lambda/2 (H to V)", "group": "seed_injection", "part_number": "WPH05M-1030", "beam": "L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "Seed Injection Fold Mirror", "group": "seed_injection", "part_number": "BB05-E03", "beam": "L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "Injection Circulator PBS", "group": "seed_injection", "part_number": "PBS253", "beam": "L1", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD1", "type": "beam_dump", "label": "Seed H-Pol Rejection Dump", "group": "seed_injection", "part_number": "LB1", "beam": "L1.t", "distance_mm": 75.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "QWP1", "type": "quarter_wave_plate", "label": "Cavity lambda/4 (45 deg)", "group": "slave_resonator", "part_number": "WPQ05M-1030", "beam": "L1.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "Resonator L-Fold Mirror", "group": "slave_resonator", "part_number": "BB05-E03", "beam": "L1.r", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "LENS1", "type": "lens", "label": "Resonator Cat-Eye Lens f=100mm", "group": "slave_resonator", "part_number": "LA1509-B", "beam": "L1.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M3", "type": "mirror", "label": "Slave Cavity End Mirror (HR)", "group": "slave_resonator", "part_number": "BB05-E03", "beam": "L1.r", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S1", "type": "sampler", "label": "95% HR Out-Coupler", "group": "outcoupler_and_pdh_detection", "part_number": "BSF05-B", "beam": "L1.r.t", "distance_mm": 110.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.95, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD1", "type": "photodiode", "label": "Fast PDH Error Photodiode", "group": "outcoupler_and_pdh_detection", "part_number": "PDA36A2", "beam": "L1.r.t.t", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M4", "type": "mirror", "label": "Output Steering Mirror 1", "group": "outcoupler_and_pdh_detection", "part_number": "BB05-E03", "beam": "L1.r.t.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M5", "type": "mirror", "label": "Output Steering Mirror 2", "group": "outcoupler_and_pdh_detection", "part_number": "BB05-E03", "beam": "L1.r.t.r", "distance_mm": 90.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC1", "type": "fiber_coupler", "label": "Main Output Fiber Coupler", "group": "outcoupler_and_pdh_detection", "part_number": "PAF2-11B", "beam": "L1.r.t.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 11.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.3, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD1", "kind": "min_power_mw", "value": 1.5}, {"element_id": "FC1", "kind": "min_power_mw", "value": 25.0}, {"element_id": "FC1", "kind": "min_coupling", "value": 0.75}, {"element_id": "FC1", "kind": "polarization", "value": "H"}], "notes": "Cat-eye slave resonator (LENS1 f=100 mm placed 100 mm before M3) re-collimates the 1.38 mm waist beam and places the output waist right at FC1 (f=11 mm, MFD=5.3 um, ideal waist=1.36 mm at 1030 nm), giving >99% mode-matching efficiency. Double-pass through QWP1 (45 deg) with L-fold mirror M2 converts V-polarized injected light into H-polarized return light that transmits through PBS1."}, "report": {"passed": true, "score": 99.5962132143411, "checks": [{"id": "no_light", "severity": "info", "message": "BD1 receives no light", "element_id": "BD1", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "info", "message": "met: PD1: 2.300 mW (need \u2265 1.500)", "element_id": "PD1", "segment_id": null, "value": 2.300000000000002, "limit": 1.5}, {"id": "target", "severity": "info", "message": "met: FC1: 43.662 mW (need \u2265 25.000)", "element_id": "FC1", "segment_id": null, "value": 43.66213214341112, "limit": 25.0}, {"id": "target", "severity": "info", "message": "met: FC1: coupling 99.9% (need \u2265 75.0%)", "element_id": "FC1", "segment_id": null, "value": 0.9991334586592935, "limit": 0.75}, {"id": "target", "severity": "info", "message": "met: FC1: polarization H (need H, overlap 100.0%)", "element_id": "FC1", "segment_id": null, "value": 1.0, "limit": null}], "metrics": {"input_mw": 50.0, "delivered_mw": 45.962132143411125, "dumped_mw": 0.0, "stray_mw": 0.0, "n_elements": 14.0, "n_segments": 17.0, "targe