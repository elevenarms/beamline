data: {"type": "candidate", "index": 0, "stage": "design", "design": {"name": "pdh_injection_locking_1030_cross", "description": "1030 nm Pound-Drever-Hall (PDH) injection-locking bench in a cross-topology circulator layout. The 50 mW 1030 nm seed laser passes through an optical isolator and half-wave plate (rotating polarization to V) and reflects (+y) at PBS1 into the vertical slave resonator arm. A quarter-wave plate (QWP1 at 45 deg) converts V to circular polarization, and a cat-eye resonator (f=50 mm mode-matching lens LENS1 and end mirror M_RES) retro-reflects the beam back through QWP1, rotating its polarization to H. The returning H-polarized resonator beam transmits straight (-y) through PBS1 to a 95% high-reflector out-coupler (modeled as sampler S1 with split_ratio=0.95): the 5% transmitted HR leakage is detected on fast photodiode PD1 for the PDH error signal, while the 95% reflected main beam is steered via M1 and M2 into output fiber coupler FC1.", "modules": [{"id": "seed_injection", "title": "Seed Laser & Circulator Injection", "region": [20.0, 110.0, 260.0, 65.0], "description": "Isolates the 1030 nm seed, rotates polarization to V via HWP1, injects into the resonator via PBS1 reflection, and dumps residual H light in BD1."}, {"id": "slave_resonator", "title": "Slave Laser Resonator", "region": [175.0, 175.0, 70.0, 115.0], "description": "Vertical cat-eye resonator with QWP1 (double-pass V-to-H conversion), f=50 mm cavity lens LENS1, and retro-reflecting cavity end mirror M_RES."}, {"id": "outcoupler_and_pdh_detection", "title": "HR Out-Coupler, PDH Photodiode & Output Fiber", "region": [175.0, 15.0, 255.0, 95.0], "description": "Receives H-polarized resonator output transmitted through PBS1, splits 5% HR leakage through S1 to fast PDH detector PD1, and routes 95% reflected output via M1/M2 to fiber coupler FC1."}], "baseplate": {"width_mm": 450.0, "height_mm": 300.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "1030 nm Seed Laser (50 mW)", "group": "seed_injection", "part_number": "Toptica DL pro 1030", "position": [35.0, 145.0], "direction_deg": 0.0, "wavelength_nm": 1030.0, "power_mw": 50.0, "waist_mm": 0.56, "waist_offset_mm": 235.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO1", "type": "isolator", "label": "Optical Isolator 1030 nm", "group": "seed_injection", "part_number": "IO-3D-1030-VLP", "beam": "L1", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.92, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP1", "type": "half_wave_plate", "label": "Seed lambda/2 (H to V)", "group": "seed_injection", "part_number": "WPH05M-1030", "beam": "L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "Injection Circulator PBS", "group": "seed_injection", "part_number": "PBS253", "beam": "L1", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD1", "type": "beam_dump", "label": "Seed H-Pol Rejection Dump", "group": "seed_injection", "part_number": "LB1", "beam": "L1.t", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "QWP1", "type": "quarter_wave_plate", "label": "Circulator lambda/4 (45 deg)", "group": "slave_resonator", "part_number": "WPQ05M-1030", "beam": "L1.r", "distance_mm": 35.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "LENS1", "type": "lens", "label": "Resonator Cat-Eye Lens f=50 mm", "group": "slave_resonator", "part_number": "LA1131-B", "beam": "L1.r", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_RES", "type": "mirror", "label": "Slave Resonator End Mirror", "group": "slave_resonator", "part_number": "BB05-E03", "beam": "L1.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S1", "type": "sampler", "label": "95% HR Out-Coupler", "group": "outcoupler_and_pdh_detection", "part_number": "BSF05-B", "beam": "L1.r.t", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.95, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD1", "type": "photodiode", "label": "PDH Fast Photodiode (HR Leakage)", "group": "outcoupler_and_pdh_detection", "part_number": "PDA36A2", "beam": "L1.r.t.t", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "Output Steering Mirror 1", "group": "outcoupler_and_pdh_detection", "part_number": "BB05-E03", "beam": "L1.r.t.r", "distance_mm": 75.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "Output Steering Mirror 2", "group": "outcoupler_and_pdh_detection", "part_number": "BB05-E03", "beam": "L1.r.t.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC1", "type": "fiber_coupler", "label": "Main Output Fiber Coupler", "group": "outcoupler_and_pdh_detection", "part_number": "PAF2-A4B", "beam": "L1.r.t.r", "distance_mm": 90.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 4.5, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.3, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD1", "kind": "min_power_mw", "value": 1.5}, {"element_id": "FC1", "kind": "min_power_mw", "value": 25.0}, {"element_id": "FC1", "kind": "min_coupling", "value": 0.75}, {"element_id": "FC1", "kind": "polarization", "value": "H"}], "notes": "Cross-topology optical circulator at PBS1 (210, 145): seed enters from left (+x), V-pol reflects up (+y) into the cat-eye resonator (QWP1 -> LENS1 -> M_RES), double-pass through QWP1 rotates return beam to H-pol so it transmits straight down (-y) through PBS1 to the 95% HR out-coupler S1 at (210, 85). S1 transmits 5% leakage (~2.3 mW) straight down to PD1 at (210, 35) for the PDH lock signal and reflects 95% (~43.7 mW) along +x via dogleg M1/M2 into fiber coupler FC1 at (375, 40) with >85% mode-matched coupling."}, "report": {"passed": true, "score": 99.53386454131409, "checks": [{"id": "no_light", "severity": "info", "message": "BD1 receives no light", "element_id": "BD1", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "info", "message": "met: PD1: 2.300 mW (need \u2265 1.500)", "element_id": "PD1", "segment_id": null, "value": 2.300000000000002, "limit": 1.5}, {"id": "target", "severity": "info", "message": "met: FC1: 43.039 mW (need \u2265 25.000)", "element_id": "FC1", "segment_id": null, "value": 43.03864541314083, "limit": 25.0}, {"id": "target", "severity": "info", "message": "met: FC1: coupling 98.5% (need \u2265 75.0%)", "element_id": "FC1", "segment_id": null, "value": 0.9848660277606598, "limit": 0.75}, {"id": "target", "severity": "info", "message": "met: FC1: polarization H (need H, overlap 100.0%)", "element_id": "FC1", "segment_id": null, "value": 1.0, "limit": null}], "metrics": {"input_mw": 50.0, "delivered_mw": 45.33864541314083, "dumped_mw": 0.0, "stray_mw": 0.0, "n_elements": 12.0, "n_segments": 14.0, "target.PD1.min_power_mw": 2.300000000000002, "target.FC1.min_power_mw": 43.03864541314083, "target.FC1.min_coupling": 0.9848660277606598, "target.FC1.polarization": 1.0, "delivered_fraction": 0.9067729082628166}}, "trace": {"segments": [{"id": "s0", "branch": "L1", "source_id": "L1", "start": [35.0, 145.0], "end": [95.0, 145.0], "direction_deg": 0.0, "length_mm": 60.0, "wavelength_nm": 1030.0, "freq_shift_mhz": 0.0, "power_mw": 50.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 235.0, "rayleigh_mm": 956.5082098696693, "w0_mm": 0.56, "w_start_mm": 0.576653528707529, "w_end_mm": 0.5692953810041256, "start_element": "L1", "end_element": "ISO1", "end_reason": "element"}, {"id": "s1", "branch": "L1", "source_id": "L1", "start": [95.0, 1