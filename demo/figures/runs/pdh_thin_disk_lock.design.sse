: "M1", "type": "mirror", "placed": true, "position": [285.0, 84.99999999999997], "angle_deg": -135.00000000000003, "hits": [{"segment_id": "s11", "power_in_mw": 43.699999999999996, "w_mm": 0.5633640058609952, "clip_loss": 0.0, "offset_mm": 1.4210854715202007e-14}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "M2", "type": "mirror", "placed": true, "position": [285.0, 39.99999999999997], "angle_deg": 44.999999999999986, "hits": [{"segment_id": "s12", "power_in_mw": 43.699999999999996, "w_mm": 0.5668441154532474, "clip_loss": 0.0, "offset_mm": 9.466330862652142e-30}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "FC1", "type": "fiber_coupler", "placed": true, "position": [375.0, 39.99999999999997], "angle_deg": 0.0, "hits": [{"segment_id": "s13", "power_in_mw": 43.699999999999996, "w_mm": 0.5773589551859183, "clip_loss": 0.0, "offset_mm": 2.1316282072803006e-14}], "coupling_efficiency": 0.9848660277606598, "power_out_mw": 43.03864541314083, "error": null}], "branches": ["L1", "L1.r", "L1.r.t", "L1.r.t.t", "L1.r.t.r"], "nonconverged": []}}

