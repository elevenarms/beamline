data: {"type": "candidate", "index": 1, "stage": "design", "design": {"name": "pdh_injection_locking_1030_horizontal", "description": "1030 nm Pound-Drever-Hall (PDH) injection-locking bench in a horizontal resonator layout. The 50 mW seed laser passes through an optical isolator and half-wave plate (rotating H to V), folds vertically (+y) via mirror M1 into PBS1, and reflects horizontally (-x) into the slave laser resonator arm (QWP1 at 45 deg, f=100 mm cat-eye lens LENS1, and cavity retro-mirror M2). On the return pass (+x), double-passing QWP1 rotates the polarization from V to H so the resonator output transmits straight through PBS1 along +x to a 95% high-reflector out-coupler (modeled as sampler S1 with split_ratio=0.95). The 5% HR leakage transmits inline to the fast PDH photodiode PD1, while the 95% reflected main beam is steered via a two-mirror dogleg (M3, M4) into the output fiber coupler FC1.", "modules": [{"id": "seed_injection", "title": "Seed Laser & Polarization Circulator Injection", "region": [20.0, 20.0, 240.0, 250.0], "description": "Isolates the 1030 nm seed, rotates polarization to V, folds +y into PBS1, and dumps any residual H transmission at BD1."}, {"id": "slave_resonator", "title": "Horizontal Slave Laser Resonator Arm", "region": [20.0, 130.0, 200.0, 80.0], "description": "Receives V-polarized seed reflected along -x from PBS1, converts to circular via QWP1, focuses onto cavity mirror M2 via cat-eye lens LENS1, and returns H-polarized light along +x."}, {"id": "outcoupler_and_pdh_detection", "title": "HR Out-Coupler, PDH Photodiode & Output Fiber", "region": [260.0, 40.0, 175.0, 240.0], "description": "Splits the transmitted H-polarized resonator output at 95% HR sampler S1: 5% leakage to fast PDH detector PD1 and 95% reflected via dogleg M3-M4 to fiber coupler FC1."}], "baseplate": {"width_mm": 450.0, "height_mm": 300.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "1030 nm PDH Seed Laser (50 mW, PM fiber collimated, waist at M2=370 mm)','part_number':'Toptica DLC pro 1030", "group": "seed_injection", "part_number": "Toptica DLC pro 1030", "position": [40.0, 50.0], "direction_deg": 0.0, "wavelength_nm": 1030.0, "power_mw": 50.0, "waist_mm": 0.6, "waist_offset_mm": 370.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO1", "type": "isolator", "label": "Optical isolator (1030 nm, T=0.90)','part_number':'IO-3D-1030-VLP", "group": "seed_injection", "part_number": "IO-3D-1030-VLP", "beam": "L1", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.9, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP1", "type": "half_wave_plate", "label": "Seed lambda/2 (rotate H to V)','part_number':'WPH05M-1030", "group": "seed_injection", "part_number": "WPH05M-1030", "beam": "L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "Seed injection fold mirror (+x to +y)','part_number':'BB05-E03", "group": "seed_injection", "part_number": "BB05-E03", "beam": "L1", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "Injection & circulator PBS','part_number':'PBS253", "group": "seed_injection", "part_number": "PBS253", "beam": "L1", "distance_mm": 120.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD1", "type": "beam_dump", "label": "Seed H-polarization reject dump','part_number':'LB1", "group": "seed_injection", "part_number": "LB1", "beam": "L1.t", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "QWP1", "type": "quarter_wave_plate", "label": "Resonator lambda/4 at 45 deg (double-pass V to H)','part_number':'WPQ05M-1030", "group": "slave_resonator", "part_number": "WPQ05M-1030", "beam": "L1.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "s