data: {"type": "candidate", "index": 2, "stage": "design", "design": {"name": "pdh_injection_locking_1030nm_folded", "description": "1030 nm Pound-Drever-Hall (PDH) injection-locking bench in a folded L-shaped resonator configuration. The 1030 nm seed laser is isolated, rotated to V-polarization via HWP1, and folded +y by M1 into PBS1. PBS1 reflects the V-polarized seed (-x) through a quarter-wave plate (QWP1 at 45 deg) into a folded L-shaped slave laser resonator (M2 folding +y, cat-eye lens LENS1 with f=100 mm, and cavity end mirror M3 at the focal plane). On the return pass, double-passing QWP1 rotates polarization from V to H so the locked resonator output transmits straight (+x) through PBS1 to a 95%-reflecting HR out-coupler (S1). The 5% HR leakage transmits to fast PDH photodiode PD1, while the 95% reflected main output is steered by M4 and M5 into fiber coupler FC1.", "modules": [{"id": "seed_injection", "title": "Seed Laser & Polarization Injection", "region": [15.0, 20.0, 210.0, 250.0], "description": "Isolates the 1030 nm seed laser, sets V polarization, and injects via PBS1 reflection while dumping residual H light."}, {"id": "slave_resonator", "title": "Folded L-Shaped Slave Resonator", "region": [20.0, 120.0, 140.0, 170.0], "description": "Quarter-wave plate, fold mirror M2, f=100 mm intra-cavity lens, and retro-reflecting cavity end mirror M3."}, {"id": "outcoupler_and_pdh_detection", "title": "HR Out-Coupler & PDH Detection", "region": [230.0, 20.0, 205.0, 190.0], "description": "95% HR out-coupler sampler sending 5% leakage to PDH photodiode PD1 and 95% main beam to fiber coupler FC1."}], "baseplate": {"width_mm": 450.0, "height_mm": 300.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "1030 nm Seed Laser (PM980-XP Collimator)", "group": "seed_injection", "part_number": "Toptica DLC pro 1030", "position": [30.0, 50.0], "direction_deg": 0.0, "wavelength_nm": 1030.0, "power_mw": 50.0, "waist_mm": 