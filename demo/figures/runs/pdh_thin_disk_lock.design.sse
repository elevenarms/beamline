data: {"type": "candidate", "index": 3, "stage": "design", "design": {"name": "pdh_injection_lock_1030_compact_dual_detector", "description": "1030 nm Pound-Drever-Hall (PDH) injection-locking bench in a compact dual-detector layout. The 50 mW seed laser passes through an optical isolator, a two-mirror steering dogleg, and a half-wave plate (rotating polarization to V) into the central PBS1 circulator. PBS1 reflects the V-polarized seed into a cat-eye slave resonator arm (quarter-wave plate QWP1 at 45 deg, f=50 mm mode-matching lens, and cavity retro-mirror M3 at the focal plane). The return beam passes QWP1 a second time, becoming H-polarized, and transmits through PBS1 to a 95% high-reflector out-coupler (S1). The 5% HR leakage transmits directly to the fast PDH error-signal photodiode (PD1), while the 95% reflected main output passes a 5% power-monitor pickoff sampler (S2 -> PD2) and a two-mirror beam-walking stage into the output fiber coupler (FC1).", "modules": [{"id": "seed_injection", "title": "Seed Laser & Steering Dogleg", "region": [20.0, 20.0, 210.0, 180.0], "description": "Isolates the 1030 nm seed, steers via two mirrors, rotates polarization to V, and injects via PBS1."}, {"id": "slave_resonator", "title": "Slave Laser Resonator", "region": [150.0, 180.0, 290.0, 105.0], "description": "QWP circulator element and cat-eye slave resonator cavity (f=50 mm lens + retro-reflecting end mirror)."}, {"id": "outcoupler_and_pdh_detection", "title": "HR Out-Coupler, PDH & Monitor Detection", "region": [230.0, 20.0, 205.0, 160.0], "description": "95% HR out-coupler feeding fast PDH detector PD1 in transmission, with monitor pickoff PD2 and fiber coupler FC1 on the main reflected output."}], "baseplate": {"width_mm": 450.0, "height_mm": 300.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "L1", "label": "1030 nm Seed Laser (50 mW)", "group": "seed_injection", "part_number": "Toptica DL pro 1030", "position": [40.0, 60.0], "direction_deg": 0.0, "wavelength_nm": 1030.0, "power_mw": 50.0, "waist_mm": 0.65, "waist_offset_mm": 335.0, "polarization": "H", "enabled": true}], "elements": [{"id": "ISO1", "type": "isolator", "label": "Optical Isolator (1030 nm)", "group": "seed_injection", "part_number": "IO-3D-1030-VLP", "beam": "L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.92, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "Seed Steering Mirror 1", "group": "seed_injection", "part_number": "BB05-E03", "beam": "L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "Seed Steering Mirror 2", "group": "seed_injection", "part_number": "BB05-E03", "beam": "L1", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP1", "type": "half_wave_plate", "label": "Seed lambda/2 (H to V)", "group": "seed_injection", "part_number": "WPH05M-1030", "beam": "L1", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M_TURN", "type": "mirror", "label": "Circulator Injection Mirror", "group": "seed_injection", "part_number": "BB05-E03", "beam": "L1", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "Injection Circulator PBS", "group": "seed_injection", "part_number": "PBS253", "beam": "L1", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD1", "type": "beam_dump", "label": "Residual H Seed Dump", "group": "seed_injection", "part_number": "LB1", "beam": "L1.t", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "QWP1", "type": "quarter_wave_plate", "label": "Circulator lambda/4 (45 deg)", "group": "slave_resonator", "part_number": "WPQ05M-1030", "beam": "L1.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "LENS1", "type": "lens", "label": "Resonator Cat-Eye Lens (f=50 mm)", "group": "slave_resonator", "part_number": "LA1131-B", "beam": "L1.r", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M3", "type": "mirror", "label": "Slave Resonator End Mirror", "group": "slave_resonator", "part_number": "BB05-E03", "beam": "L1.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S1", "type": "sampler", "label": "95% HR Out-Coupler", "group": "outcoupler_and_pdh_detection", "part_number": "BSF05-B", "beam": "L1.r.t", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.95, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD1", "type": "photodiode", "label": "Fast PDH Error Photodiode", "group": "outcoupler_and_pdh_detection", "part_number": "PDA36A2", "beam": "L1.r.t.t", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "S2", "type": "sampler", "label": "5% Output Monitor Sampler", "group": "outcoupler_and_pdh_detection", "part_number": "BSF05-B", "beam": "L1.r.t.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.05, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD2", "type": "photodiode", "label": "Output Power Monitor PD", "group": "outcoupler_and_pdh_detection", "part_number": "PDA36A2", "beam": "L1.r.t.r.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M4", "type": "mirror", "label": "Output Steering Mirror 1", "group": "outcoupler_and_pdh_detection", "part_number": "BB05-E03", "beam": "L1.r.t.r.t", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M5", "type": "mirror", "label": "Output Steering Mirror 2", "group": "outcoupler_and_pdh_detection", "part_number": "BB05-E03", "beam": "L1.r.t.r.t", "distance_mm": 120.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "FC1", "type": "fiber_coupler", "label": "Main Output Fiber Coupler", "group": "outcoupler_and_pdh_detection", "part_number": "PAF2-A4B", "beam": "L1.r.t.r.t", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 4.5, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": 5.3, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD1", "kind": "min_power_mw", "value": 1.5}, {"element_id": "FC1", "kind": "min_power_mw", "value": 25.0}, {"element_id": "FC1", "kind": "min_coupling", "value": 0.75}, {"element_id": "FC1", "kind": "polarization", "value": "H"}], "notes": "Cat-eye slave resonator (LENS1 f=50 mm, M3 at 50 mm) preserves beam collimation on the round trip and places the re-imaged 0.65 mm waist near FC1, yielding ~86% fiber coupling efficiency (>35 mW coupled into FC1, >2.2 mW on PD1, and ~2.2 mW on monitor PD2)."}, "report": {"passed": false, "score": 0.0, "checks": [{"id": "off_table", "severity": "error", "message": "S1 at (-5,205) is outside the 450x300 mm baseplate", "element_id": "S1", "segment_id": null, "value": null, "limit": null}, {"id": "off_table", "severity": "error", "message": "PD1 at (-55,205) is outside the 450x300 mm baseplate", "element_id": "PD1", "segment_id": null, "value": null, "limit": null}, {"id": "off_table", "severity": "error", "message": "S2 at (-5,155) is outside the 450x300 mm baseplate", "element_id": "S2", "segment_id": null, "value": null, "limit": null}, {"id": "off_table", "severity": "error", "message": "M4 at (-5,100) is outside the 450x300 mm baseplate", "element_id": "M4", "segment_id": null, "value": null, "limit": null}, {"id": "collision", "severity": "warning", "message": "HWP1 and FC1 footprints overlap (25.0 mm apart)", "element_id": "HWP1", "segment_id": null, "value": null, "limit": null}, {"id": "collision", "severity": "warning", "message": "M_TURN and PD2 footprints overlap (15.8 mm apart)", "element_id": "M_TURN", "segment_id": null, "value": null, "limit": null}, {"id": "beam_through_mount", "severity": "warning", "message": "beam L1 passes through PD2's mount without interacting", "element_id": "PD2", "segment_id": "s5", "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "BD1 receives no light", "element_id": "BD1", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "info", "message": "met: PD1: 2.300 mW (need \u2265 1.500)", "element_id": "PD1", "segment_id": null, "value": 2.300000000000002, "limit": 1.5}, {"id": "target", "severity": "info", "message": "met: FC1: 38.813 mW (need \u2265 25.000)", "element_id": "FC1", "segment_id": null, "value": 38.813478300029125, "limit": 25.0}, {"id": "target", "severity": "info", "message": "met: FC1: coupling 93.5% (need \u2265 75.0%)", "element_id": "FC1", "segment_id": null, "value": 0.9349266120686289, "limit": 0.75}, {"id": "target", "severity": "info", "message": "met: FC1: polarization H (need H, overlap 100.0%)", "element_id": "FC1", "segment_id": null, "value": 1.0, "limit": null}], "metrics": {"input_mw": 50.0, "delivered_mw": 43.298478300029124, "dumped_mw": 0.0, "stray_mw": 0.0, "n_elements": 17.0, "n_segments": 19.0, "target.PD1.min_power_mw": 2.300000000000002, "target.FC1.min_power_mw": 38.813478300029125, "target.FC1.min_coupling": 0.9349266120686289, "target.FC1.polarization": 1.0, "delivered_fraction": 0.8659695660005825}}, "trace": {"segments": [{"id": "s0", "branch": "L1", "source_id": "L1", "start": [40.0, 60.0], "end": [95.0, 60.0], "direction_deg": 0.0, "length_mm": 55.0, "wavelength_nm": 1030.0, "freq_shift_mhz": 0.0, "power_mw": 50.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 335.0, "rayleigh_mm": 1288.6630059628037, "w0_mm": 0.65, "w_start_mm": 0.6716041023821192, "w_end_mm": 0.6651664290883207, "start_element": "L1", "end_element": "ISO1", "end_reason": "element"}, {"id": "s1", "branch": "L1", "source_id": "L1", "start": [95.0, 60.0], "end": [150.0, 60.0], "direction_deg": 0.0, "length_mm": 55.0, "wavelength_nm": 1030.0, "freq_shift_mhz": 0.0, "power_mw": 46.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 280.0, "rayleigh_mm