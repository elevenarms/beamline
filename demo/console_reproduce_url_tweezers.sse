n_db": null, "nl_efficiency_per_w": null}, {"id": "M", "type": "mirror", "label": "M (Imaging fold mirror)", "group": null, "part_number": "BB1-E02", "beam": "LS.t", "distance_mm": 64.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "TL", "type": "lens", "label": "Tube lens", "group": null, "part_number": "LA1509-A", "beam": "LS.t", "distance_mm": 58.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "Camera", "type": "photodiode", "label": "Camera", "group": null, "part_number": "Thorlabs DCC1545M", "beam": "LS.t", "distance_mm": 78.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "Camera", "kind": "min_power_mw", "value": 4.5}], "notes": "Figure 5 from arXiv:2004.05246 (Polarization-splitting optical tweezers). The 532 nm trapping beam is rotated to 45 deg linear polarization by HWP1 (fast axis 22.5 deg) and split 50:50 at PBS1 into an H-polarized transmitted arm (steered by GM1) and a V-polarized reflected arm (steered by GM2). The two orthogonal arms recombine at PBS2, pass through the L1-L2 telescope, and reflect off dichroic mirror DM (cutoff 580 nm, reflects <580 nm) into objective O and the 3D sample stage (modeled as a 20 mm aperture sample cell with 44 mm thin-lens focal distances for O and C so the beam stays collimated). Brightfield illumination from source LS (625 nm) passes downward through C, Stage, O, and transmits through DM to fold mirror M, tube lens TL, and the Camera detector.", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "Laser_in", "source_id": "Laser_in", "start": [32.0, 30.0], "end": [32.0, 70.0], "direction_deg": 90.0, "length_mm": 40.0, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 100.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.800044805505728, "start_element": "Laser_in", "end_element": "HWP1", "end_reason": "element"}, {"id": "s1", "branch": "Laser_in", "source_id": "Laser_in", "start": [32.0, 70.0], "end": [32.00000000000001, 135.0], "direction_deg": 90.0, "length_mm": 64.99999999999999, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 100.0, "jones": [[0.7071067811865475, 0.0], [0.7071067811865476, -6.123233995736767e-17]], "polarization_label": "D", "waist_z_mm": -40.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.800044805505728, "w_end_mm": 0.80030868702883, "start_element": "HWP1", "end_element": "PBS1", "end_reason": "element"}, {"id": "s2", "branch": "Laser_in.t", "source_id": "Laser_in", "start": [32.00000000000001, 135.0], "end": [32.000000000000014, 204.0], "direction_deg": 90.0, "length_mm": 68.99999999999999, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 49.999999999999986, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -104.999