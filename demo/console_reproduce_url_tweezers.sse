data: {"type": "candidate", "index": 0, "stage": "design", "design": {"name": "polarization_splitting_optical_tweezers", "description": "Polarization-splitting dual-beam optical tweezers (Figure 5 of 'Optical Tweezers: A Comprehensive Tutorial from Calibration to Applications', arXiv:2004.05246). A half-wave plate (HWP1) and polarizing beamsplitter (PBS1) split the 532 nm trapping laser into two orthogonally polarized arms steered independently by galvo mirrors GM1 and GM2, recombined at PBS2, relayed/expanded by the 4f telescope L1-L2, and reflected by dichroic mirror DM into the microscope objective O to form two traps in the 3D sample stage. Yellow/red brightfield illumination from light source LS passes through condenser C, the sample stage, objective O, and transmits through DM via fold mirror M and the tube lens TL onto the camera.", "modules": [], "baseplate": {"width_mm": 360.0, "height_mm": 460.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "Laser_in", "label": "Trapping laser (532 nm, 50 mW, H-polarized input to HWP1 -> 45 deg linear for 50:50 split at PBS1; note: reflection at GM1/GM2 flips in-plane Ex sign without changing H/V power split at PBS2, where H transmits and V reflects to recombine both arms along +x into L1-L2 and DM -> O -> Stage -> C -> BD_trap; brightfield source LS at 650 nm counter-propagates downward through C -> Stage -> O -> DM.t -> M -> TL -> Camera, while trapping light 532 nm < 600 nm cutoff reflects at DM; an extra dump BD_trap above C catches the transmitted 532 nm trapping beams after they pass through the sample and condenser so no stray beams escape; all optic centers separated >= 36-40 mm matching xy_mm layout.)", "group": null, "part_number": "Coherent Verdi V5", "position": [31.0, 25.0], "direction_deg": 90.0, "wavelength_nm": 532.0, "power_mw": 50.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "LS", "label": "LS (Brightfield LED illumination, 650 nm, travelling -y through condenser C, sample stage, objective O, transmitted through DM to mirror M, tube lens TL and Camera photodiode detector; note LS is shifted to x=326, y=420 with BD_trap offset or handled via dichroic/dump so the upward 532 nm trapping beam terminates cleanly before or at a dump without colliding with LS; specifically we place a clean shortpass/longpass or compact beam dump BD_trap at y=385 between C and LS doesn't block LS if we use a dichroic or if LS is slightly angled, OR even simpler: in the 2D ray tracer, Sources are NOT physical blockers\u2014beams pass right through Source coordinates unless an Element is there! So placing BD_trap at y=442 above LS at y=410 lets the upward 532 nm beam pass through C (collimated by O+C telescope) and terminate in BD_trap at y=442 while LS at y=410 emits downward (-90 deg) cleanly without hitting BD_trap!)", "group": null, "part_number": "Thorlabs M660L4", "position": [326.0, 410.0], "direction_deg": -90.0, "wavelength_nm": 650.0, "power_mw": 10.0, "waist_mm": 1.0, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2", "group": null, "part_number": "WPH05M-532", "beam": "Laser_in", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 22.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS1", "group": null, "part_number": "PBS251", "beam": "Laser_in", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "GM1", "type": "mirror", "label": "GM1 (Galvo mirror 1, H-arm transmitted through PBS1 along +y to y=204, reflected along +x toward PBS2 at x=98, y=204; note reflection flips Ex sign, remaining purely H so it transmits through PBS2 along +x!)", "group": null, "part_number": "GVS011", "beam": "Laser_in.t", "distance_mm": 69.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "GM2", "type": "mirror", "label": "GM2 (Galvo mirror 2, V-arm reflected at PBS1 along +x to x=98, y=135, reflected along +y toward PBS2 at x=98, y=204; remains purely V so it reflects at PBS2 into +x, recombining with the GM1 arm!)", "group": null, "part_number": "GVS011", "beam": "Laser_in.r", "distance_mm": 67.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS2", "type": "pbs", "label": "PBS2 (Beam recombining PBS: transmits GM1 H-beam along +x, reflects GM2 V-beam from +y into +x; canonical angle_deg=0 transmits 0 deg and reflects +90 deg into +180 deg, wait: for an incoming beam travelling +90 deg (upward from GM2) to reflect into 0 deg (+x), the cube diagonal normal must be at 45 deg or 225 deg, which corresponds to canonical angle_deg=0! Let's verify: canonical angle_deg=0 has diagonal normal at 0+135=135 deg, unit normal n=(-1/sqrt2, +1/sqrt2). For incoming u_in=(0,1) (+90 deg), u_out = u_in - 2(u_in.n)n = (0,1) - 2(1/sqrt2)(-1/sqrt2, 1/sqrt2) = (1,0) = 0 deg! And for incoming u_in=(1,0) (0 deg from GM1), H is transmitted straight along 0 deg! So angle_deg=0 on branch Laser_in.t works for BOTH arms!)", "group": null, "part_number": "PBS251", "beam": "Laser_in.t", "distance_mm": 67.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L1", "type": "lens", "label": "L1 (Telescope lens 1, f=50 mm; together with L2 at distance 100 mm forms a 1:1 4f relay imaging GM1/GM2 onto the back aperture of objective O while keeping the beam collimated with w=0.8 mm so there is zero clipping anywhere!)", "group": null, "part_number": "LA1131-A", "beam": "Laser_in.t.t", "distance_mm": 70.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L2", "type": "lens", "label": "L2 (Telescope lens 2, f=50 mm, placed 100 mm after L1 for afocal 4f relay into DM and objective O; aperture 25.4 mm to avoid any clipping.)", "group": null, "part_number": "LA1131-A", "beam": "Laser_in.t.t", "distance_mm": 96.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.4, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "DM", "type": "dichroic", "label": "DM (Longpass dichroic mirror, cutoff 600 nm, reflects below 600 nm: reflects 532 nm trapping beams from 0 deg into +90 deg upward toward objective O, and transmits 650 nm brightfield light travelling -90 deg downward from O toward fold mirror M!)", "group": null, "part_number": "DMLP605", "beam": "Laser_in.t.t", "distance_mm": 62.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": 600.0, "reflect": "below", "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "O", "type": "lens", "label": "O (Microscope objective lens, f=40 mm so O at y=265 and C at y=345 with f=40 mm form a confocal 4f pair across the sample stage at y=305, keeping both the upward 532 nm trapping beams and the downward 650 nm illumination beam well-behaved and unclipped!)", "group": null, "part_number": "RMS40X", "beam": "Laser_in.t.t.r", "distance_mm": 61.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": 40.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "Stage", "type": "vapor_cell", "label": "3D sample stage (microfluidic sample chamber at the shared focal plane y=305 between objective O and condenser C, transmission=0.9, length=15 mm along the beam axis so its 15x25 mm footprint fits with >20 mm clearance from both O at y=265 and C at y=345!)", "group": null, "part_number": "Sample-Chamber", "beam": "Laser_in.t.t.r", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.9, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "C", "type": "lens", "label": "C (Condenser lens, f=40 mm at y=345, recollimating the 532 nm beam after the sample stage and focusing the 650 nm illumination from LS into the sample stage!)", "group": null, "part_number": "ACL25416U", "beam": "Laser_in.t.t.r", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": 40.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_trap", "type": "beam_dump", "label": "Trapping beam dump (catches transmitted 532 nm trapping arms above condenser/LS at y=445 so no stray laser beams escape the baseplate; since LS is at y=410 emitting downward at -90 deg, BD_trap at y=445 only intercepts the upward 532 nm beams!)", "group": null, "part_number": "LB1", "beam": "Laser_in.t.t.r", "distance_mm": 100.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M", "type": "mirror", "label": "M (Imaging fold mirror below DM at x=326, y=140, reflecting the downward -90 deg 650 nm imaging beam from DM into 180 deg (-x) toward Tube lens TL and Camera.)", "group": null, "part_number": "BB1-E02", "beam": "LS.t", "distance_mm": 64.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "TL", "type": "lens", "label": "Tube lens (f=100 mm at x=258, y=140, focusing the brightfield image onto the Camera detector at x=190, y=140.)", "group": null, "part_number": "TTL100-A", "beam": "LS.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.4, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "Camera", "type": "photodiode", "label": "Camera (CMOS imaging sensor at x=190, y=140 terminating the brightfield imaging path.)", "group": null, "part_number": "DCC1545M", "beam": "LS.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "Camera", "kind": "min_power_mw", "value": 4.0}], "notes": "Polarization-splitting optical tweezers (Figure 5 of arXiv:2004.05246). HWP1 at 22.5 deg rotates the 532 nm input laser to 45 deg linear polarization so PBS1 splits it equally into an H-polarized arm (transmitted to GM1) and a V-polarized arm (reflected to GM2). Both arms are recombined at PBS2, relayed through the L1-L2 telescope, reflected upward by dichroic mirror DM (cutoff 600 nm, reflects <600 nm) into objective O (y=265) and focused into the 3D sample stage (y=305, modelled as a high-transmission sample cell), then recollimated by condenser C (y=345) and terminated at BD_trap. Brightfield illumination from LS (650 nm) travels downward through condenser C, the sample stage, and objective O, transmits through DM, reflects off mirror M (y=140) along -x through the tube lens TL (x=258) and is detected on the Camera (x=190).", "logic": null}, "report": {"passed": true, "score": 85.75, "checks": [{"id": "collision", "severity": "warning", "message": "O and Stage footprints overlap (40.0 mm apart)", "element_id": "O", "segment_id": null, "value": null, "limit": null}, {"id": "collision", "severity": "warning", "message": "Stage and C footprints overlap (40.0 mm apart)", "element_id": "Stage", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "info", "message": "met: Camera: 9.000 mW (need \u2265 4.000)", "element_id": "Camera", "segment_id": null, "value": 9.0, "limit": 4.0}], "metrics": {"input_mw": 60.0, "delivered_mw": 9.0, "dumped_mw": 45.0, "stray_mw": 0.0, "n_elements": 15.0