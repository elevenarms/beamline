m_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "Camera", "kind": "min_power_mw", "value": 4.0}], "notes": "Polarization-splitting optical tweezers (Figure 5 of arXiv:2004.05246). HWP1 at 22.5 deg rotates the 532 nm input laser to 45 deg linear polarization so PBS1 splits it equally into an H-polarized arm (transmitted to GM1) and a V-polarized arm (reflected to GM2). Both arms are recombined at PBS2, relayed through the L1-L2 telescope, reflected upward by dichroic mirror DM (cutoff 600 nm, reflects <600 nm) into objective O (y=260) and focused into the 3D sample stage (y=310, modelled as a high-transmission sample cell), then recollimated by condenser C (y=360) and terminated at BD_trap (y=455). Brightfield illumination from LS (650 nm) travels downward through condenser C, the sample stage, and objective O, transmits through DM, reflects off mirror M (y=140) along -x through the tube lens TL (x=258) and is detected on the Camera (x=190).", "logic": null}, "report": {"passed": true, "score": 95.75, "checks": [{"id": "target", "severity": "info", "message": "met: Camera: 9.000 mW (need \u2265 4.000)", "element_id": "Camera", "segment_id": null, "value": 9.0, "limit": 4.0}], "metrics": {"input_mw": 60.0, "delivered_mw": 9.0, "dumped_mw": 45.0, "stray_mw": 0.0, "n_elements": 15.0, "n_segments": 27.0, "target.Camera.min_power_mw": 9.0, "delivered_fraction": 0.15}}, "trace": {"segments": [{"id": "s0", "branch": "Laser_in", "source_id": "Laser_in", "start": [31.0, 25.0], "end": [31.000000000000004, 70.0], "direction_deg": 90.0, "length_mm": 45.0, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 50.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8000567065464069, "start_element": "Laser_i