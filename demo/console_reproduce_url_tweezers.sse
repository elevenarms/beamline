data: {"type": "final", "design": {"name": "polarization_splitting_optical_tweezers", "description": "Polarization-splitting dual-beam optical tweezers (Figure 5 of 'Optical Tweezers: A Comprehensive Tutorial from Calibration to Applications', arXiv:2004.05246). A half-wave plate (HWP1) and polarizing beamsplitter (PBS1) split the 532 nm trapping laser into two orthogonally polarized arms steered independently by galvo mirrors GM1 and GM2, recombined at PBS2, relayed/expanded by the 4f telescope L1-L2, and reflected by dichroic mirror DM into the microscope objective O to form two traps in the 3D sample stage. Yellow/red brightfield illumination from light source LS passes through condenser C, the sample stage, objective O, and transmits through DM via fold mirror M and the tube lens TL onto the camera.", "modules": [], "baseplate": {"width_mm": 360.0, "height_mm": 480.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "Laser_in", "label": "Trapping laser (532 nm, 50 mW, H-polarized input to HWP1 -> 45 deg linear for 50:50 split at PBS1; recombined at PBS2 along +x into L1-L2 and DM -> O -> Stage -> C -> BD_trap.)", "group": null, "part_number": "Coherent Verdi V5", "position": [31.0, 25.0], "direction_deg": 90.0, "wavelength_nm": 532.0, "power_mw": 50.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "LS", "label": "LS (Brightfield LED illumination, 650 nm, travelling -y through condenser C, sample stage, objective O, transmitted through DM to mirror M, tube lens TL and Camera detector.)", "group": null, "part_number": "Thorlabs M660L4", "position": [326.0, 425.0], "direction_deg": -90.0, "wavelength_nm": 650.0, "power_mw": 10.0, "waist_mm": 1.0, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2", "group": null, "part_number": "WPH05M-532", "beam": "Laser_in", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 22.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS1", "group": null, "part_number": "PBS251", "beam": "Laser_in", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "GM1", "type": "mirror", "label": "GM1", "group": null, "part_number": "GVS011", "beam": "Laser_in.t", "distance_mm": 69.0, "at": null, "angle_deg": null, "out_direction_deg": 0.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "GM2", "type": "mirror", "label": "GM2", "group": null, "part_number": "GVS011", "beam": "Laser_in.r", "distance_mm": 67.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS2", "type": "pbs", "label": "PBS2", "group": null, "part_number": "PBS251", "beam": "Laser_in.t", "distance_mm": 67.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L1", "type": "lens", "label": "L1", "group": null, "part_number": "LA1131-A", "beam": "Laser_in.t.t", "distance_mm": 70.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "L2", "type": "lens", "label": "L2", "group": null, "part_number": "LA1131-A", "beam": "Laser_in.t.t", "distance_mm": 96.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.4, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "DM", "type": "dichroic", "label": "DM", "group": null, "part_number": "DMLP605", "beam": "Laser_in.t.t", "distance_mm": 62.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": 600.0, "reflect": "below", "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "O", "type": "lens", "label": "O", "group": null, "part_number": "RMS40X", "beam": "Laser_in.t.t.r", "distance_mm": 56.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "Stage", "type": "vapor_cell", "label": "3D sample stage", "group": null, "part_number": "Sample-Chamber", "beam": "Laser_in.t.t.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.9, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "C", "type": "lens", "label": "C", "group": null, "part_number": "ACL25416U", "beam": "Laser_in.t.t.r", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": 50.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_trap", "type": "beam_dump", "label": "Trapping beam dump", "group": null, "part_number": "LB1", "beam": "Laser_in.t.t.r", "distance_mm": 95.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M", "type": "mirror", "label": "M", "group": null, "part_number": "BB1-E02", "beam": "LS.t", "distance_mm": 64.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "TL", "type": "lens", "label": "Tube lens", "group": null, "part_number": "TTL100-A", "beam": "LS.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.4, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "Camera", "type": "photodiode", "label": "Camera", "group": null, "part_number": "DCC1545M", "beam": "LS.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "Camera", "kind": "min_power_mw", "value": 4.0}], "notes": "Polarization-splitting optical tweezers (Figure 5 of arXiv:2004.05246). HWP1 at 22.5 deg rotates the 532 nm input laser to 45 deg linear polarization so PBS1 splits it equally into an H-polarized arm (transmitted to GM1) and a V-polarized arm (reflected to GM2). Both arms are recombined at PBS2, relayed through the L1-L2 telescope, reflected upward by dichroic mirror DM (cutoff 600 nm, reflects <600 nm) into objective O (y=260) and focused into the 3D sample stage (y=310, modelled as a high-transmission sample cell), then recollimated by condenser C (y=360) and terminated at BD_trap (y=455). Brightfield illumination from LS (650 nm) travels downward through condenser C, the sample stage, and objective O, transmits through DM, reflects off mirror M (y=140) along -x through the tube lens TL (x=258) and is detected on the Camera (x=190).", "logic": null}, "report": {"passed": true, "score": 95.75, "checks": [{"id": "target", "severity": "info", "message": "met: Camera: 9.000 mW (need \u2265 4.000)", "element_id": "Camera", "segment_id": null, "value": 9.0, "limit": 4.0}], "metrics": {"input_mw": 60.0, "delivered_mw": 9.0, "dumped_mw": 45.0, "stray_mw": 0.0, "n_elements": 15.0, "n_segments": 27.0, "target.Camera.min_power_mw": 9.0, "delivered_fraction": 0.15}}, "trace": {"segments": [{"id": "s0", "branch": "Laser_in", "source_id": "Laser_in", "start": [31.0, 25.0], "end": [31.000000000000004, 70.0], "direction_deg": 90.0, "length_mm": 45.0, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 50.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8000567065464069, "start_element": "Laser_in", "end_element": "HWP1", "end_reason": "element"}, {"id": "s1", "branch": "Laser_in", "source_id": "Laser_in", "start": [31.000000000000004, 70.0], "end": [31.000000000000007, 135.0], "direction_deg": 90.0, "length_mm": 65.0, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 50.0, "jones": [[0.7071067811865475, 0.0], [0.7071067811865476, -6.123233995736767e-17]], "polarization_label": "D", "waist_z_mm": -45.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8000567065464069, "w_end_mm": 0.8003387793936255, "start_element": "HWP1", "end_element": "PBS1", "end_reason": "element"}, {"id": "s2", "branch": "Laser_in.t", "source_id": "Laser_in", "start": [31.000000000000007, 135.0], "end": [31.00000000000001, 204.0], "direction_deg": 90.0, "length_mm": 69.0, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 24.999999999999993, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -110.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8003387793936255, "w_end_mm": 0.8008967807471431, "start_element": "PBS1", "end_element": "GM1", "end_reason": "element"}, {"id": "s3", "branch": "Laser_in.t", "source_id": "Laser_in", "start": [31.00000000000001, 204.0], "end": [98.00000000000004, 203.99999999999997], "direction_deg": -1.2722218725854067e-14, "length_mm": 67.00000000000003, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 24.999999999999993, "jones": [[1.0, -1.2246467991473532e-16], [-0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -179.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8008967807471431, "w_end_mm": 0.8016929124761919, "start_element": "GM1", "end_element": "PBS2", "end_reason": "element"}, {"id": "s4", "branch": "Laser_in.t.t", "source_id": "Laser_in", "start": [98.00000000000004, 203.99999999999997], "end": [168.0, 203.99999999999994], "direction_deg": -1.2722218725854067e-14, "length_mm": 69.99999999999996, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 24.999999999999993, "jones": 