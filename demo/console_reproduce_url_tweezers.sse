data: {"type": "candidate", "index": 1, "stage": "repair", "round": 1, "design": {"name": "polarization_splitting_optical_tweezers", "description": "Polarization-splitting dual-beam optical tweezers (Figure 5 of 'Optical Tweezers: A Comprehensive Tutorial from Calibration to Applications', arXiv:2004.05246). A half-wave plate (HWP1) and polarizing beamsplitter (PBS1) split the 532 nm trapping laser into two orthogonally polarized arms steered independently by galvo mirrors GM1 and GM2, recombined at PBS2, relayed/expanded by the 4f telescope L1-L2, and reflected by dichroic mirror DM into the microscope objective O to form two traps in the 3D sample stage. Yellow/red brightfield illumination from light source LS passes through condenser C, the sample stage, objective O, and transmits through DM via fold mirror M and the tube lens TL onto the camera.", "modules": [], "baseplate": {"width_mm": 360.0, "height_mm": 480.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "Laser_in", "label": "Trapping laser (532 nm, 50 mW, H-polarized input to HWP1 -> 45 deg linear for 50:50 split at PBS1; recombined at PBS2 along +x into L1-L2 and DM -> O -> Stage -> C -> BD_trap.)", "group": null, "part_number": "Coherent Verdi V5", "position": [31.0, 25.0], "direction_deg": 90.0, "wavelength_nm": 532.0, "power_mw": 50.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}, {"id": "LS", "label": "LS (Brightfield LED illumination, 650 nm, travelling -y through condenser C, sample stage, objective O, transmitted through DM to mirror M, tube lens TL and Camera detector.)", "group": null, "part_number": "Thorlabs M660L4", "position": [326.0, 425.0], "direction_deg": -90.0, "wavelength_nm": 650.0, "power_mw": 10.0, "waist_mm": 1.0, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2", "group": null, "part_number": "WPH05M-532", "beam": "Laser_