, 309.9999999999999], "angle_deg": 90.0, "hits": [{"segment_id": "s8", "power_in_mw": 24.999999999999993, "w_mm": 0.06575451246115369, "clip_loss": 0.0, "offset_mm": 0.0}, {"segment_id": "s17", "power_in_mw": 25.000000000000007, "w_mm": 0.06575451246115367, "clip_loss": 0.0, "offset_mm": 0.0}, {"segment_id": "s21", "power_in_mw": 10.0, "w_mm": 0.010345071300973199, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "C", "type": "lens", "placed": true, "position": [326.0, 359.9999999999999], "angle_deg": 90.0, "hits": [{"segment_id": "s9", "power_in_mw": 22.499999999999993, "w_mm": 0.7604721446343751, "clip_loss": 0.0, "offset_mm": 0.0}, {"segment_id": "s18", "power_in_mw": 22.500000000000007, "w_mm": 0.7604721446343748, "clip_loss": 0.0, "offset_mm": 0.0}, {"segment_id": "s20", "power_in_mw": 10.0, "w_mm": 1.000090428234055, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "BD_trap", "type": "beam_dump", "placed": true, "position": [326.0, 454.9999999999999], "angle_deg": 90.0, "hits": [{"segment_id": "s10", "power_in_mw": 22.499999999999993, "w_mm": 0.8838548911609039, "clip_loss": 0.0, "offset_mm": 0.0}, {"segment_id": "s19", "power_in_mw": 22.500000000000007, "w_mm": 0.8838548911609037, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": 45.0, "error": null}, {"id": "M", "type": "mirror", "placed": true, "position": [326.0, 139.99999999999991], "angle_deg": 135.0, "hits": [{"segment_id": "s24", "power_in_mw": 9.0, "w_mm": 1.0001546326671904, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "TL", "type": "lens", "placed": true, "position": [258.0, 139.99999999999994], "angle_deg": 180.0, "hits": [{"segment_id": "s25", "power_in_mw": 9.0, "w_mm": 1.0005009231159567, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": null, "error": null}, {"id": "Camera", "type": "photodiode", "placed": true, "position": [190.0, 139.99999999999997], "angle_deg": 180.0, "hits": [{"segment_id": "s26", "power_in_mw": 9.0, "w_mm": 0.3209136968637476, "clip_loss": 0.0, "offset_mm": 0.0}], "coupling_efficiency": null, "power_out_mw": 9.0, "error": null}], "branches": ["Laser_in", "Laser_in.t", "Laser_in.t.t", "Laser_in.t.t.r", "Laser_in.r", "Laser_in.r.r", "Laser_in.r.r.r", "LS", "LS.t"], "nonconverged": []}, "report": {"passed": true, "score": 95.75, "checks": [{"id": "target", "severity": "info", "message": "met: Camera: 9.000 mW (need \u2265 4.000)", "element_id": "Camera", "segment_id": null, "value": 9.0, "limit": 4.0}], "metrics": {"input_mw": 60.0, "delivered_mw": 9.0, "dumped_mw": 45.0, "stray_mw": 0.0, "n_elements": 15.0, "n_segments": 27.0, "target.Camera.min_power_mw": 9.0, "delivered_fraction": 0.15}}, "parent_seq": 1, "diff": [{"op": "move", "element_id": "O", "field": "distance_mm", "from": 61.0, "to": 56.0, "note": "distance_mm: 61 \u2192 56 \u2014 Set focal_length_mm to 50 mm (placed 56 mm above DM at y=260) to match the increased 50 mm working distance to Stage."}, {"op": "param", "element_id": "O", "field": "focal_length_mm", "from": 40.0, "to": 50.0, "note": "focal_length_mm: 40 \u2192 50 \u2014 Set focal_length_mm to 50 mm (placed 56 mm above DM at y=260) to match the increased 50 mm working distance to Stage."}, {"op": "move", "element_id": "Stage", "field": "distance_mm", "from": 40.0, "to": 50.0, "note": "distance_mm: 40 \u2192 50 \u2014 Increased distance_mm from O to 50 mm (at y=310) so the 37.5 mm half-length of the vapor_cell footprint clears the 7.5 mm half-length of O (37.5 + 7.5 = 45 mm < 50 mm)."}, {"op": "move", "element_id": "C", "field": "distance_mm", "from": 40.0, "to": 50.0, "note": "distance_mm: 40 \u2192 50 \u2014 Increased distance_mm from Stage to 50 mm (at y=360) and focal_length_mm to 50 mm so its footprint clears Stage (45 mm < 50 mm) while keeping the confocal 4f relay."}, {"op": "param", "element_id": "C", "field": "focal_length_mm", "from": 40.0, "to": 50.0, "note": "focal_length_mm: 40 \u2192 50 \u2014 Increased distance_mm from Stage to 50 mm (at y=360) and focal_length_mm to 50 mm so its footprint clears Stage (45 mm < 50 mm) while keeping the confocal 4f relay."}, {"op": "move", "element_id": "BD_trap", "field": "distance_mm", "from": 100.0, "to": 95.0, "note": "distance_mm: 100 \u2192 95 \u2014 Adjusted distance_mm after C to 95 mm (at y=455) to stay well within the 480 mm baseplate."}], "rationale": "Increased the focal lengths and separation of objective O, sample stage Stage, and condenser C from 40 mm to 50 mm (and enlarged the baseplate height to 480 mm) so the 75x25 mm vapor_cell footprint of Stage no longer overlaps with the 15x25 mm lens footprints of O and C."}

