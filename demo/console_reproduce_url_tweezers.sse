 "beam_dump", "label": "Trapping beam dump", "group": null, "part_number": "LB1", "beam": "Laser_in.t.t.r", "distance_mm": 95.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M", "type": "mirror", "label": "M", "group": null, "part_number": "BB1-E02", "beam": "LS.t", "distance_mm": 64.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "TL", "type": "lens", "label": "Tube lens", "group": null, "part_number": "TTL100-A", "beam": "LS.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.4, "focal_length_mm": 100.0, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "Camera", "type": "photodiode", "label": "Camera", "group": null, "part_number": "DCC1545M", "beam": "LS.t", "distance_mm": 68.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 20.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "Camera", "kind": "min_power_mw", "value": 4.0}], "notes": "Polarization-splitting optical tweezers (Figure 5 of arXiv:2004.05246). HWP1 at 22.5 deg rotates the 532 nm input laser to 45 deg linear polarization so PBS1 splits it equally into an H-polarized arm (transmitted to GM1) and a V-polarized arm (reflected to GM2). Both arms are recombined at PBS2, relayed through the L1-L2 telescope, reflected upward by dichroic mirror DM (cutoff 600 nm, reflects <600 nm) into objective O (y=260) and focused into the 3D sample stage (y=310, modelled as a high-transmission sample cell), then recollimated by condenser C (y=360) and terminated at BD_trap (y=455). Brightfield illumination from LS (650 nm) travels downward through condenser C, the sample stage, and objective O, transmits through DM, reflects off mirror M (y=140) along -x through the tube lens TL (x=258) and is detected on the Camera (x=190).", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "Laser_in", "source_id": "Laser_in", "start": [31.0, 25.0], "end": [31.000000000000004, 70.0], "direction_deg": 90.0, "length_mm": 45.0, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 50.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 3779.3595832659166, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8000567065464069, "start_element": "Laser_in", "end_element": "HWP1", "end_reason": "element"}, {"id": "s1", "branch": "Laser_in", "source_id": "Laser_in", "start": [31.000000000000004, 70.0], "end": [31.000000000000007, 135.0], "direction_deg": 90.0, "length_mm": 65.0, "wavelength_nm": 532.0, "freq_shift_mhz": 0.0, "power_mw": 50.0, "jones": [[0.7071067811865475, 0.0], [0.7071067811865476, -6.123233995736767e-17]], "polarization_label": "D