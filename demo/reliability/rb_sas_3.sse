data: {"type": "iteration", "agent_id": "synth-2", "seq": 3, "label": "synthesized design 2", "design": {"name": "rb_sas_1inch_mounted_optics", "description": "Rb-87 saturated absorption spectroscopy at 780 nm using 1-inch mounted optics (from PyOpticL paper Fig. 2a). An input beam enters from the bottom right, passes through HWP_IN and PBS_IN to pick off the spectroscopy branch (reflected left), while the transmitted main beam continues up to a dump. Mirror M1 folds the branch down into a 10:90 beam sampler BS1. The 10% reflected probe passes through HWP_PROBE (rotating V to H), folds via M2 and M3, and travels left through the 75 mm Rb vapor cell and PBS1 onto photodiode PD1. The 90% transmitted V-polarized pump folds via M4, passes through HWP_PUMP, folds up via M5 into PBS1, which reflects it right to counter-propagate through the Rb cell against the probe.", "modules": [], "baseplate": {"width_mm": 485.0, "height_mm": 195.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "IN", "label": "branch", "group": null, "part_number": "Toptica DL pro 780", "position": [445.0, 44.0], "direction_deg": 90.0, "wavelength_nm": 780.0, "power_mw": 10.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP_IN", "type": "half_wave_plate", "label": "lambda/2", "group": null, "part_number": "WPH10M-780", "beam": "IN", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 22.5, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS_IN", "type": "pbs", "label": "PBS", "group": null, "part_number": "PBS252", "beam": "IN", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_MAIN", "type": "beam_dump", "label": "Main trunk continuation dump", "group": null, "part_number": "LB1", "beam": "IN.t", "distance_mm": 32.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "mirror", "group": null, "part_number": "BB1-E03", "beam": "IN.r", "distance_mm": 91.0, "at": null, "angle_deg": null, "out_direction_deg": 270.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BS1", "type": "sampler", "label": "beam sampler", "group": null, "part_number": "BSF10-B", "beam": "IN.r", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_m