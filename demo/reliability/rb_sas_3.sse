: null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_auto2", "type": "beam_dump", "label": "auto dump (0.27 mW)", "group": null, "part_number": null, "beam": "IN.r.t.r.r.t", "distance_mm": 20.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD1", "kind": "min_power_mw", "value": 0.15}], "notes": "1-inch mounted Rb-87 saturated absorption spectroscopy setup from PyOpticL Fig. 2a. Probe (10% reflection at BS1, rotated to H by HWP_PROBE) passes left through CELL and PBS1 to PD1 (~0.3 mW). Pump (90% transmission at BS1, kept V by HWP_PUMP) is injected into CELL by reflection at PBS1 and exits right along the probe periscope to BD_PUMP.", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "IN", "source_id": "IN", "start": [445.0, 44.0], "end": [445.0, 94.0], "direction_deg": 90.0, "length_mm": 50.0, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 10.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 2577.7170490993176, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8001504834251492, "start_element": "IN", "end_element": "HWP_IN", "end_reason": "element"}, {"id": "s1", "branch": "IN", "source_id": "IN", "start": [445.0, 94.0], "end": [445.0, 149.0], "direction_deg": 90.0, "length_mm": 54.99999999999999, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 10.0, "jones": [[0.7071067811865475, 0.0], [0.7071067811865476, -6.123233995736767e-17]], "polarization_