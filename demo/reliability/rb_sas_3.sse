data: {"type": "iteration", "agent_id": "synth-1", "seq": 2, "label": "autofix", "design": {"name": "rb87_sas_1inch_mounted", "description": "Rb-87 saturated absorption spectroscopy (780 nm) using 1-inch mounted optics, reproducing Fig. 2a of the PyOpticL paper. An input beam is split by a half-wave plate and PBS to pick off a spectroscopy branch. A 10:90 beam sampler splits the branch into a weak probe (10% reflected) and a strong pump (90% transmitted). The H-polarized probe is folded by two mirrors through the Rb vapor cell and PBS1 onto photodiode PD1; the V-polarized pump is steered around the lower path and reflected by PBS1 to counter-propagate through the Rb cell.", "modules": [], "baseplate": {"width_mm": 485.0, "height_mm": 185.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "IN", "label": "branch", "group": null, "part_number": "Toptica DL pro 780", "position": [445.0, 44.0], "direction_deg": 90.0, "wavelength_nm": 780.0, "power_mw": 20.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP_IN", "type": "half_wave_plate", "label": "lambda/2", "group": null, "part_number": "WPH10M-780", "beam": "IN", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 15.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS_IN", "type": "pbs", "label": "PBS", "group": null, "part_number": "PBS252", "beam": "IN", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "ao