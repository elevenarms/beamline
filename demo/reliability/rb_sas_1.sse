data: {"type": "iteration", "agent_id": "synth-1", "seq": 1, "label": "synthesized design 1", "design": {"name": "rb_sas_1inch_mounted_optics", "description": "Rb-87 saturated absorption spectroscopy at 780 nm using 1-inch mounted optics (PyOpticL paper Fig. 2a). An input beam is picked off by HWP1 + PBS1 into the spectroscopy branch, where a beam sampler (BS1) splits it into a 10% probe (reflected) and a 90% pump (transmitted). The probe polarization is rotated from V to H by HWP2, folded by M2 and M3 through the Rb vapor cell, and transmitted through PBS2 onto photodiode PD1. The V-polarized pump is routed via M4 and M5 to PBS2, which reflects it counter-propagating through the Rb cell; the returning pump reflects at BS1 (10% dumped at BD_PUMP2) and transmits (90%) via M1 and PBS1 to BD_PUMP1.", "modules": [], "baseplate": {"width_mm": 480.0, "height_mm": 185.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "IN", "label": "780 nm input beam", "group": null, "part_number": "Toptica DL pro 780", "position": [443.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 780.0, "power_mw": 20.0, "waist_mm": 0.8, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2 (branch pickoff)", "group": null, "part_number": "WPH10M-780", "beam": "IN", "distance_mm": 64.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 13.3, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "Branch pickoff PBS", "group": null, "part_number": "PBS252", "beam": "IN", "distance_mm": 49.0, "at": null, "angle_deg": null, "out_direction_deg"