fficiency_per_w": null}, {"id": "HWP3", "type": "half_wave_plate", "label": "Pump lambda/2", "group": null, "part_number": "WPH10M-780", "beam": "IN.r.t", "distance_mm": 116.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 0.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M5", "type": "mirror", "label": "Pump fold mirror 2", "group": null, "part_number": "BB1-E03", "beam": "IN.r.t", "distance_mm": 144.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_PUMP1", "type": "beam_dump", "label": "Counter-propagated pump dump", "group": null, "part_number": "LB1", "beam": null, "distance_mm": null, "at": [352.0, 175.0], "angle_deg": -90.0, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_PUMP2", "type": "beam_dump", "label": "Sampler-reflected pump dump", "group": null, "part_number": "LB1", "beam": null, "distance_mm": null, "at": [468.0, 108.0], "angle_deg": 180.0, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD1", "kind": "min_power_mw", "value": 0.14}], "notes": "1-inch mounted Rb-87 saturated absorption spectroscopy setup from PyOpticL Fig. 2a. HWP1 rotates ~20% (4 mW) of the 20 mW input into V so PBS1 reflects it into the spectroscopy branch. BS1 reflects 10% (0.4 mW) as the probe and transmits 90% (3.6 mW) as the pump. HWP2 (45 deg) rotates the probe from V to H so it transmits through PBS2 to PD1 (~0.28 mW after 70% Rb cell transmission). HWP3 (0 deg) keeps the pump V-polarized so PBS2 reflects it (+x) counter-propagating through the cell; after M3->M2->HWP2 (rotated to H) the spent pump is dumped at BD_PUMP1 (90% transmitted through BS1) and BD_PUMP2 (10% reflected at BS1).", "logic": null}, "report": {"passed": true, "score": 95.9723677735997, "checks": [{"id": "no_light", "severity": "info", "message": "BD_PUMP1 receives no light", "element_id": "BD_PUMP1", "segment_id": null, "value": null, "limit": null}, {"id": "no_light", "severity": "info", "message": "BD_PUMP2 receives no light", "element_id": "BD_PUMP2", "segment_id": null, "value": null, "limit": null}, {"id": "target", "severity": "info", "message": "met: PD1: 3.889 mW (need \u2265 0.140)", "element_id": "PD1", "segment_id": null, "value": 3.8894710943988184, "limit": 0.14}], "metrics": {"input_mw": 20.0, "delivered_mw": 3.8894710943988184, "dumped_mw": 15.990235985155861, "stray_mw": 0.0, "n_elements": 16.0, "n_segments": 16.0, "target.PD1.min_power_mw": 3.8894710943988184, "delivered_fraction": 0.19447355471994093}}, "trace": {"segments": [{"id": "s0", "branch": "IN", "source_id": "IN", "start": [443.0, 30.0], "end": [443.0, 94.0], "direction_deg": 90.0, "lengt