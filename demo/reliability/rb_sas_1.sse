re_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD1", "kind": "min_power_mw", "value": 0.14}], "notes": "1-inch mounted Rb-87 saturated absorption spectroscopy setup from PyOpticL Fig. 2a. HWP1 rotates ~20% (4 mW) of the 20 mW input into V so PBS1 reflects it into the spectroscopy branch. BS1 reflects 10% (0.4 mW) as the probe and transmits 90% (3.6 mW) as the pump. HWP2 (45 deg) rotates the probe from V to H so it transmits through PBS2 to PD1 (~0.28 mW after 70% Rb cell transmission). HWP3 (0 deg) keeps the pump V-polarized so PBS2 reflects it (+x) counter-propagating through the cell; after M3->M2->HWP2 (rotated to H) the spent pump is dumped at BD_PUMP1 (90% transmitted through BS1) and BD_PUMP2 (10% reflected at BS1).", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "IN", "source_id": "IN", "start": [443.0, 30.0], "end": [443.0, 94.0], "direction_deg": 90.0, "length_mm": 64.0, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 2577.7170490993176, "w0_mm": 0.8, "w_start_mm": 0.8, "w_end_mm": 0.8002465372446289, "start_element": "IN", "end_element": "HWP1", "end_reason": "element"}, {"id": "s1", "branch": "IN", "source_id": "IN", "start": [443.0, 94.0], "end": [443.0, 143.0], "direction_deg": 90.0, "length_mm": 48.99999999999999, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[0.8941542368393682, 0.0], [0.4477590878387697, -3.066287174621958e-17]], "polarization_label": "linear 27\u00b0", "waist_z_mm": -64.0, "rayleigh_mm": 2577.7170490993176, "w0_mm": 0.8, "w_start_mm": 0.800246537244