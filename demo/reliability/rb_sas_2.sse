data: {"type": "iteration", "agent_id": "synth-1", "seq": 1, "label": "synthesized design 1", "design": {"name": "rb_sas_1in_mounted", "description": "Rb-87 saturated absorption spectroscopy (780 nm) using 1-inch mounted optics (reproducing Fig. 2a of the PyOpticL paper). An input beam is split at PBS1 after HWP1; the reflected branch is divided by a 10:90 beam sampler into a weak probe (10% reflection, rotated to H by HWP2 and steered through the Rb vapor cell and PBS2 onto photodiode PD) and a strong counter-propagating pump (90% transmission, steered via M4, HWP3 and M5 into PBS2 to overlap the probe inside the Rb cell).", "modules": [], "baseplate": {"width_mm": 485.0, "height_mm": 185.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "IN", "label": "780 nm input beam", "group": null, "part_number": "Toptica DL pro 780", "position": [448.0, 25.0], "direction_deg": 90.0, "wavelength_nm": 780.0, "power_mw": 20.0, "waist_mm": 1.0, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2 (branch split)", "group": null, "part_number": "WPH10M-780", "beam": "IN", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 15.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS (branch pickoff)", "group": null, "part_number": "PBS252", "beam": "IN", "distance_mm": 55.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficien