data: {"type": "candidate", "index": 0, "stage": "design", "design": {"name": "rb_sas_pyopticl_fig2a", "description": "Rb-87 saturated absorption spectroscopy at 780 nm using 1-inch mounted optics (reproducing PyOpticL paper Fig. 2a). An input beam is split at PBS1 after HWP1; the reflected spectroscopy branch is steered by M1 onto a 10:90 beam sampler (BS). The 10% reflected probe beam passes through HWP2 (rotating V to H), a two-mirror dogleg (M2, M3), the Rb vapor cell (CELL), and PBS2 onto photodiode PD. The 90% transmitted pump beam is steered around the lower path via M4, HWP3 (kept at V), and M5 into PBS2, which reflects it counter-propagating through the Rb cell to overlap the probe.", "modules": [], "baseplate": {"width_mm": 485.0, "height_mm": 185.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "IN", "label": "780 nm input beam", "group": null, "part_number": "Toptica DL pro 780", "position": [448.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 780.0, "power_mw": 20.0, "waist_mm": 1.0, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2 (branch split)", "group": null, "part_number": "WPH10M-780", "beam": "IN", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 15.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS (branch pickoff)", "group": null, "part_number": "PBS252", "beam": "IN", "distance_mm": 50.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD1", "type": "beam_dump", "label": "Main through-beam dump", "group": null, "part_number": "LB1", "beam": "IN.t", "distance_mm": 30.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "Branch fold mirror", "group": null, "part_number": "BB1-E03", "beam": "IN.r", "distance_mm": 98.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BS", "type": "sampler", "label": "Beam sampler (10/90)", "group": null, "part_number": "BSF10-B", "beam": "IN.r", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP2", "type": "half_wave_plate", "label": "lam