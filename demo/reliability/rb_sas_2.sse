data: {"type": "iteration", "agent_id": "repair-1", "seq": 5, "label": "repair 1", "design": {"name": "rb_sas_pyopticl_fig2a", "description": "Rb-87 saturated absorption spectroscopy at 780 nm using 1-inch mounted optics (reproducing PyOpticL paper Fig. 2a). An input beam is split at PBS1 after HWP1; the reflected spectroscopy branch is steered by M1 onto a 10:90 beam sampler (BS). The 10% reflected probe beam passes through HWP2 (rotating V to H), a two-mirror dogleg (M2, M3), the Rb vapor cell (CELL), and PBS2 onto photodiode PD. The 90% transmitted pump beam is steered around the lower path via M4, HWP3 (kept at V), and M5 into PBS2, which reflects it counter-propagating through the Rb cell to overlap the probe.", "modules": [], "baseplate": {"width_mm": 485.0, "height_mm": 185.0, "thickness_mm": 25.4, "optical_height_mm": 12.7, "grid_mm": 25.4}, "sources": [{"id": "IN", "label": "780 nm input beam", "group": null, "part_number": "Toptica DL pro 780", "position": [448.0, 30.0], "direction_deg": 90.0, "wavelength_nm": 780.0, "power_mw": 20.0, "waist_mm": 1.0, "waist_offset_mm": 0.0, "polarization": "H", "enabled": true}], "elements": [{"id": "HWP1", "type": "half_wave_plate", "label": "lambda/2 (branch split,group: null", "group": null, "part_number": "WPH10M-780", "beam": "IN", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 15.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS1", "type": "pbs", "label": "PBS (branch pickoff,group: null", "group": null, "part_number": "PBS252", "beam": "IN", "distance_mm": 65.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD1", "type": "beam_dump", "label": "Main through-beam dump", "group": null, "part_number": "LB1", "beam": "IN.t", "distance_mm": 22.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M1", "type": "mirror", "label": "Branch fold mirror", "group": null, "part_number": "BB1-E03", "beam": "IN.r", "distance_mm": 98.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BS", "type": "sampler", "label": "Beam sampler (10/90,group: null", "group": null, "part_number": "BSF10-B", "beam": "IN.r", "distance_mm": 40.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": 0.1, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP2", "type": "half_wave_plate", "label": "lambda/2 (probe V->H,group: null", "group": null, "part_number": "WPH10M-780", "beam": "IN.r.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 45.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M2", "type": "mirror", "label": "Probe mirror 1", "group": null, "part_number": "BB1-E03", "beam": "IN.r.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M3", "type": "mirror", "label": "Probe mirror 2", "group": null, "part_number": "BB1-E03", "beam": "IN.r.r", "distance_mm": 45.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "CELL", "type": "vapor_cell", "label": "Rb cell", "group": null, "part_number": "GC25075-RB", "beam": "IN.r.r", "distance_mm": 80.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": 25.0, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": 0.7, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PBS2", "type": "pbs", "label": "PBS (pump injection,group: null", "group": null, "part_number": "PBS252", "beam": "IN.r.r", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": -90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "PD", "type": "photodiode", "label": "PD (probe detector,group: null", "group": null, "part_number": "PDA36A2", "beam": "IN.r.r.t", "distance_mm": 60.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M4", "type": "mirror", "label": "Pump mirror 1", "group": null, "part_number": "BB1-E03", "beam": "IN.r.t", "distance_mm": 85.0, "at": null, "angle_deg": null, "out_direction_deg": 180.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "HWP3", "type": "half_wave_plate", "label": "lambda/2 (pump,group: null", "group": null, "part_number": "WPH10M-780", "beam": "IN.r.t", "distance_mm": 110.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 0.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M5", "type": "mirror", "label": "Pump mirror 2", "group": null, "part_number": "BB1-E03", "beam": "IN.r.t", "distance_mm": 145.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_auto1", "type": "beam_dump", "label": "Spent pump dump (transmitted at BS,group: null", "group": null, "part_number": "LB1", "beam": "IN.r.t.r.t", "distance_mm": 20.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_auto2", "type": "beam_dump", "label": "Spent pump dump (transmitted at PBS1,group: null", "group": null, "part_number": "LB1", "beam": "IN.r.t.r.r.t", "distance_mm": 20.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD", "kind": "min_power_mw", "value": 0.15}], "notes": "Layout follows Fig. 2a of the PyOpticL paper (1-inch mounted optics on a 485x185 mm baseplate). HWP1 sets ~25% (5 mW V-polarized) into the spectroscopy branch at PBS1. BS reflects 10% (0.5 mW) as the probe, rotated to H by HWP2 so it transmits through CELL and PBS2 to PD (~0.35 mW). The 90% transmitted pump (4.5 mW, V-polarized) goes around M4 -> HWP3 -> M5 and reflects off PBS2 to counter-propagate through CELL, then exits via M3 -> M2 -> HWP2 -> BS into BD_auto1 and BD_auto2.", "logic": null}, "trace": {"segments": [{"id": "s0", "branch": "IN", "source_id": "IN", "start": [448.0, 30.0], "end": [448.0, 90.0], "direction_deg": 90.0, "length_mm": 60.0, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 4027.6828892176836, "w0_mm": 1.0, "w_start_mm": 1.0, "w_end_mm": 1.0001109526993797, "start_element": "IN", "end_element": "HWP1", "end_reason": "element"}, {"id": "s1", "branch": "IN", "source_id": "IN", "start": [448.0, 90.0], "end": [448.0, 155.0], "direction_deg": 90.0, "length_mm": 65.0, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[0.8660254037844387, 0.0], [0.49999999999999994, -3.5352507957496895e-17]], "polarization_label": "linear 30\u00b0", "waist_z_mm": -60.0, "rayleigh_mm": 4027.6828892176836, "w0_mm": 1.0, "w_start_mm": 1.0001109526993797, "w_end_mm": 1.0004814763412664, "start_element": "HWP1", "end_element": "PBS1", "end_reason": "element"}, {"id": "s2", "branch": "IN.t", "source_id": "IN", "start": [448.0, 155.0], "end": [448.0, 177.0], "direction_deg": 90.0, "length_mm": 22.0, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 15.000000000000002, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": -125.0, "rayleigh_mm": 4027.6828892176836, "w0_mm": 1.0, "w_start_mm": 1.0004814763412664, "w_end_mm": 1.0006658088741904, "start_element": "PBS1", "end_element": "BD1", "end_reason": "absorbed"}, {"id": "s3", "branch": "IN.r", "source_id": "IN", "start": [448.0, 155.0], "end": [350.0, 155.00000000000003], "direction_deg": 180.0, "length_mm": 97.99999999999999, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 4.999999999999999, "jones": [[0.0, -0.0], [1.0, 0.0]], "polarization_label": "V", "waist_z_mm": -125.0, "rayleigh_mm": 4027.6828892176836, "w0_mm": 1.0, "w_start_mm": 1.0004814763412664, "w_end_mm": 1.0015315696144564, "start_element": "PBS1", "end_element": "M1", "end_reason": "element"}, {"id": "s4", "branch": "IN.r", "source_id": "IN", "start": [350.0, 155.00000000000003], "end": [350.0, 115.00000000000003], "direction_deg": -89.99999999999999, "length_mm": 39.99999999999999, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 4.999999999999999, "jones": [[0.0, 0.0], [1.0, 0.0]], "polarization_label": "V", "waist_z_mm": -223.0, "rayleigh_mm": 4027.6828892176836, "w0_mm": 1.0, "w_start_mm": 1.0015315696144564, "w_end_mm": 1.0021296525721637, "start_element": "M1", "end_element": "BS", "end_reason": "element"}, {"id": "s5", "branch": "IN.r.t", "source_id": "IN", "start": [350.0, 115.00000000000003], "end": [350.0, 30.000000000000043], "direction_deg": -89.99999999999999, "length_mm": 84.99999999999999, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 4.499999999999999, "jones": [[0.0, 0.0], [1.0, 0.0]], "polarization_label": "V", "waist_z_mm": -263.0, "rayleigh_mm": 4027.6828892176836, "w0_mm": 1.0, "w_start_mm": 1.0021296525721637, "w_end_mm": 1.0037257153921748, "start_element": "BS", "end_element": "M4", "end_reason": "element"}, {"id