ll, "part_number": "WPH10M-780", "beam": "IN.r.t", "distance_mm": 110.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": 0.0, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "M5", "type": "mirror", "label": "Pump mirror 2", "group": null, "part_number": "BB1-E03", "beam": "IN.r.t", "distance_mm": 145.0, "at": null, "angle_deg": null, "out_direction_deg": 90.0, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_auto1", "type": "beam_dump", "label": "Spent pump dump (transmitted at BS,group: null", "group": null, "part_number": "LB1", "beam": "IN.r.t.r.t", "distance_mm": 20.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}, {"id": "BD_auto2", "type": "beam_dump", "label": "Spent pump dump (transmitted at PBS1,group: null", "group": null, "part_number": "LB1", "beam": "IN.r.t.r.r.t", "distance_mm": 20.0, "at": null, "angle_deg": null, "out_direction_deg": null, "aperture_mm": null, "focal_length_mm": null, "fast_axis_deg": null, "split_ratio": null, "cutoff_nm": null, "reflect": null, "aom_frequency_mhz": null, "aom_efficiency": null, "aom_order": null, "acoustic_velocity_m_s": null, "fiber_mfd_um": null, "transmission": null, "saturation_power_mw": null, "small_signal_gain_db": null, "nl_efficiency_per_w": null}], "targets": [{"element_id": "PD", "kind": "min_power_mw", "value": 0.15}], "notes": "Layout follows Fig. 2a of the PyOpticL paper (1-inch mounted optics on a 485x185 mm baseplate). HWP1 sets ~25% (5 mW V-polarized) into the spectroscopy branch at PBS1. BS reflects 10% (0.5 mW) as the probe, rotated to H by HWP2 so it transmits through CELL and PBS2 to PD (~0.35 mW). The 90% transmitted pump (4.5 mW, V-polarized) goes around M4 -> HWP3 -> M5 and reflects off PBS2 to counter-propagate through CELL, then exits via M3 -> M2 -> HWP2 -> BS into BD_auto1 and BD_auto2.", "logic": null}, "report": {"passed": true, "score": 95.0875, "checks": [{"id": "target", "severity": "info", "message": "met: PD: 0.350 mW (need \u2265 0.150)", "element_id": "PD", "segment_id": null, "value": 0.3499999999999999, "limit": 0.15}], "metrics": {"input_mw": 20.0, "delivered_mw": 0.3499999999999999, "dumped_mw": 18.150000000000002, "stray_mw": 0.0, "n_elements": 16.0, "n_segments": 24.0, "target.PD.min_power_mw": 0.3499999999999999, "delivered_fraction": 0.017499999999999995}}, "trace": {"segments": [{"id": "s0", "branch": "IN", "source_id": "IN", "start": [448.0, 30.0], "end": [448.0, 90.0], "direction_deg": 90.0, "length_mm": 60.0, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[1.0, 0.0], [0.0, 0.0]], "polarization_label": "H", "waist_z_mm": 0.0, "rayleigh_mm": 4027.6828892176836, "w0_mm": 1.0, "w_start_mm": 1.0, "w_end_mm": 1.0001109526993797, "start_element": "IN", "end_element": "HWP1", "end_reason": "element"}, {"id": "s1", "branch": "IN", "source_id": "IN", "start": [448.0, 90.0], "end": [448.0, 155.0], "direction_deg": 90.0, "length_mm": 65.0, "wavelength_nm": 780.0, "freq_shift_mhz": 0.0, "power_mw": 20.0, "jones": [[0